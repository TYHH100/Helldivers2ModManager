<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ThemeWindowColor">#F3F3F3</Color>
    <Color x:Key="ThemeSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ThemeTextColor">#1A1A1A</Color>
    <Color x:Key="ThemeSecondaryTextColor">#5D5D5D</Color>
    <Color x:Key="ThemeBorderColor">#D6D6D6</Color>
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="{DynamicResource ThemeWindowColor}"/>
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{DynamicResource ThemeSurfaceColor}"/>
    <SolidColorBrush x:Key="ThemeTextBrush" Color="{DynamicResource ThemeTextColor}"/>
    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="{DynamicResource ThemeSecondaryTextColor}"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{DynamicResource ThemeBorderColor}"/>
</ResourceDictionary>
