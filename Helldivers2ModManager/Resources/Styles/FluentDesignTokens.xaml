<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- Fluent Design System - Core Design Tokens   -->
    <!-- ============================================ -->

    <!-- System Colors - Light Theme Base -->
    <Color x:Key="SystemAccentColor">#0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#429CE3</Color>
    <Color x:Key="SystemAccentColorLight2">#68B6E8</Color>
    <Color x:Key="SystemAccentColorLight3">#A0D1F0</Color>
    <Color x:Key="SystemAccentColorDark1">#005A9E</Color>
    <Color x:Key="SystemAccentColorDark2">#004375</Color>
    <Color x:Key="SystemAccentColorDark3">#002D4F</Color>

    <!-- Neutral Colors - Gray Scale -->
    <Color x:Key="NeutralBackgroundColor">#202020</Color>
    <Color x:Key="NeutralBackgroundAltColor">#2D2D2D</Color>
    <Color x:Key="NeutralBackgroundFillColor">#383838</Color>
    <Color x:Key="NeutralBackgroundFillColorSecondary">#454545</Color>
    <Color x:Key="NeutralForegroundColor">#FFFFFF</Color>
    <Color x:Key="NeutralForegroundColorSecondary">#B3B3B3</Color>
    <Color x:Key="NeutralForegroundColorTertiary">#808080</Color>
    <Color x:Key="NeutralForegroundColorDisabled">#5C5C5C</Color>
    <Color x:Key="NeutralBorderColor">#6D6D6D</Color>
    <Color x:Key="NeutralBorderColorStrong">#9D9D9D</Color>
    <Color x:Key="NeutralStrokeColor">#3A3A3A</Color>
    <Color x:Key="NeutralStrokeColorAlternate">#2A2A2A</Color>

    <!-- Layer Colors - Depth System -->
    <Color x:Key="LayerBackgroundColor">#2D2D2D</Color>
    <Color x:Key="LayerBackgroundFillColor">#383838</Color>
    <Color x:Key="LayerOnMicaBackgroundColor">#2D2D2D</Color>
    <Color x:Key="LayerAltBackgroundColor">#404040</Color>

    <!-- Mica Effect Colors -->
    <Color x:Key="MicaBackgroundColor">#202020</Color>
    <Color x:Key="MicaBorderColor">#3A3A3A</Color>

    <!-- Acrylic Effect Colors -->
    <Color x:Key="AcrylicBackgroundColor">#99383838</Color>
    <Color x:Key="AcrylicBackgroundFallbackColor">#CC1C1C1C</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="SystemAccentBrush" Color="{StaticResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentLight1Brush" Color="{StaticResource SystemAccentColorLight1}"/>
    <SolidColorBrush x:Key="SystemAccentLight2Brush" Color="{StaticResource SystemAccentColorLight2}"/>
    <SolidColorBrush x:Key="SystemAccentLight3Brush" Color="{StaticResource SystemAccentColorLight3}"/>
    <SolidColorBrush x:Key="SystemAccentDark1Brush" Color="{StaticResource SystemAccentColorDark1}"/>
    <SolidColorBrush x:Key="SystemAccentDark2Brush" Color="{StaticResource SystemAccentColorDark2}"/>
    <SolidColorBrush x:Key="SystemAccentDark3Brush" Color="{StaticResource SystemAccentColorDark3}"/>

    <SolidColorBrush x:Key="NeutralBackgroundBrush" Color="{StaticResource NeutralBackgroundColor}"/>
    <SolidColorBrush x:Key="NeutralBackgroundAltBrush" Color="{StaticResource NeutralBackgroundAltColor}"/>
    <SolidColorBrush x:Key="NeutralBackgroundFillBrush" Color="{StaticResource NeutralBackgroundFillColor}"/>
    <SolidColorBrush x:Key="NeutralBackgroundFillSecondaryBrush" Color="{StaticResource NeutralBackgroundFillColorSecondary}"/>
    <SolidColorBrush x:Key="NeutralForegroundBrush" Color="{StaticResource NeutralForegroundColor}"/>
    <SolidColorBrush x:Key="NeutralForegroundSecondaryBrush" Color="{StaticResource NeutralForegroundColorSecondary}"/>
    <SolidColorBrush x:Key="NeutralForegroundTertiaryBrush" Color="{StaticResource NeutralForegroundColorTertiary}"/>
    <SolidColorBrush x:Key="NeutralForegroundDisabledBrush" Color="{StaticResource NeutralForegroundColorDisabled}"/>
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="{StaticResource NeutralBorderColor}"/>
    <SolidColorBrush x:Key="NeutralBorderStrongBrush" Color="{StaticResource NeutralBorderColorStrong}"/>
    <SolidColorBrush x:Key="NeutralStrokeBrush" Color="{StaticResource NeutralStrokeColor}"/>
    <SolidColorBrush x:Key="NeutralStrokeAlternateBrush" Color="{StaticResource NeutralStrokeColorAlternate}"/>

    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="{StaticResource LayerBackgroundColor}"/>
    <SolidColorBrush x:Key="LayerBackgroundFillBrush" Color="{StaticResource LayerBackgroundFillColor}"/>
    <SolidColorBrush x:Key="LayerAltBackgroundBrush" Color="{StaticResource LayerAltBackgroundColor}"/>

    <SolidColorBrush x:Key="MicaBackgroundBrush" Color="{StaticResource MicaBackgroundColor}"/>
    <SolidColorBrush x:Key="MicaBorderBrush" Color="{StaticResource MicaBorderColor}"/>

    <!-- Semantic Colors -->
    <Color x:Key="DangerColor">#C42B1C</Color>
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="WarningColor">#FFB900</Color>

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <!-- Gradient Brushes for Depth Effects -->
    <LinearGradientBrush x:Key="MicaTopHintGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20FFFFFF" Offset="0"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AcrylicGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AcrylicBackgroundColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AcrylicBackgroundFallbackColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================ -->
    <!-- Shadow System - Depth & Elevation           -->
    <!-- ============================================ -->

    <!-- Level 1 Shadow (Resting) -->
    <DropShadowEffect x:Key="ShadowElevationLevel1"
                      Color="Black"
                      Direction="315"
                      ShadowDepth="4"
                      BlurRadius="8"
                      Opacity="0.24"/>

    <!-- Level 2 Shadow (Resting + 4dp) -->
    <DropShadowEffect x:Key="ShadowElevationLevel2"
                      Color="Black"
                      Direction="315"
                      ShadowDepth="8"
                      BlurRadius="16"
                      Opacity="0.22"/>

    <!-- Level 3 Shadow (Resting + 8dp) -->
    <DropShadowEffect x:Key="ShadowElevationLevel3"
                      Color="Black"
                      Direction="315"
                      ShadowDepth="16"
                      BlurRadius="24"
                      Opacity="0.20"/>

    <!-- Level 4 Shadow (Resting + 16dp) -->
    <DropShadowEffect x:Key="ShadowElevationLevel4"
                      Color="Black"
                      Direction="315"
                      ShadowDepth="24"
                      BlurRadius="48"
                      Opacity="0.18"/>

    <!-- Subtle Shadow for Cards -->
    <DropShadowEffect x:Key="CardShadow"
                      Color="Black"
                      Direction="315"
                      ShadowDepth="2"
                      BlurRadius="6"
                      Opacity="0.20"/>

    <!-- Glow Effect for Accent Elements -->
    <DropShadowEffect x:Key="AccentGlow"
                      Color="{StaticResource SystemAccentColor}"
                      Direction="0"
                      ShadowDepth="0"
                      BlurRadius="12"
                      Opacity="0.5"/>

    <!-- Soft Ambient Glow -->
    <DropShadowEffect x:Key="AmbientGlow"
                      Color="{StaticResource SystemAccentColor}"
                      Direction="0"
                      ShadowDepth="0"
                      BlurRadius="20"
                      Opacity="0.3"/>

</ResourceDictionary>