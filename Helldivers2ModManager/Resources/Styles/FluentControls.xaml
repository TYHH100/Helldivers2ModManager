<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helldivers2ModManager">

    <!-- ============================================ -->
    <!-- Fluent Design System - Control Styles       -->
    <!-- ============================================ -->

    <!-- Import Token Colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FluentDesignTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Converters -->
    <local:ContainsConverter x:Key="ContainsConverter"/>
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
    <local:NullToBoolConverter x:Key="NullToBoolConverter"/>
    <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <local:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
    <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <local:ProgressWidthConverter x:Key="ProgressWidthConverter"/>

    <!-- ============================================ -->
    <!-- Base Button Style (Fluent)                  -->
    <!-- ============================================ -->

    <Style x:Key="FluentButtonBase" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16 8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="HighlightLayer"
                                Background="Transparent"
                                BorderBrush="{StaticResource SystemAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Opacity="0"/>
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                            <Setter TargetName="HighlightLayer" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <!-- Pressed State -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundDisabledBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Button -->
    <Style x:Key="FluentPrimaryButton" TargetType="Button" BasedOn="{StaticResource FluentButtonBase}">
        <Setter Property="Background" Value="{StaticResource SystemAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource SystemAccentColor}"
                                                  Direction="270"
                                                  ShadowDepth="0"
                                                  BlurRadius="12"
                                                  Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="HighlightLayer"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Opacity="0.3"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource SystemAccentLight1Brush}"/>
                            <Setter TargetName="BackgroundLayer" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource SystemAccentColorLight1}"
                                                      Direction="270"
                                                      ShadowDepth="0"
                                                      BlurRadius="16"
                                                      Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource SystemAccentDark1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7D7D7D"/>
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#4D4D4D"/>
                            <Setter TargetName="BackgroundLayer" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary/Outline Button -->
    <Style x:Key="FluentSecondaryButton" TargetType="Button" BasedOn="{StaticResource FluentButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundDisabledBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success/Confirm Button -->
    <Style x:Key="FluentConfirmButton" TargetType="Button" BasedOn="{StaticResource FluentButtonBase}">
        <Setter Property="Background" Value="#107C10"/>
        <Setter Property="BorderBrush" Value="#107C10"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="#107C10"
                                                  Direction="270"
                                                  ShadowDepth="0"
                                                  BlurRadius="10"
                                                  Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#108C10"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#0D6F0D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7D7D7D"/>
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#4D4D4D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger/Cancel Button -->
    <Style x:Key="FluentDangerButton" TargetType="Button" BasedOn="{StaticResource FluentButtonBase}">
        <Setter Property="Background" Value="#C42B1C"/>
        <Setter Property="BorderBrush" Value="#C42B1C"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="#C42B1C"
                                                  Direction="270"
                                                  ShadowDepth="0"
                                                  BlurRadius="10"
                                                  Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#D63B2C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#A42518"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7D7D7D"/>
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#4D4D4D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Remove/Delete Button -->
    <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource FluentDangerButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                <Setter Property="Background" Value="#40C42B1C"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Button (Round) -->
    <Style x:Key="FluentIconButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Opacity="0"/>
                        <Ellipse x:Name="HighlightEllipse"
                                 Fill="{StaticResource SystemAccentBrush}"
                                 Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HighlightEllipse" Property="Opacity" Value="0.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- TextBox Style (Fluent)                      -->
    <!-- ============================================ -->

    <Style x:Key="FluentTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12 10"/>
        <Setter Property="CaretBrush" Value="{StaticResource SystemAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SystemAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                MinHeight="36"/>
                        <Border x:Name="FocusBorder"
                                BorderBrush="{StaticResource SystemAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Opacity="0"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"/>
                        <!-- 占位提示文字，Text为空且Tag非空时显示 -->
                        <TextBlock x:Name="PlaceholderText"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="{StaticResource NeutralForegroundDisabledBrush}"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{StaticResource NeutralBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="1"/>
                            <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundDisabledBrush}"/>
                            <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource NeutralBackgroundBrush}"/>
                        </Trigger>
                        <!-- Text为空时显示占位文字 -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

