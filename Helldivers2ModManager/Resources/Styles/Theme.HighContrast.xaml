<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Safe fallback values. ThemeService replaces all core tokens with the active
         Windows SystemColors palette before the main window is created. -->
    <Color x:Key="ThemeWindowColor">#000000</Color>
    <Color x:Key="ThemeSurfaceColor">#000000</Color>
    <Color x:Key="ThemeTextColor">#FFFFFF</Color>
    <Color x:Key="ThemeSecondaryTextColor">#FFFFFF</Color>
    <Color x:Key="ThemeBorderColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="{DynamicResource ThemeWindowColor}"/>
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{DynamicResource ThemeSurfaceColor}"/>
    <SolidColorBrush x:Key="ThemeTextBrush" Color="{DynamicResource ThemeTextColor}"/>
    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="{DynamicResource ThemeSecondaryTextColor}"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{DynamicResource ThemeBorderColor}"/>
</ResourceDictionary>
