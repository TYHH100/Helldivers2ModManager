<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FluentDesignTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="Space2">2</sys:Double>
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="ControlMinHeight">32</sys:Double>
    <sys:Double x:Key="TouchControlMinHeight">40</sys:Double>
    <Thickness x:Key="ControlPadding">12,6</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Duration x:Key="MotionFast">0:0:0.18</Duration>
    <Duration x:Key="MotionNormal">0:0:0.24</Duration>
    <Duration x:Key="MotionSlow">0:0:0.28</Duration>
    <sys:Double x:Key="BreakpointNarrow">900</sys:Double>
    <sys:Double x:Key="BreakpointWide">1400</sys:Double>
</ResourceDictionary>
