<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\Images\icon.ico</ApplicationIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ProductName>Helldivers 2 Mod Manager</ProductName>
		<ProductVersion>1.3.0.1</ProductVersion>
		<AssemblyVersion>1.3.0.1</AssemblyVersion>
		<FileVersion>1.3.0.1</FileVersion>
		<PublishSingleFile>true</PublishSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
	  <Resource Include="Resources\Fonts\FS Sinclair Bold.otf" />
	  <Resource Include="Resources\Fonts\FS Sinclair Medium.otf" />
	  <Resource Include="Resources\Fonts\FS Sinclair Regular.otf" />
	  <Resource Include="Resources\Images\discord_icon.png" />
	  <Content Include="Resources\Images\icon.ico">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
		<Reference Include="Microsoft.VisualBasic" />
		<PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
		<PackageReference Include="MdXaml" Version="1.27.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
		<PackageReference Include="SharpCompress" Version="0.48.1" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\Fonts\Blockletter.otf" />
	  <Resource Include="Resources\Images\github_icon.png" />
	  <Resource Include="Resources\Images\logo.png" />
	  <Resource Include="Resources\Images\logo_icon.png" />
	  <Resource Include="Resources\Images\remove.png" />
	  <Resource Include="Resources\Images\loading.png" />
	  <Resource Include="Resources\Images\download.png" />
	  <Resource Include="Resources\Images\check.png" />
	  <Resource Include="Resources\Images\error.png" />
	</ItemGroup>

	<ItemGroup>
	  <SplashScreen Include="Resources\Images\logo_splash.png" />
	</ItemGroup>
</Project>