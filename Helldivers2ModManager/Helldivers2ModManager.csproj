<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\Images\icon.ico</ApplicationIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ProductName>Helldivers 2 Mod Manager</ProductName>
		<ProductVersion>2.0.0</ProductVersion>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>2.0.0</FileVersion>
		<PublishSingleFile>true</PublishSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<ExcludeSevenZipAssemblies>true</ExcludeSevenZipAssemblies>
		<!-- Compatibility baseline for untouched v1.5 WPF code. New Core,
		     Infrastructure and test projects keep the full analyzer set enabled.
		     See docs/analyzer-baseline.md for scope and removal criteria. -->
		<NoWarn>$(NoWarn);CA1001;CA1304;CA1305;CA1309;CA1310;CA1311;CA1720;CA1822;CA1835;CA1848;CA1859;CA1860;CA1861;CA1866;CA1869;CA1870;CA2016;CA2254</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Helldivers2ModManager.Core\Helldivers2ModManager.Core.csproj" />
		<ProjectReference Include="..\Helldivers2ModManager.Infrastructure\Helldivers2ModManager.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\Fonts\FS Sinclair Bold.otf" />
	  <Resource Include="Resources\Fonts\FS Sinclair Medium.otf" />
	  <Resource Include="Resources\Fonts\FS Sinclair Regular.otf" />
	  <Resource Include="Resources\Images\discord_icon.png" />
	  <Content Include="Resources\Images\icon.ico">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
		<PackageReference Include="SharpSevenZip" Version="2.0.77" />
		<PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Native\7z.dll">
			<Link>7z.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Language\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Hashlists\friendlynames.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\Fonts\Blockletter.otf" />
	  <Resource Include="Resources\Images\github_icon.png" />
	  <Resource Include="Resources\Images\logo.png" />
	  <Resource Include="Resources\Images\logo_icon.png" />
	  <Resource Include="Resources\Images\remove.png" />
	  <Resource Include="Resources\Images\loading.png" />
	  <Resource Include="Resources\Images\download.png" />
	  <Resource Include="Resources\Images\check.png" />
	  <Resource Include="Resources\Images\error.png" />
	</ItemGroup>

	<ItemGroup>
	  <SplashScreen Include="Resources\Images\logo_splash.png" />
	</ItemGroup>
</Project>
