<UserControl x:Class="Helldivers2ModManager.Components.MessageBox"
			 x:ClassModifier="internal"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:Helldivers2ModManager.Components"
			 xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
			 mc:Ignorable="d"
			 d:DesignHeight="600"
			 d:DesignWidth="800"
			 Background="#80000000"
			 Visibility="Hidden"
			 d:Visibility="Visible"
			 UseLayoutRounding="True"
			 RenderOptions.BitmapScalingMode="HighQuality">
	<Border Style="{StaticResource FluentMessageDialog}"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			MinWidth="320"
			MaxWidth="640">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Title -->
			<TextBlock Grid.Row="0"
					   x:Name="title"
					   HorizontalAlignment="Center"
					   Margin="0 0 0 16"
					   FontSize="20"
					   FontWeight="SemiBold">
				<TextBlock.Foreground>
					<SolidColorBrush x:Name="brush" Color="White"/>
				</TextBlock.Foreground>
			</TextBlock>

			<!-- Content Area -->
			<Grid Grid.Row="1">
				<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

				<!-- Message -->
				<ScrollViewer Grid.Row="0"
							  Margin="0 0 0 16"
							  Padding="0"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled"
							  MaxHeight="360">
					<TextBlock x:Name="message"
							   FontSize="14"
							   FontFamily="Segoe UI Variable Text"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   TextWrapping="Wrap"/>
				</ScrollViewer>

				<!-- Input TextBox -->
				<TextBox Grid.Row="1"
						 x:Name="input"
						 Margin="0 0 0 16"
						 FontSize="14"
						 Style="{StaticResource FluentTextBox}"
						 Visibility="Collapsed"/>

				<!-- Selection ComboBox -->
				<ComboBox Grid.Row="2"
						  x:Name="selectionComboBox"
						  Margin="0 0 0 16"
						  FontSize="14"
						  Visibility="Collapsed"/>

				<!-- Export Progress Info (速度/压缩率) -->
				<StackPanel Grid.Row="3"
							x:Name="exportProgressPanel"
							Margin="0 -8 0 16"
							Visibility="Collapsed">
					<TextBlock x:Name="exportCurrentFile"
							   FontSize="12"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   TextTrimming="CharacterEllipsis"
							   Margin="0 0 0 4"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="exportSpeedText"
								   Grid.Column="0"
								   FontSize="12"
								   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
						<TextBlock x:Name="exportRatioText"
								   Grid.Column="1"
								   FontSize="12"
								   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
					</Grid>
				</StackPanel>

				<!-- Update Progress Info (哈希检查/文件更新进度) -->
				<StackPanel Grid.Row="4"
							x:Name="updateProgressPanel"
							Margin="0 -8 0 16"
							Visibility="Collapsed">
					<TextBlock x:Name="updatePhaseText"
							   FontSize="13"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   Margin="0 0 0 6"
							   TextTrimming="CharacterEllipsis"/>
					<TextBlock x:Name="updateCurrentFile"
							   FontSize="12"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   TextTrimming="CharacterEllipsis"
							   Margin="0 0 0 4"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="updateFileCount"
								   Grid.Column="0"
								   FontSize="12"
								   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
						<TextBlock x:Name="updateNeedUpdateCount"
								   Grid.Column="1"
								   FontSize="12"
								   Foreground="{StaticResource SystemAccentBrush}"
								   FontWeight="SemiBold"/>
					</Grid>
				</StackPanel>

				<!-- 部署步骤自动滚动列表：显示正在部署哪个模组（仅 Steps 非空时可见）。
					 顶部是最新（当前正在部署，accent 高亮），下面是已完成的（灰色 ✓）。
					 独立于进度面板：部署中、部署成功（信息弹窗）、部署失败（错误弹窗）都可显示。 -->
				<StackPanel Grid.Row="5"
							x:Name="deployStepsPanel"
							Margin="0 0 0 16"
							Visibility="Collapsed">
					<TextBlock Text="{loc:Loc MessageBox.DeploySteps}"
							   FontSize="12"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   Margin="0 0 0 6"/>
					<ScrollViewer x:Name="deployStepsScrollViewer"
								  MaxHeight="140"
								  VerticalScrollBarVisibility="Auto"
								  HorizontalScrollBarVisibility="Disabled"
								  ScrollChanged="DeployStepsScrollViewer_OnScrollChanged">
						<ItemsControl x:Name="deployStepsList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal" Margin="0 2">
										<TextBlock Text="{loc:Loc MessageBox.Deploying}"
												   Foreground="{StaticResource SystemAccentBrush}"
												   FontWeight="SemiBold"
												   VerticalAlignment="Top"
												   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
										<TextBlock Text="✓ "
												   Foreground="#777777"
												   VerticalAlignment="Top"
												   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
										<TextBlock Text="✗ "
												   Foreground="#f44336"
												   VerticalAlignment="Top"
												   FontWeight="SemiBold"
												   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}"/>
										<StackPanel>
											<TextBlock Text="{Binding Text}"
													   Foreground="#CCCCCC"
													   TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding Detail}"
													   FontSize="11"
													   Foreground="#888888"
													   TextTrimming="CharacterEllipsis"
													   Visibility="{Binding Detail, Converter={StaticResource StringToVisibilityConverter}}"/>
										</StackPanel>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>

				<!-- Tag Selection List -->
				<ListBox x:Name="tagSelectionList"
						 Grid.Row="1"
						 MaxHeight="360"
						 Margin="0 0 0 16"
						 FontSize="14"
						 Background="Transparent"
						 BorderThickness="0"
						 Visibility="Collapsed"
						 SelectionMode="Multiple"
						 ScrollViewer.VerticalScrollBarVisibility="Auto"
						 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="0 4">
								<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
										  VerticalAlignment="Center"
										  Margin="0 0 8 0"/>
								<Border Width="16"
										Height="16"
										CornerRadius="4"
										Margin="0 0 8 0"
										VerticalAlignment="Center">
									<Border.Background>
										<SolidColorBrush Color="{Binding Color}"/>
									</Border.Background>
								</Border>
								<TextBlock Text="{Binding Name}"
										   VerticalAlignment="Center"
										   Foreground="White"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
							<Setter Property="Padding" Value="8 4"/>
							<Setter Property="Background" Value="Transparent"/>
							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#20FFFFFF"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</ListBox.ItemContainerStyle>
				</ListBox>

				<!-- Group Selection List (multi-select groups) -->
				<ListBox x:Name="groupSelectionList"
						 Grid.Row="1"
						 MaxHeight="360"
						 Margin="0 0 0 16"
						 FontSize="14"
						 Background="Transparent"
						 BorderThickness="0"
						 Visibility="Collapsed"
						 SelectionMode="Multiple"
						 ScrollViewer.VerticalScrollBarVisibility="Auto"
						 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="0 4">
								<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
										  VerticalAlignment="Center"
										  Margin="0 0 8 0"/>
								<TextBlock Text="{Binding Name}"
										   VerticalAlignment="Center"
										   Foreground="White"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
							<Setter Property="Padding" Value="8 4"/>
							<Setter Property="Background" Value="Transparent"/>
							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#20FFFFFF"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</ListBox.ItemContainerStyle>
				</ListBox>

				<!-- Generic checklist selection (used by per-Unit LOD repair) -->
				<ListBox x:Name="checklistSelectionList"
						 Grid.Row="1"
						 MaxHeight="360"
						 MinWidth="560"
						 Margin="0 0 0 16"
						 Background="Transparent"
						 BorderThickness="0"
						 Visibility="Collapsed"
						 ScrollViewer.VerticalScrollBarVisibility="Auto"
						 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						 VirtualizingPanel.IsVirtualizing="True"
						 VirtualizingPanel.VirtualizationMode="Recycling">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0 4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<CheckBox Grid.Column="0"
										  IsChecked="{Binding IsSelected, Mode=TwoWay}"
										  VerticalAlignment="Center"
										  Margin="0 0 10 0"/>
								<StackPanel Grid.Column="1">
									<TextBlock Text="{Binding Title}"
											   Foreground="White"
											   FontSize="13"
											   FontWeight="SemiBold"
											   TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding Description}"
											   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
											   FontSize="11"
											   FontFamily="Cascadia Mono, Consolas"
											   TextTrimming="CharacterEllipsis"/>
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
							<Setter Property="Padding" Value="8 3"/>
							<Setter Property="Background" Value="Transparent"/>
							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#20FFFFFF"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</ListBox.ItemContainerStyle>
				</ListBox>

				<!-- Color Picker Panel -->
				<StackPanel x:Name="colorPickerPanel"
							Grid.Row="1"
							Margin="0 0 0 16"
							Visibility="Collapsed">
					<!-- Color Preview -->
					<StackPanel Orientation="Horizontal" Margin="0 0 0 12" VerticalAlignment="Center">
						<Border x:Name="colorPreviewBorder"
								Width="40"
								Height="40"
								CornerRadius="8"
								BorderThickness="2"
								BorderBrush="White"
								Margin="0 0 12 0"/>
						<StackPanel>
							<TextBlock Text="{loc:Loc MessageBox.CurrentColor}" FontSize="12" Foreground="#88FFFFFF" Margin="0 0 0 4"/>
							<TextBlock x:Name="colorCodeText" FontSize="14" Foreground="White" FontFamily="Consolas"/>
						</StackPanel>
					</StackPanel>

					<!-- Manual Color Input -->
					<StackPanel Orientation="Horizontal" Margin="0 0 0 12" VerticalAlignment="Center">
						<TextBlock Text="{loc:Loc MessageBox.CustomColor}" FontSize="12" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0 0 8 0"/>
						<TextBox x:Name="colorInputBox"
								 TextChanged="ColorInputBox_TextChanged"
								 Style="{StaticResource FluentTextBox}"
								 Width="140"
								 FontFamily="Consolas"
								 FontSize="13"
								 VerticalAlignment="Center"/>
						<Border x:Name="colorInputPreview"
								Width="24" Height="24" CornerRadius="4" Margin="8 0 0 0"
								BorderThickness="1" BorderBrush="#40FFFFFF"/>
						<TextBlock Text="{loc:Loc MessageBox.ColorFormat}" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="8 0 0 0"/>
					</StackPanel>

					<!-- Color Palette -->
					<TextBlock Text="{loc:Loc TagManagementPage.ColorTitle}" FontSize="12" Foreground="#88FFFFFF" Margin="0 0 0 8"/>
					<UniformGrid Columns="8" Rows="6">
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF3B82F6" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF3B82F6"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF0078D7" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF0078D7"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF00B7C3" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF00B7C3"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF00D4AA" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF00D4AA"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF107C10" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF107C10"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF34D399" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF34D399"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF84CC16" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF84CC16"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFFC107" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFFC107"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFF8C00" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFF8C00"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFF6B35" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFF6B35"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFF4500" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFF4500"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFE81123" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFE81123"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFF4081" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFF4081"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFDA70D6" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFDA70D6"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFBA55D3" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFBA55D3"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF6B7280" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF6B7280"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF9CA3AF" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF9CA3AF"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFD1D5DB" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFD1D5DB"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFFFFFF" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFFFFFF"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF1F2937" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF1F2937"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF374151" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF374151"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF4B5563" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF4B5563"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF6B7280" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF6B7280"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFE63946" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFE63946"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFF77F00" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFF77F00"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFFAC00" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFFAC00"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF2EC4B6" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF2EC4B6"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF9B5DE5" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF9B5DE5"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFF15BB5" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFF15BB5"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF00BBF9" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF00BBF9"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF00F5D4" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF00F5D4"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF8338EC" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF8338EC"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFB5607" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFB5607"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFFFBE0B" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFFFBE0B"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF84CC16" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF84CC16"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF10B981" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF10B981"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF06B6D4" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF06B6D4"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF3B82F6" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF3B82F6"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FF6366F1" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FF6366F1"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFEC4899" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFEC4899"/>
						<Border Margin="2" Width="32" Height="32" CornerRadius="4" Background="#FFDC2626" Cursor="Hand" MouseLeftButtonDown="ColorBorder_Click" Tag="#FFDC2626"/>
					</UniformGrid>
				</StackPanel>
			</Grid>

			<!-- Button Area -->
			<Grid Grid.Row="2">
				<!-- Cancel/OK Buttons -->
				<StackPanel x:Name="okCancelStack"
							Orientation="Horizontal"
							HorizontalAlignment="Right">
					<Button x:Name="cancelButton"
							Content="{loc:Loc Common.Cancel}"
							Style="{StaticResource FluentSecondaryButton}"
							Click="CancelButton_Click"
							Padding="16 8"
							Visibility="Hidden"/>
					<Button x:Name="okButton"
							Content="{loc:Loc Common.OK}"
							Style="{StaticResource FluentPrimaryButton}"
							Click="OkButton_Click"
							Padding="16 8"
							Visibility="Hidden"/>
				</StackPanel>

				<!-- Yes/No Buttons -->
				<StackPanel x:Name="yesNoStack"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Visibility="Hidden">
                    <Button Content="{loc:Loc MessageBox.Yes}"
							Style="{StaticResource FluentPrimaryButton}"
							Click="YesButton_Click"	
							Padding="16 8"/>
                    <Button Content="{loc:Loc MessageBox.No}"
							Style="{StaticResource FluentSecondaryButton}"
							Click="NoButton_Click"
							Padding="16 8"/>
				</StackPanel>

				<!-- Progress Bar -->
				<StackPanel x:Name="progressPanel"
							Visibility="Hidden">
					<TextBlock x:Name="progressStep"
							   Margin="0 0 0 8"
							   FontSize="12"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   TextTrimming="CharacterEllipsis"/>
					<ProgressBar x:Name="progress"
								 IsIndeterminate="True"
								 Height="4"
								 Foreground="{StaticResource SystemAccentBrush}"
								 Background="{StaticResource NeutralBackgroundFillBrush}"
								 BorderThickness="0"
								 Visibility="Hidden"/>
				</StackPanel>
			</Grid>
		</Grid>
	</Border>
</UserControl>
