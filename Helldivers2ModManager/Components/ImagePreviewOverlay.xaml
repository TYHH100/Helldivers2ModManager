<UserControl x:Class="Helldivers2ModManager.Components.ImagePreviewOverlay"
			 x:ClassModifier="internal"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
			 mc:Ignorable="d"
			 d:DesignHeight="600"
			 d:DesignWidth="800"
			 Background="#CC000000"
			 Visibility="Hidden"
			 d:Visibility="Visible"
			 Focusable="True"
			 KeyDown="Overlay_KeyDown"
			 IsVisibleChanged="Overlay_IsVisibleChanged">
	<Border Style="{StaticResource FluentMessageDialog}"
			MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ProportionalDoubleConverter}, ConverterParameter=0.9}"
			MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ProportionalDoubleConverter}, ConverterParameter=0.85}"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			MouseLeftButtonDown="Border_MouseLeftButtonDown">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Close Button -->
			<Button Grid.Row="0"
					AutomationProperties.Name="{loc:Loc MainWindow.Close}"
					Style="{StaticResource FluentIconButton}"
					ToolTip="{loc:Loc MainWindow.Close}"
					Click="CloseButton_Click"
					HorizontalAlignment="Right"
					Margin="0 0 0 8">
				<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
			</Button>

			<!-- Preview Image -->
			<Image Grid.Row="1"
				   x:Name="previewImage"
				   Stretch="Uniform"
				   MaxWidth="780"
				   MaxHeight="550"/>
		</Grid>
	</Border>
</UserControl>
