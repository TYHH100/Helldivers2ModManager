<Window x:Class="Helldivers2ModManager.MainWindow"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="clr-namespace:Helldivers2ModManager.Views"
		xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
		xmlns:cmp="clr-namespace:Helldivers2ModManager.Components"
		xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
		mc:Ignorable="d"
		d:DataContext="{d:DesignInstance vms:MainViewModel}"
		Title="{Binding Title}"
		Width="1000"
		Height="700"
		MinWidth="800"
		MinHeight="600"
		Content="{Binding CurrentViewModel}"
		WindowStyle="None"
		AllowsTransparency="True"
		WindowStartupLocation="CenterScreen"
		Background="{StaticResource MicaBackgroundBrush}"
		d:Background="{StaticResource MicaBackgroundBrush}">
	<Window.Resources>
		<DataTemplate DataType="{x:Type vms:DashboardPageViewModel}">
			<views:DashboardPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:DeploymentOrderPageViewModel}">
			<views:DeploymentOrderPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:SettingsPageViewModel}">
			<views:SettingsPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:EditPageViewModel}">
			<views:EditPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:ManifestEditPageViewModel}">
			<views:ManifestEditPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:CreatePageViewModel}">
			<views:CreatePageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:TagManagementPageViewModel}">
			<views:TagManagementPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:NexusDownloadPageViewModel}">
			<views:NexusDownloadPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:BackgroundTasksPageViewModel}">
			<views:BackgroundTasksPageView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vms:ArmorReusePageViewModel}">
			<views:ArmorReusePageView/>
		</DataTemplate>

	</Window.Resources>

	<Window.Style>
		<Style TargetType="Window">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="BorderBrush" Value="{StaticResource MicaBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Window">
						<Border Name="border"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Background="{TemplateBinding Background}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="48"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>

								<!-- Title Bar with Mica Effect -->
								<Border Grid.Row="0"
										Background="{StaticResource MicaBackgroundBrush}">
									<Border.BorderBrush>
										<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
											<GradientStop Color="#20FFFFFF" Offset="0"/>
											<GradientStop Color="Transparent" Offset="1"/>
										</LinearGradientBrush>
									</Border.BorderBrush>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Logo and Title -->
										<StackPanel Grid.Column="0"
													Orientation="Horizontal"
													VerticalAlignment="Center"
													Margin="16 0 0 0">
											<Image Source="Resources/Images/logo_icon.png"
												   Width="24"
												   Height="24"
												   Stretch="Uniform"
												   Margin="0 0 12 0"/>
											<TextBlock Text="{loc:Loc MainWindow.Title}"
													   FontSize="14"
													   FontWeight="SemiBold"
													   Foreground="{StaticResource NeutralForegroundBrush}"
													   VerticalAlignment="Center"/>
											<TextBlock Text="{Binding Version}"
													   FontSize="12"
													   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
													   Margin="12 0 0 0"
													   VerticalAlignment="Center"/>
										</StackPanel>

										<!-- Window Controls -->
										<StackPanel Grid.Column="2"
													Orientation="Horizontal"
													VerticalAlignment="Top">
											<Button Style="{StaticResource FluentTitleBarButton}"
													Command="{Binding ReportBugCommand}"
													ToolTip="{loc:Loc MainWindow.ReportBug}">
												<TextBlock Text="&#xebe8;"
														   FontFamily="Segoe Fluent Icons"
														   FontSize="14"/>
											</Button>
											<Button Style="{StaticResource FluentTitleBarButton}"
													Click="HelpButton_Click"
													ToolTip="{loc:Loc MainWindow.Help}">
												<TextBlock Text="&#xE897;"
														   FontFamily="Segoe Fluent Icons"
														   FontSize="14"/>
											</Button>
											<Button Style="{StaticResource FluentTitleBarButton}"
													Click="MinButton_Click"
													ToolTip="{loc:Loc MainWindow.Minimize}">
												<TextBlock Text="&#xE921;"
														   FontFamily="Segoe Fluent Icons"
														   FontSize="14"/>
											</Button>
											<Button Style="{StaticResource FluentTitleBarButton}"
													Click="MaxButton_Click"
													ToolTip="{loc:Loc MainWindow.Maximize}">
												<TextBlock Text="&#xE922;"
														   FontFamily="Segoe Fluent Icons"
														   FontSize="14"/>
											</Button>
											<Button Style="{StaticResource FluentCloseButton}"
													Click="CloseButton_Click"
													ToolTip="{loc:Loc MainWindow.Close}">
												<TextBlock Text="&#xE8BB;"
														   FontFamily="Segoe Fluent Icons"
														   FontSize="14"/>
											</Button>
										</StackPanel>
									</Grid>
								</Border>

								<!-- Content Area -->
								<ContentPresenter Name="presenter"
												  Grid.Row="1"/>
								<cmp:ImagePreviewOverlay Grid.Row="1"/>
								<cmp:VersionCheckDetailOverlay Grid.Row="1"/>
								<cmp:ModConflictDetailOverlay Grid.Row="1"/>
								<cmp:MessageBox Grid.Row="1"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="WindowState" Value="Maximized">
								<Setter TargetName="border" Property="Padding" Value="0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Style>

	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="48"
					  CornerRadius="0"
					  ResizeBorderThickness="6"/>
	</WindowChrome.WindowChrome>
</Window>
