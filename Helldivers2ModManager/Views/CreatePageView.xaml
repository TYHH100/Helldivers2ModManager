<Page x:Class="Helldivers2ModManager.Views.CreatePageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:dd="urn:gong-wpf-dragdrop"
	  xmlns:local="clr-namespace:Helldivers2ModManager.Views"
	  xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
	  xmlns:bhv="clr-namespace:Helldivers2ModManager"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:cvms="clr-namespace:Helldivers2ModManager.ViewModels.Create"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:CreatePageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="800"
	  d:DesignHeight="600"
	  Title="{Binding Title}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Grid.Row="0"
				   Text="{loc:Loc CreatePage.Title}"
				   Style="{StaticResource FluentSectionHeader}"
				   HorizontalAlignment="Center"
				   Margin="0 0 0 16"/>

		<!-- 流程提示横幅 -->
		<Border Grid.Row="1"
				Background="#1a3a5c"
				CornerRadius="8"
				Padding="14 12"
				Margin="0 0 0 12"
				BorderBrush="#2a5a8c"
				BorderThickness="1"
				Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0"
						   Text="&#xE946;"
						   FontFamily="Segoe Fluent Icons"
						   FontSize="18"
						   Foreground="#6ab0f3"
						   VerticalAlignment="Center"
						   Margin="0 0 10 0"/>
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="{loc:Loc CreatePage.GuideTitle}"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="#9ccff0"
							   Margin="0 0 2 0"/>
					<TextBlock TextWrapping="Wrap"
							   FontSize="12"
							   Foreground="#8abce8"
							   LineHeight="18">
						<Run Text="{loc:Loc CreatePage.GuideDesc1}"/><LineBreak/>
						<Run Text="{loc:Loc CreatePage.GuideStep1}"/><LineBreak/>
						<Run Text="{loc:Loc CreatePage.GuideStep2}"/><LineBreak/>
						<Run Text="{loc:Loc CreatePage.GuideStep3}"/><LineBreak/>
						<Run Text="{loc:Loc CreatePage.GuideHint}"/>
					</TextBlock>
				</StackPanel>
				<Button Grid.Column="2"
						Command="{Binding DismissBannerCommand}"
						Style="{StaticResource FluentIconButton}"
						ToolTip="{loc:Loc CreatePage.CloseHint}"
						Padding="4"
						VerticalAlignment="Top">
					<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#6a9fd8"/>
				</Button>
			</Grid>
		</Border>

		<!-- Form Content -->
		<ScrollViewer Grid.Row="2"
					  HorizontalScrollBarVisibility="Disabled"
					  VerticalScrollBarVisibility="Auto">

			<StackPanel>
			<!-- 图形化编辑 -->
			<StackPanel>

			<Border Style="{StaticResource FluentCard}"
					CornerRadius="8"
					Padding="24">
				<StackPanel>
					<!-- 模组名称 -->
					<TextBlock Text="{loc:Loc CreatePage.Name}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{StaticResource NeutralForegroundBrush}"/>
					<TextBlock Text="{loc:Loc CreatePage.NameDesc}"
							   FontSize="13"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   Margin="0 4 0 8"/>
					<TextBox Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}"
							 FontSize="14"
							 Padding="8 6"
							 Margin="0 0 0 16"/>

					<!-- 模组描述 -->
					<TextBlock Text="{loc:Loc CreatePage.Description}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{StaticResource NeutralForegroundBrush}"/>
					<TextBlock Text="{loc:Loc CreatePage.DescriptionDesc}"
							   FontSize="13"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   Margin="0 4 0 8"/>
					<TextBox Text="{Binding ModDescription, UpdateSourceTrigger=PropertyChanged}"
							 FontSize="14"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 MinHeight="60"
							 Padding="8 6"
							 Margin="0 0 0 16"/>

					<!-- 模组图标 -->
					<TextBlock Text="{loc:Loc CreatePage.Icon}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{StaticResource NeutralForegroundBrush}"/>
					<TextBlock Text="{loc:Loc CreatePage.IconDesc}"
							   FontSize="13"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   Margin="0 4 0 8"/>
					<Grid Margin="0 0 0 16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<!-- 图标预览 -->
						<Border Grid.Column="0"
								Width="48"
								Height="48"
								CornerRadius="6"
								Background="#20FFFFFF"
								Margin="0 0 12 0"
								VerticalAlignment="Center">
							<Image Source="{Binding IconPreview}"
								   Stretch="Uniform"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"/>
						</Border>
						<TextBox Grid.Column="1"
								 Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
								 FontSize="14"
								 Padding="8 6"
								 VerticalAlignment="Center"/>
						<Button Grid.Column="2"
								Content="{loc:Loc CreatePage.BrowseIcon}"
								Style="{StaticResource FluentSecondaryButton}"
								Command="{Binding BrowseIconCommand}"
								Margin="8 0 0 0"
								Padding="16 8"
								VerticalAlignment="Center"/>
					</Grid>

					<!-- 源目录 -->
					<TextBlock Text="{loc:Loc CreatePage.SourceDir}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{StaticResource NeutralForegroundBrush}"/>
					<TextBlock Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   FontSize="13"
							   Margin="0 4 0 8">
						<Run Text="{loc:Loc CreatePage.SourceDirDesc1}"/>
						<LineBreak/>
						<Run Text="{loc:Loc CreatePage.SourceDirDesc2}"/>
					</TextBlock>
					<Grid Margin="0 0 0 24">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBox Grid.Column="0"
								 Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
								 FontSize="14"
								 Padding="8 6"
								 VerticalAlignment="Center"/>
						<Button Grid.Column="1"
								Content="{loc:Loc CreatePage.BrowseIcon}"
								Style="{StaticResource FluentSecondaryButton}"
								Command="{Binding BrowseSourceCommand}"
								Margin="8 0 0 0"
								Padding="16 8"
								VerticalAlignment="Center"/>
					</Grid>

					<!-- 选项区域 -->
					<TextBlock Text="{loc:Loc CreatePage.Options}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{StaticResource NeutralForegroundBrush}"
							   Margin="0 0 0 4"/>
					<TextBlock Text="{loc:Loc CreatePage.OptionsDesc}"
							   FontSize="13"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   Margin="0 0 0 4"/>

					<!-- 拖拽排序提示 -->
					<Border Background="{StaticResource NeutralBackgroundFillBrush}"
							CornerRadius="4"
							Padding="8 4"
							Margin="0 0 0 8">
						<TextBlock Text="{loc:Loc CreatePage.DragHint}"
								   FontSize="12"
								   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
								   HorizontalAlignment="Center"/>
					</Border>

					<!-- 选项列表（支持拖拽排序） -->
					<ItemsControl ItemsSource="{Binding Options}"
								  dd:DragDrop.IsDragSource="True"
								  dd:DragDrop.IsDropTarget="True"
								  bhv:DragDropAutoScrollBehavior.IsEnabled="True">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type cvms:CreateModOptionViewModel}">
								<Border Style="{StaticResource FluentSettingsCard}"
										Margin="0 0 0 8"
										Padding="16"
										BorderBrush="{StaticResource NeutralForegroundSecondaryBrush}"
										BorderThickness="1"
										CornerRadius="6">
									<StackPanel>
										<!-- 选项标题行 + 删除按钮 -->
										<Grid Margin="0 0 0 8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0"
												   Text="{loc:Loc CreatePage.OptionTitle}"
												   FontSize="14"
												   FontWeight="SemiBold"
												   Foreground="{StaticResource NeutralForegroundBrush}"
												   VerticalAlignment="Center"/>
											<Button Grid.Column="1"
													Style="{StaticResource FluentIconButton}"
													Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
													CommandParameter="{Binding}"
													ToolTip="{loc:Loc CreatePage.DeleteOption}"
													Padding="6">
												<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
											</Button>
										</Grid>

										<!-- 选项图片 + 名称/描述 -->
										<Grid Margin="0 0 0 8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<!-- 选项图片预览 -->
											<Border Grid.Column="0"
													Width="64"
													Height="64"
													CornerRadius="4"
													Background="#20FFFFFF"
													Margin="0 0 12 0"
													VerticalAlignment="Top">
												<Image Source="{Binding ImagePreview}"
													   Stretch="Uniform"
													   VerticalAlignment="Center"
													   HorizontalAlignment="Center"/>
											</Border>
											<!-- 选项名称、描述、Include 路径 -->
											<StackPanel Grid.Column="1">
												<TextBlock Text="{loc:Loc CreatePage.OptionName}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
											<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
													 FontSize="14"
													 Padding="4 2"
													 Margin="0 0 0 6"/>
											<TextBlock Text="{loc:Loc CreatePage.OptionDesc}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
												<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
														 FontSize="13"
														 Padding="4 2"
														 Margin="0 0 0 6"/>
												<TextBlock Text="{loc:Loc CreatePage.OptionInclude}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
												<Grid Margin="0 0 0 6">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBox Grid.Column="0"
															 Text="{Binding IncludePaths, UpdateSourceTrigger=PropertyChanged}"
															 FontSize="12"
															 Padding="4 2"
															 VerticalAlignment="Center"/>
													<Button Grid.Column="1"
															Content="{loc:Loc CreatePage.OptionBrowse}"
															Style="{StaticResource FluentSecondaryButton}"
															Command="{Binding BrowseIncludeCommand}"
															Margin="4 0 0 0"
															Padding="8 4"
															FontSize="12"/>
												</Grid>
												<!-- 选项图标选择 -->
												<TextBlock Text="{loc:Loc CreatePage.OptionIcon}"
														   FontSize="12"
														   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
														   Margin="0 0 2 2"/>
												<Grid Margin="0 0 0 6">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBox Grid.Column="0"
															 Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
															 FontSize="12"
															 Padding="4 2"
															 VerticalAlignment="Center"/>
													<Button Grid.Column="1"
															Content="{loc:Loc CreatePage.SelectIcon}"
															Style="{StaticResource FluentSecondaryButton}"
															Command="{Binding BrowseImageCommand}"
															Margin="4 0 0 0"
															Padding="8 4"
															FontSize="12"/>
												</Grid>
											</StackPanel>
										</Grid>

										<!-- 子选项区域 -->
										<TextBlock Text="{loc:Loc CreatePage.SubOptions}"
												   FontSize="13"
												   FontWeight="SemiBold"
												   Foreground="{StaticResource NeutralForegroundBrush}"
												   VerticalAlignment="Center"
												   Margin="0 4 0 4"/>

										<!-- 子选项列表（支持拖拽排序） -->
										<ItemsControl ItemsSource="{Binding SubOptions}"
													  Margin="0 4 0 0"
													  dd:DragDrop.IsDragSource="True"
													  dd:DragDrop.IsDropTarget="True"
													  bhv:DragDropAutoScrollBehavior.IsEnabled="True">
											<ItemsControl.ItemTemplate>
												<DataTemplate DataType="{x:Type cvms:CreateModSubOptionViewModel}">
													<Border Background="#15FFFFFF"
															CornerRadius="4"
															Padding="12"
															Margin="0 4 0 0">
														<StackPanel>
															<!-- 子选项标题 + 删除按钮 -->
															<Grid Margin="0 0 0 6">
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="*"/>
																	<ColumnDefinition Width="Auto"/>
																</Grid.ColumnDefinitions>
																<TextBlock Grid.Column="0"
																	   Text="{loc:Loc CreatePage.SubOptionTitle}"
																	   FontSize="12"
																	   FontWeight="SemiBold"
																	   Foreground="{StaticResource NeutralForegroundBrush}"
																	   VerticalAlignment="Center"/>
															<Button Grid.Column="1"
																	Style="{StaticResource FluentIconButton}"
																	Command="{Binding DataContext.RemoveSubOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
																	CommandParameter="{Binding}"
																	ToolTip="{loc:Loc CreatePage.DeleteSubOption}"
																	Padding="4">
																	<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
																</Button>
															</Grid>
															<Grid>
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="Auto"/>
																	<ColumnDefinition Width="*"/>
																</Grid.ColumnDefinitions>
																<!-- 子选项图片预览 -->
																<Border Grid.Column="0"
																		Width="40"
																		Height="40"
																		CornerRadius="4"
																		Background="#20FFFFFF"
																		Margin="0 0 8 0"
																		VerticalAlignment="Top">
																	<Image Source="{Binding ImagePreview}"
																		   Stretch="Uniform"
																		   VerticalAlignment="Center"
																		   HorizontalAlignment="Center"/>
																</Border>
																<!-- 子选项名称、描述、Include 路径 -->
																<StackPanel Grid.Column="1">
																	<TextBlock Text="{loc:Loc CreatePage.SubOptionName}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																	<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
																			 FontSize="13"
																			 FontWeight="SemiBold"
																			 Padding="4 2"
																			 Margin="0 0 0 4"/>
																	<TextBlock Text="{loc:Loc CreatePage.SubOptionDesc}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																	<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
																			 FontSize="12"
																			 Padding="4 2"
																			 Margin="0 0 0 4"/>
																	<TextBlock Text="{loc:Loc CreatePage.SubOptionInclude}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																	<Grid>
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="*"/>
																			<ColumnDefinition Width="Auto"/>
																		</Grid.ColumnDefinitions>
																		<TextBox Grid.Column="0"
																				 Text="{Binding IncludePaths, UpdateSourceTrigger=PropertyChanged}"
																				 FontSize="12"
																				 Padding="4 2"
																				 VerticalAlignment="Center"/>
																		<Button Grid.Column="1"
																				Content="{loc:Loc SettingsPage.Browse}"
																				Style="{StaticResource FluentSecondaryButton}"
																				Command="{Binding BrowseIncludeCommand}"
																				Margin="4 0 0 0"
																				Padding="8 4"
																				FontSize="12"/>
																	</Grid>
																	<!-- 子选项图标选择 -->
																	<TextBlock Text="{loc:Loc CreatePage.SubOptionIcon}"
																			   FontSize="11"
																			   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
																			   Margin="0 0 2 2"/>
																	<Grid Margin="0 0 0 4">
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="*"/>
																			<ColumnDefinition Width="Auto"/>
																		</Grid.ColumnDefinitions>
																		<TextBox Grid.Column="0"
																				 Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
																				 FontSize="12"
																				 Padding="4 2"
																				 VerticalAlignment="Center"/>
																		<Button Grid.Column="1"
																				Content="{loc:Loc CreatePage.SelectSubIcon}"
																				Style="{StaticResource FluentSecondaryButton}"
																				Command="{Binding BrowseImageCommand}"
																				Margin="4 0 0 0"
																				Padding="8 4"
																				FontSize="12"/>
																	</Grid>
																</StackPanel>
															</Grid>
														</StackPanel>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<!-- 底部添加子选项按钮，避免添加后需重新滑到顶部 -->
										<Button Content="{loc:Loc CreatePage.AddSubOption}"
												Style="{StaticResource FluentSecondaryButton}"
												Command="{Binding AddSubOptionCommand}"
												HorizontalAlignment="Center"
												Margin="0 8 0 0"
												Padding="12 6"
												FontSize="12"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button Content="{loc:Loc CreatePage.AddOption}"
						Style="{StaticResource FluentSecondaryButton}"
						Command="{Binding AddOptionCommand}"
						HorizontalAlignment="Center"
						Margin="0 8 0 0"
						Padding="20 8"
						FontSize="13"/>
				</StackPanel>
			</Border>
			</StackPanel>

			</StackPanel>
		</ScrollViewer>

		<!-- Navigation Buttons -->
		<Border Grid.Row="3"
				Style="{StaticResource FluentCard}"
				CornerRadius="8"
				Margin="0 16 0 0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
						Content="{loc:Loc Common.Cancel}"
						Style="{StaticResource FluentSecondaryButton}"
						Command="{Binding CancelCommand}"
						HorizontalAlignment="Left"
						Padding="24 10"/>

				<Button Grid.Column="1"
						Content="{loc:Loc CreatePage.Create}"
						Style="{StaticResource FluentPrimaryButton}"
						Command="{Binding CreateCommand}"
						HorizontalAlignment="Right"
						Padding="24 10"/>
			</Grid>
		</Border>
	</Grid>
</Page>
