<Page x:Class="Helldivers2ModManager.Views.CreatePageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:Helldivers2ModManager.Views"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:cvms="clr-namespace:Helldivers2ModManager.ViewModels.Create"
	  xmlns:cviews="clr-namespace:Helldivers2ModManager.Views.Create"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:CreatePageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="800"
	  d:DesignHeight="600"
	  Title="{Binding Title}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Grid.Row="0"
				   Text="创建 Mod"
				   Style="{StaticResource FluentSectionHeader}"
				   HorizontalAlignment="Center"
				   Margin="0 0 0 16"/>

		<!-- Content Frame -->
		<Border Grid.Row="1"
				Style="{StaticResource FluentCard}"
				CornerRadius="8">
			<Frame Content="{Binding CurrentPage}"
				   NavigationUIVisibility="Hidden">
				<Frame.Resources>
					<DataTemplate DataType="{x:Type cvms:IntroPageViewModel}">
						<cviews:IntroPageView/>
					</DataTemplate>
					<DataTemplate DataType="{x:Type cvms:ChoosePageViewModel}">
						<cviews:ChoosePageView/>
					</DataTemplate>
				</Frame.Resources>
			</Frame>
		</Border>

		<!-- Navigation Buttons -->
		<Border Grid.Row="2"
				Style="{StaticResource FluentCard}"
				CornerRadius="8"
				Margin="0 16 0 0">
			<Grid>
				<Button Content="返回"
						Style="{StaticResource FluentSecondaryButton}"
						HorizontalAlignment="Left"
						Command="{Binding CancelCommand}"
						Padding="16 10"/>
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Right">
					<Button Content="上一步"
							Style="{StaticResource FluentSecondaryButton}"
							Command="{Binding BackCommand}"
							Margin="0 0 8 0"
							Padding="16 10"/>
					<Button Content="下一步"
							Style="{StaticResource FluentPrimaryButton}"
							Command="{Binding NextCommand}"
							Padding="16 10"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Page>