<Page x:Class="Helldivers2ModManager.Views.DashboardPageView"
	  x:ClassModifier="internal"
	  x:Name="ThisPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:dd="urn:gong-wpf-dragdrop"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:local="clr-namespace:Helldivers2ModManager"
	  xmlns:models="clr-namespace:Helldivers2ModManager.Models"
	  xmlns:views="clr-namespace:Helldivers2ModManager.Views"
	  xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:DashboardPageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="1000"
	  d:DesignHeight="700"
	  KeyDown="DashboardPageView_KeyDown"
	  Title="{Binding Title}">
	<Page.Resources>
		<local:DashboardItemTemplateSelector x:Key="DashboardItemTemplateSelector">
			<local:DashboardItemTemplateSelector.ModTemplate>
				<DataTemplate DataType="vms:ModViewModel">
					<Border Tag="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"
							MouseLeftButtonDown="ModCard_MouseLeftButtonDown">
						<Border.Style>
							<Style TargetType="Border" BasedOn="{StaticResource FluentModCard}">
								<Setter Property="BorderBrush" Value="Transparent"/>
								<Setter Property="BorderThickness" Value="2"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsSelected}" Value="True">
										<Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<Border.ContextMenu>
							<ContextMenu>
								<MenuItem Header="{loc:Loc DashboardPage.PreviewModel}"
										  Command="{Binding PlacementTarget.Tag.PreviewModelCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<Separator/>
								<MenuItem Header="{loc:Loc DashboardPage.MoveToTop}"
										  Command="{Binding PlacementTarget.Tag.MoveToTopCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="{loc:Loc DashboardPage.MoveToBottom}"
										  Command="{Binding PlacementTarget.Tag.MoveToBottomCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="{loc:Loc DashboardPage.MoveToPosition}"
										  Command="{Binding PlacementTarget.Tag.MoveToPositionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<Separator/>
								<MenuItem Header="{loc:Loc DashboardPage.OpenFileLocation}"
										  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<Separator/>
								<MenuItem Header="{loc:Loc DashboardPage.SetTags}"
										  Command="{Binding PlacementTarget.Tag.EditModTagsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="{loc:Loc ModGroup.AddToGroup}"
										  Command="{Binding PlacementTarget.Tag.AddModsToGroupCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="{loc:Loc DashboardPage.EditLink}"
										  Command="{Binding EditLinkCommand}"
										  CommandParameter="{Binding}"/>
								<Separator/>
								<MenuItem Header="{loc:Loc DashboardPage.EditManifest}"
										  Command="{Binding PlacementTarget.Tag.EditManifestCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="{loc:Loc DashboardPage.PackageExport}"
										  Command="{Binding PlacementTarget.Tag.ExportModCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="{loc:Loc DashboardPage.UpdateMod}"
										  Command="{Binding PlacementTarget.Tag.UpdateModCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
							</ContextMenu>
						</Border.ContextMenu>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="60"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Mod Icon -->
							<Viewbox Grid.Column="0"
									 Grid.Row="0"
									 Grid.RowSpan="2"
									 Margin="0 0 12 0">
								<Image Source="{Binding Icon}"
									   Cursor="Hand"
									   MouseLeftButtonDown="ModIcon_MouseLeftButtonDown">
									<Image.ToolTip>
										<ToolTip Placement="Mouse"
												 HorizontalOffset="10"
												 VerticalOffset="10"
												 StaysOpen="True">
											<Image Source="{Binding Icon}"
												   Stretch="Uniform"
												   Width="300"
												   Height="300"/>
										</ToolTip>
									</Image.ToolTip>
								</Image>
							</Viewbox>

							<!-- Mod Name and Tags -->
								<StackPanel Grid.Column="1"
									   Grid.Row="0"
									   Orientation="Vertical"
									   VerticalAlignment="Center">
									<TextBlock Text="{Binding Name}"
											   FontSize="18"
											   FontWeight="SemiBold"
											   Foreground="{StaticResource NeutralForegroundBrush}"
											   TextWrapping="NoWrap"
											   TextTrimming="CharacterEllipsis">
									<TextBlock.ToolTip>
										<ToolTip>
											<TextBlock Text="{Binding Name}"
													   FontSize="18"
													   FontWeight="SemiBold"
													   Foreground="{StaticResource NeutralForegroundBrush}"/>
										</ToolTip>
									</TextBlock.ToolTip>
								</TextBlock>
								<StackPanel Orientation="Horizontal" Margin="0 4 0 0">
									<ItemsControl ItemsSource="{Binding DisplayTags}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{Binding Color, Converter={StaticResource StringToColorBrushConverter}}"
														CornerRadius="4"
														Padding="6 2"
														Margin="0 0 4 0">
													<TextBlock Text="{Binding Name}"
															   FontSize="11"
															   Foreground="{Binding Foreground}"/>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<Border Background="#FF6B7280"
											CornerRadius="4"
											Padding="6 2"
									Margin="0,-4,-6,0"
											Visibility="{Binding HasHiddenTags, Converter={StaticResource BoolToVisibilityConverter}}">
										<TextBlock Text="{Binding HiddenTagCount, StringFormat='+{0}'}"
												   FontSize="11"
												   Foreground="White"/>
										<Border.ToolTip>
											<ToolTip>
												<StackPanel>
													<TextBlock Text="{loc:Loc DashboardPage.MoreTags}" FontWeight="SemiBold" Margin="0 0 0 4"/>
													<ItemsControl ItemsSource="{Binding HiddenTags}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<WrapPanel Orientation="Horizontal"/>
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<Border Background="{Binding Color, Converter={StaticResource StringToColorBrushConverter}}"
																		CornerRadius="4"
																		Padding="6 2"
																		Margin="0 0 4 4">
																	<TextBlock Text="{Binding Name}"
																			   FontSize="11"
																			   Foreground="{Binding Foreground}"/>
																</Border>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</StackPanel>
											</ToolTip>
										</Border.ToolTip>
									</Border>
								</StackPanel>
							</StackPanel>

							<!-- Mod Description -->
							<TextBlock Grid.Column="1"
									   Grid.Row="1"
									   Text="{Binding Description}"
									   FontSize="13"
									   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
									   TextWrapping="NoWrap"
									   TextTrimming="WordEllipsis"
									   VerticalAlignment="Center"/>

							<!-- Options Panel -->
							<StackPanel Grid.Column="2"
										Grid.Row="0"
										Grid.RowSpan="2"
										Orientation="Horizontal"
										VerticalAlignment="Center">
								<ComboBox Width="140"
										  Margin="8 0"
										  Visibility="{Binding OptionsVisible}"
										  ItemsSource="{Binding LegacyOptions}"
										  SelectedIndex="{Binding LegacySelectedOption}"/>
								<Button Style="{StaticResource FluentSecondaryButton}"
										Content="{loc:Loc Common.Edit}"
										Padding="12 4"
										Margin="8 0"
										Visibility="{Binding EditVisible}"
										Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}"
										CommandParameter="{Binding}"/>
							</StackPanel>

							<!-- Enable Checkbox -->
							<CheckBox Grid.Column="3"
									  Grid.Row="0"
									  Grid.RowSpan="2"
									  IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									  Width="24"
									  Height="24"
									  Margin="8 0"
									  VerticalAlignment="Center"/>

							<!-- Remove Button -->
							<Button Grid.Column="4"
									Grid.Row="0"
									Grid.RowSpan="2"
									Style="{StaticResource FluentIconButton}"
									Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}"
									CommandParameter="{Binding}"
									ToolTip="{loc:Loc DashboardPage.DeleteModHint}">
								<TextBlock Text="&#xE74D;"
										   FontFamily="Segoe Fluent Icons"
										   FontSize="16"
										   Foreground="{StaticResource DangerBrush}"/>
							</Button>

							<!-- 模组序号：与右键菜单“移动到指定位置”的编号一致 -->
							<Border Grid.Column="5"
									Grid.Row="0"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									Margin="0 0 4 0"
									Background="#FF6B7280"
									CornerRadius="4"
									Padding="5 1"
									ToolTip="{loc:Loc DashboardPage.PositionNumberHint}">
								<TextBlock Text="{Binding PositionNumber}"
										   FontSize="11"
										   Foreground="White"/>
							</Border>

							<!-- 版本状态指示器 -->
			<Border Grid.Column="0"
							Grid.Row="0"
							Width="14"
									Height="14"
									CornerRadius="7"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Margin="-7,-7,0,0"
									Cursor="Hand"
									Background="{Binding VersionStatus, Converter={StaticResource VersionStatusToColorConverter}}"
									MouseLeftButtonDown="VersionStatusIndicator_MouseLeftButtonDown">
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Visibility" Value="Visible"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding DataContext.IsCheckingVersion, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Value="True">
												<Setter Property="Visibility" Value="Collapsed"/>
											</DataTrigger>
											<DataTrigger Binding="{Binding VersionStatus}" Value="Unknown">
												<Setter Property="Visibility" Value="Collapsed"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<Border.ToolTip>
									<ToolTip>
										<StackPanel>
											<TextBlock FontWeight="SemiBold" Margin="0 0 0 4">
												<Run Text="{loc:Loc DashboardPage.VersionCompatibility}"/>
												<Run Text="{Binding VersionStatus, Converter={StaticResource VersionStatusToTextConverter}}"/>
											</TextBlock>
											<TextBlock Text="{Binding LastCheckDisplayText}"
													   FontSize="11"
													   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
											<TextBlock Text="{loc:Loc DashboardPage.ClickForDetails}"
													   FontSize="11"
													   Foreground="{StaticResource NeutralForegroundTertiaryBrush}"
													   Margin="0 4 0 0"/>
										</StackPanel>
									</ToolTip>
								</Border.ToolTip>
							</Border>
							<!-- 检查中加载指示器 -->
							<Border Grid.Column="0"
									Grid.Row="0"
									Width="14"
									Height="14"
									CornerRadius="7"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Margin="-7,-7,0,0"
									Background="{StaticResource SystemAccentBrush}"
							Visibility="{Binding DataContext.IsCheckingVersion, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"
							ToolTip="{loc:Loc DashboardPage.CheckingVersion}"/>
							<!-- 覆盖关系指示器：扫描后显示，感叹号表示存在覆盖，对勾表示未发现覆盖 -->
							<Border Grid.Column="0"
									Grid.Row="0"
									Width="18"
									Height="18"
									CornerRadius="9"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Margin="12,-9,0,0"
															Panel.ZIndex="2"
															Background="{Binding ConflictStatusBrush}"
															Cursor="Hand"
															MouseLeftButtonDown="ConflictStatusIndicator_MouseLeftButtonDown"
															ToolTip="{loc:Loc DashboardPage.ConflictStatusHint}"
															Visibility="{Binding ConflictScanCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock Text="{Binding ConflictStatusIcon}"
										  Foreground="White"
										  FontSize="13"
										  FontWeight="Bold"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
							</Border>

							<!-- 链接指示器：点击跳转作者主页/发布页；无链接时点击进入编辑 -->
							<Button Grid.Column="0"
									Grid.Row="0"
									Style="{StaticResource FluentIconButton}"
									Width="18"
									Height="18"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Margin="34,-9,0,0"
									Panel.ZIndex="2"
									ToolTip="{loc:Loc DashboardPage.ModLinkHint}"
									Command="{Binding OpenLinkCommand}">
								<TextBlock Text="&#xE71B;"
											   FontFamily="Segoe Fluent Icons"
											   FontSize="13"
											   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"/>
							</Button>

						</Grid>
					</Border>
				</DataTemplate>
			</local:DashboardItemTemplateSelector.ModTemplate>
			<local:DashboardItemTemplateSelector.SeparatorTemplate>
				<DataTemplate DataType="models:ModSeparator">
					<Border Padding="8 4"
							Margin="0 2"
							CornerRadius="6"
							Tag="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"
							Background="{Binding Color, Converter={StaticResource StringToColorBrushConverter}}">
						<Border.Style>
							<Style TargetType="Border">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsExpanded}" Value="False">
										<Setter Property="Opacity" Value="0.6"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<Border.ContextMenu>
							<ContextMenu>
								<MenuItem Header="{loc:Loc DashboardPage.Rename}"
										  Command="{Binding PlacementTarget.Tag.RenameSeparatorCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="{loc:Loc DashboardPage.ChangeColor}"
										  Command="{Binding PlacementTarget.Tag.ChangeSeparatorColorCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
								<Separator/>
								<MenuItem Header="{loc:Loc Common.Delete}"
										  Command="{Binding PlacementTarget.Tag.DeleteSeparatorCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
										  CommandParameter="{Binding}"/>
							</ContextMenu>
						</Border.ContextMenu>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<!-- 名称 -->
							<TextBlock Grid.Column="0"
									   Text="{Binding Name}"
									   FontSize="14"
									   FontWeight="SemiBold"
									   Foreground="{Binding Color, Converter={StaticResource ColorToForegroundConverter}}"
									   VerticalAlignment="Center"
									   Margin="4 0 0 0"/>

							<!-- 删除按钮 -->
							<Button Grid.Column="1"
									Style="{StaticResource FluentIconButton}"
									Command="{Binding DataContext.DeleteSeparatorCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}"
									CommandParameter="{Binding}"
									Width="24" Height="24"
									Foreground="{Binding Color, Converter={StaticResource ColorToForegroundConverter}}"
									ToolTip="{loc:Loc DashboardPage.DeleteSeparatorHint}">
								<TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="10"
										   Foreground="{Binding Color, Converter={StaticResource ColorToForegroundConverter}}"
										   Opacity="0.7"/>
							</Button>
						</Grid>
					</Border>
				</DataTemplate>
			</local:DashboardItemTemplateSelector.SeparatorTemplate>
		</local:DashboardItemTemplateSelector>
	</Page.Resources>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>

		<!-- Left Navigation Panel -->
		<Border Grid.Row="0"
				Grid.RowSpan="3"
				Grid.Column="0"
				Style="{StaticResource FluentElevatedCard}"
				Margin="0 0 16 0"
				CornerRadius="8">
			<DockPanel LastChildFill="False">
				<!-- App Logo/Header -->
				<!-- <Border Background="{StaticResource SystemAccentBrush}"
						CornerRadius="4"
						Padding="12"
						Margin="0 0 0 16"
						DockPanel.Dock="Top">
					<StackPanel>
						<TextBlock Text="&#xE71D;"
								   FontFamily="Segoe Fluent Icons"
								   FontSize="32"
								   Foreground="White"
								   HorizontalAlignment="Center"/>
						<TextBlock Text="MOD MANAGER"
								   FontSize="10"
								   FontWeight="Bold"
								   Foreground="White"
								   HorizontalAlignment="Center"
								   Margin="0 4 0 0"/>
					</StackPanel>
				</Border> -->

				<!-- Navigation Buttons -->
				<StackPanel DockPanel.Dock="Top">
					<StackPanel x:Name="AddCreatePanel">
					<Button x:Name="AddModButton" Style="{StaticResource FluentNavigationButton}"
							Command="{Binding AddCommand}"
							IsEnabled="{Binding Initialized}">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="{loc:Loc DashboardPage.AddMod}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
						</StackPanel>
					</Button>
					<Button Style="{StaticResource FluentNavigationButton}"
							Command="{Binding CreateCommand}"
							IsEnabled="{Binding Initialized}">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE7AC;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="{loc:Loc DashboardPage.CreateMod}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
						</StackPanel>
					</Button>
					</StackPanel>
					<!-- <Button Style="{StaticResource FluentNavigationButton}"
						Command="{Binding DownloadFromNexusCommand}"
						IsEnabled="{Binding Initialized}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="从 Nexus 下载" ToolTip="试验性, 未经测试(我没有n网会员所以这个就鸽了)" Margin="12 0 0 0" VerticalAlignment="Center"/>
					</StackPanel>
				</Button> -->
					<Button x:Name="BackgroundTasksButton" Style="{StaticResource FluentNavigationButton}"
						Command="{Binding ShowBackgroundTasksCommand}"
						IsEnabled="{Binding Initialized}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc DashboardPage.BackgroundTasks}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Button>
					<Button x:Name="ArmorReuseButton" Style="{StaticResource FluentNavigationButton}"
						Command="{Binding ArmorReuseCommand}"
						IsEnabled="{Binding Initialized}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc DashboardPage.ArmorReuse}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Button>
					<Button x:Name="PatchResourceViewerButton" Style="{StaticResource FluentNavigationButton}"
						Command="{Binding PatchResourceViewerCommand}"
						IsEnabled="{Binding Initialized}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc DashboardPage.PatchResourceViewer}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Button>
					<Button x:Name="BisectButton" Style="{StaticResource FluentNavigationButton}"
						Command="{Binding BisectCommand}"
						IsEnabled="{Binding Initialized}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc DashboardPage.Bisect}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Button>
					<Button x:Name="TagManagementButton" Style="{StaticResource FluentNavigationButton}"
						Command="{Binding TagManagementCommand}"
						IsEnabled="{Binding Initialized}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc DashboardPage.TagManagement}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Button>

					<Button x:Name="SettingsButton" Style="{StaticResource FluentNavigationButton}"
						Command="{Binding SettingsCommand}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc DashboardPage.Settings}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Button>

					<Button Style="{StaticResource FluentNavigationButton}"
						Command="{Binding DeploymentOrderCommand}"
						IsEnabled="{Binding Initialized}"
						Visibility="{Binding IsDeploymentOrderEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc DashboardPage.DeploymentOrder}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Button>

					<Border Style="{StaticResource FluentDivider}" Margin="0 8"
							Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibilityConverter}}"/>
				</StackPanel>

				<!-- Social Links - Dock to Bottom -->
				<StackPanel DockPanel.Dock="Bottom">
					<!-- Social Links -->
					<TextBlock Text="{loc:Loc DashboardPage.RelatedLinks}"
							   FontSize="12"
							   Foreground="{StaticResource NeutralForegroundTertiaryBrush}"
							   Margin="12 8"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
                        <Button x:Name="GithubButton"
								Style="{StaticResource FluentIconButton}"
								ToolTip="{loc:Loc DashboardPage.GitHub}"
								Click="GithubButton_Click">
                            <Image Source="../Resources/Images/github_icon.png" Height="30"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc DashboardPage.OriginalRepo}"
                                              Command="{Binding GithubCommand}"/>
                                    <MenuItem Header="{loc:Loc DashboardPage.ForkedRepo}"
                                              Command="{Binding GithubForkCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Grid.Column="1"
								Style="{StaticResource FluentIconButton}"
								Command="{Binding DiscordCommand}"
								ToolTip="{loc:Loc DashboardPage.Discord}">
							<Image Source="../Resources/Images/discord_icon.png" Height="30"/>
						</Button>
					</Grid>
				</StackPanel>

				<!-- Version Check Button - Dock to Bottom -->
				<StackPanel x:Name="VersionCheckPanel" DockPanel.Dock="Bottom">
					<Button x:Name="CheckVersionButton" Style="{StaticResource FluentNavigationButton}"
							Command="{Binding CheckVersionCompatibilityCommand}"
							IsEnabled="{Binding Initialized}">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="{loc:Loc DashboardPage.CheckVersion}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{loc:Loc DashboardPage.VersionCheckHint}" />
						</StackPanel>
					</Button>
					<Button Style="{StaticResource FluentNavigationButton}"
							Command="{Binding ScanModConflictsCommand}"
							IsEnabled="{Binding Initialized}"
							Margin="0 6 0 0">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="{loc:Loc DashboardPage.ScanConflicts}" Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- Top Action Bar -->
		<Border Grid.Row="0"
				Grid.Column="1"
				Style="{StaticResource FluentCard}"
				CornerRadius="8"
				Margin="0 0 0 16">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Search Box -->
				<Grid x:Name="SearchArea" Grid.Row="0" Grid.Column="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBox Grid.Column="0"
						 x:Name="SearchBox"
						 Style="{StaticResource FluentTextBox}"
						 Margin="0 0 8 0"
						 VerticalAlignment="Center"
						 Tag="{loc:Loc DashboardPage.SearchWatermark}"
						 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
					<Button Grid.Column="1"
							Style="{StaticResource FluentIconButton}"
							Command="{Binding ClearSearchCommand}"
							ToolTip="{loc:Loc DashboardPage.ClearSearch}"
							VerticalAlignment="Center"
							Margin="0 0 16 0">
                        <TextBlock Text="&#xe750;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
					</Button>
				</Grid>

				<!-- Batch Action Buttons (第2行，有选中项时显示) -->
				<StackPanel Grid.Row="1"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Orientation="Horizontal"
							Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"
							Margin="0 8 0 0">
					<TextBlock Text="{Binding SelectionCountText}"
							   FontSize="13"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   VerticalAlignment="Center"
							   Margin="0 0 8 0"/>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc DashboardPage.SelectAll}"
							Command="{Binding SelectAllCommand}"
							Padding="12 6">
						<Button.ToolTip>
							<ToolTip Content="{loc:Loc DashboardPage.SelectAllHint}"/>
						</Button.ToolTip>
					</Button>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc DashboardPage.DeselectAll}"
							Command="{Binding DeselectAllCommand}"
							Padding="12 6"/>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc DashboardPage.InvertSelection}"
							Command="{Binding InvertSelectionCommand}"
							Padding="12 6"/>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc DashboardPage.BatchEnable}"
							Command="{Binding BatchEnableCommand}"
							Padding="12 6"/>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc DashboardPage.BatchDisable}"
							Command="{Binding BatchDisableCommand}"
							Padding="12 6"/>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc DashboardPage.BatchTag}"
							Command="{Binding BatchAddTagsCommand}"
							Padding="12 6">
						<Button.ToolTip>
							<ToolTip Content="{loc:Loc DashboardPage.BatchTagHint}"/>
						</Button.ToolTip>
					</Button>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc ModGroup.AddToGroup}"
							Command="{Binding AddModsToGroupCommand}"
							Padding="12 6"/>
					<Button Style="{StaticResource FluentDangerButton}"
							Content="{loc:Loc Common.Delete}"
							Command="{Binding BatchDeleteCommand}"
							Padding="12 6"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Mod List -->
		<ScrollViewer x:Name="ModListScrollViewer"
					  Grid.Row="1"
					  Grid.Column="1"
					  Margin="0 0 0 16"
					  Background="Transparent"
					  BorderThickness="0"
					  HorizontalScrollBarVisibility="Disabled"
					  VerticalScrollBarVisibility="Auto"
					  MouseLeftButtonDown="ModListArea_MouseLeftButtonDown">
			<ScrollViewer.ContextMenu>
				<ContextMenu Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibilityConverter}}">
					<MenuItem Header="{loc:Loc DashboardPage.CreateSeparator}"
							  Command="{Binding CreateSeparatorCommand}"/>
				</ContextMenu>
			</ScrollViewer.ContextMenu>
			<ItemsControl ItemsSource="{Binding Mods}"
					  dd:DragDrop.IsDragSource="{Binding IsSearchEmpty}"
					  dd:DragDrop.IsDropTarget="True"
					  dd:DragDrop.DropHandler="{Binding}"
					  local:DragDropAutoScrollBehavior.IsEnabled="True">
				<ItemsControl.ItemTemplateSelector>
					<StaticResource ResourceKey="DashboardItemTemplateSelector"/>
				</ItemsControl.ItemTemplateSelector>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</ScrollViewer>

		<Button Grid.Row="1"
				Grid.Column="2"
				Style="{StaticResource FluentIconButton}"
				Command="{Binding GroupSidebar.ToggleOpenCommand}"
				ToolTip="{loc:Loc ModGroup.ToggleSidebar}"
				VerticalAlignment="Top"
				Margin="8 0 8 0">
			<TextBlock Text="{Binding GroupSidebar.ToggleGlyph}" FontFamily="Segoe Fluent Icons" FontSize="16"/>
		</Button>

		<!-- 分组侧边栏：覆盖式抽屉，用 RenderTransform 平移替代 Width 布局动画，
			 避免每帧触发整个 Grid 的 Measure+Arrange 导致卡顿掉帧 -->
		<Border Grid.Row="0"
				Grid.RowSpan="3"
				Grid.Column="1"
				Panel.ZIndex="1"
				Width="260"
				HorizontalAlignment="Right"
				VerticalAlignment="Stretch">
			<Border.RenderTransform>
				<TranslateTransform X="260"/>
			</Border.RenderTransform>
			<Border.Style>
				<Style TargetType="Border">
					<!-- 关闭态默认值：透明、不响应点击、平移到右侧外 -->
					<Setter Property="Opacity" Value="0"/>
					<Setter Property="IsHitTestVisible" Value="False"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding GroupSidebar.IsOpen}" Value="True">
							<!-- 打开期间允许交互 -->
							<Setter Property="IsHitTestVisible" Value="True"/>
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
														 To="0" Duration="0:0:0.18">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut"/>
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation Storyboard.TargetProperty="Opacity"
														 To="1" Duration="0:0:0.14">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut"/>
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
														 To="260" Duration="0:0:0.16">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseIn"/>
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation Storyboard.TargetProperty="Opacity"
														 To="0" Duration="0:0:0.12">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseIn"/>
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<views:ModGroupSidebarView DataContext="{Binding GroupSidebar}"/>
		</Border>

		<!-- Bottom Action Bar -->
		<Border Grid.Row="2"
				Grid.Column="1"
				Style="{StaticResource FluentCard}"
				CornerRadius="8">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Version Check Status & Hash Migration (左侧) -->
				<!-- 使用 Grid 替代 StackPanel，使 * 列能正确约束 TextBlock 宽度，避免长文本溢出覆盖右侧按钮 -->
				<Grid Grid.Column="0"
					  VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0"
							Width="12"
							Height="12"
							CornerRadius="6"
							Background="{StaticResource SystemAccentBrush}"
							Visibility="{Binding IsCheckingVersion, Converter={StaticResource BoolToVisibilityConverter}}"/>
					<TextBlock Grid.Column="1"
							   Text="{Binding VersionCheckSummary}"
							   FontSize="12"
							   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
							   VerticalAlignment="Center"
							   Margin="8 0 0 0"
							   TextTrimming="CharacterEllipsis"
							   Visibility="{Binding HasVersionCheckResult, Converter={StaticResource BoolToVisibilityConverter}}"/>
					<!-- 哈希迁移状态（版本升级后后台计算文件指纹的进度提示） -->
					<TextBlock Grid.Column="1"
							   Text="{Binding HashMigrationStatusText}"
							   FontSize="12"
							   Foreground="{StaticResource SystemAccentBrush}"
							   VerticalAlignment="Center"
							   Margin="8 0 0 0"
							   TextTrimming="CharacterEllipsis"
							   Visibility="{Binding HashMigrationStatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
				</Grid>

				<!-- Action Buttons (右侧) -->
				<StackPanel x:Name="BottomActionButtons" Grid.Column="1"
							Orientation="Horizontal">
                    <Button Style="{StaticResource FluentSecondaryButton}"
                            Command="{Binding BatchRepairCommand}"
                            IsEnabled="{Binding Initialized}"
                            Visibility="{Binding IsBatchRepairEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="14 10"
                            ToolTip="{loc:Loc VersionCheckBatch.ButtonHint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0 0 7 0"/>
                            <TextBlock Text="{loc:Loc VersionCheckBatch.Button}"/>
                        </StackPanel>
                    </Button>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc DashboardPage.RescanMods}"
							Command="{Binding RescanModsCommand}"
							IsEnabled="{Binding Initialized}"
							Padding="20 10">
						<Button.ToolTip>
							<ToolTip Content="{loc:Loc DashboardPage.RescanModsHint}"/>
						</Button.ToolTip>
					</Button>
					<Button Style="{StaticResource FluentDangerButton}"
							Content="{loc:Loc DashboardPage.CleanMods}"
							Command="{Binding PurgeCommand}"
							IsEnabled="{Binding Initialized}"
							Padding="20 10">
						<Button.ToolTip>
							<ToolTip Content="{loc:Loc DashboardPage.CleanModsHint}"/>
						</Button.ToolTip>
					</Button>
					<Button x:Name="DeployModsButton" Style="{StaticResource FluentConfirmButton}"
							Content="{loc:Loc DashboardPage.DeployMods}"
							Command="{Binding DeployCommand}"
							IsEnabled="{Binding Initialized}"
							Padding="20 10">
						<Button.ToolTip>
							<ToolTip Content="{loc:Loc DashboardPage.DeployModsHint}"/>
						</Button.ToolTip>
					</Button>
					<Button Style="{StaticResource FluentPrimaryButton}"
							Content="{loc:Loc DashboardPage.LaunchGame}"
							Command="{Binding RunCommand}"
							IsEnabled="{Binding Initialized}"
							Padding="20 10">
						<Button.ToolTip>
							<ToolTip Content="{loc:Loc DashboardPage.LaunchGameHint}"/>
						</Button.ToolTip>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

	</Grid>
</Page>
