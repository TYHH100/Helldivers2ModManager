<Window x:Class="Helldivers2ModManager.Views.Create.IncludeDirectoryPicker"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
		Title="{loc:Loc CreateWizard.IncludePickerTitle}"
		Width="480"
		Height="520"
		WindowStartupLocation="CenterOwner"
		ResizeMode="CanResizeWithGrip"
		Background="#202020"
		ShowInTaskbar="False">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 提示文字 -->
		<TextBlock Grid.Row="0"
				   Text="{loc:Loc CreateWizard.IncludePickerDesc}"
				   FontSize="13"
				   Foreground="#CCCCCC"
				   Margin="0 0 0 8"
				   TextWrapping="Wrap"/>

		<!-- 目录树 -->
		<Border Grid.Row="1"
				BorderBrush="#404040"
				BorderThickness="1"
				CornerRadius="4"
				Margin="0 0 0 12">
			<TreeView x:Name="DirectoryTree"
					  Background="Transparent"
					  Foreground="#CCCCCC"
					  BorderThickness="0"
					  FontSize="13"
					  Padding="4"/>
		</Border>

		<!-- 底部按钮 -->
		<StackPanel Grid.Row="2"
					Orientation="Horizontal"
					HorizontalAlignment="Right">
			<Button Content="{loc:Loc CreateWizard.IncludePickerOK}"
					Width="80"
					Height="32"
					Click="OkButton_Click"
					Margin="0 0 8 0"/>
			<Button Content="{loc:Loc CreateWizard.IncludePickerCancel}"
					Width="80"
					Height="32"
					Click="CancelButton_Click"/>
		</StackPanel>
	</Grid>
</Window>
