<Page x:Class="Helldivers2ModManager.Views.Create.ChoosePageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:Helldivers2ModManager.Views.Create"
	  xmlns:cvms="clr-namespace:Helldivers2ModManager.ViewModels.Create"
	  mc:Ignorable="d"
	  d:DesignHeight="500"
	  d:DesignWidth="800"
	  d:Background="Transparent"
	  d:DataContext="{x:Type cvms:ChoosePageViewModel}">
	<StackPanel Margin="16">
		<TextBlock Style="{StaticResource FluentBodyText}"
				   FontSize="16"
				   TextWrapping="Wrap"
				   Margin="0 0 0 16">
			<Run Text="让我们从一个简单的问题开始:"/>
			<LineBreak/>
			<Run Text="您的模组有可选项吗(比如颜色切换)?" FontWeight="SemiBold"/>
		</TextBlock>
		<RadioButton GroupName="HasOptions"
					 IsChecked="{Binding HasOptions}"
					 Margin="0 0 0 8"
					 VerticalContentAlignment="Center">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="&#xE8FB;"
						   FontFamily="Segoe Fluent Icons"
						   FontSize="16"
						   VerticalAlignment="Center"
						   Margin="0 0 8 0"/>
				<TextBlock Text="是" FontSize="14"/>
			</StackPanel>
		</RadioButton>
		<RadioButton GroupName="HasOptions"
					 IsChecked="{Binding HasNoOptions}"
					 VerticalContentAlignment="Center">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="&#xE711;"
						   FontFamily="Segoe Fluent Icons"
						   FontSize="16"
						   VerticalAlignment="Center"
						   Margin="0 0 8 0"/>
				<TextBlock Text="否" FontSize="14"/>
			</StackPanel>
		</RadioButton>
	</StackPanel>
</Page>