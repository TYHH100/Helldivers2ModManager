<Page x:Class="Helldivers2ModManager.Views.DeploymentOrderPageView"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dd="urn:gong-wpf-dragdrop"
      xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
      xmlns:local="clr-namespace:Helldivers2ModManager"
      xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vms:DeploymentOrderPageViewModel}"
      d:Background="{DynamicResource MicaBackgroundBrush}"
      d:DesignWidth="800"
      d:DesignHeight="600"
      Title="{Binding Title}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    AutomationProperties.Name="{loc:Loc Common.Back}"
                    Style="{StaticResource FluentIconButton}"
                    Command="{Binding BackCommand}"
                    ToolTip="{loc:Loc Common.Back}"
                    Width="36" Height="36">
                <TextBlock Text="&#xE72B;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="16"
                           VerticalAlignment="Center"/>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       Style="{StaticResource FluentSectionHeader}"
                       VerticalAlignment="Center"
                       Margin="12 0 0 0"/>
        </Grid>

        <!-- 部署方向说明 -->
        <Border Grid.Row="1"
                Background="{DynamicResource NeutralBackgroundFillSecondaryBrush}"
                CornerRadius="6"
                Padding="12 8"
                Margin="0 0 0 12">
            <TextBlock Text="{Binding OrderDescription}"
                       FontSize="13"
                       Foreground="{DynamicResource NeutralForegroundSecondaryBrush}"/>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource LayerBackgroundBrush}"
                BorderBrush="{DynamicResource NeutralStrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0 0 0 8">
                <WrapPanel Orientation="Horizontal">
                <Button Content="{loc:Loc DeploymentOrderPage.MoveTop}"
                        Command="{Binding MoveToTopCommand}"
                        IsEnabled="{Binding CanMoveToTop}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Margin="0 0 6 4"/>
                <Button Content="{loc:Loc DeploymentOrderPage.MoveBottom}"
                        Command="{Binding MoveToBottomCommand}"
                        IsEnabled="{Binding CanMoveToBottom}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Margin="0 0 6 4"/>
                <Rectangle Width="1"
                           Fill="{DynamicResource NeutralStrokeBrush}"
                           Margin="12 4"
                           Height="20"/>
                <Button Content="{loc:Loc DeploymentOrderPage.SyncFromHome}"
                        Command="{Binding InitFromCurrentCommand}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Margin="0 0 6 4"/>
                <Button Content="{loc:Loc DeploymentOrderPage.ClearList}"
                        Command="{Binding ClearOrderCommand}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Margin="0 0 6 4"/>
                <Rectangle Width="1"
                           Fill="{DynamicResource NeutralStrokeBrush}"
                           Margin="12 4"
                           Height="20"/>
                <Button Content="{loc:Loc DashboardPage.SelectAll}"
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Margin="0 0 6 4"/>
                <Button Content="{loc:Loc DeploymentOrderPage.DeselectAll}"
                        Command="{Binding DeselectAllCommand}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Margin="0 0 6 4"/>
                <Button Content="{loc:Loc DeploymentOrderPage.InvertSelect}"
                        Command="{Binding InvertSelectionCommand}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Margin="0 0 6 4"/>
            </WrapPanel>
        </Border>

        <!-- 部署顺序列表（支持拖拽和多选） -->
        <Border Grid.Row="3"
                Background="{DynamicResource LayerBackgroundBrush}"
                BorderBrush="{DynamicResource NeutralStrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0">
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     dd:DragDrop.IsDragSource="True"
                     dd:DragDrop.IsDropTarget="True"
                     dd:DragDrop.DropHandler="{Binding}"
                     local:DragDropAutoScrollBehavior.IsEnabled="True"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 多选复选框 -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      Style="{StaticResource FluentCheckBox}"
                                      VerticalAlignment="Center"
                                      Margin="6 0 6 0"/>
                            <!-- 拖拽把手图标 -->
                            <TextBlock Grid.Column="1"
                                       Text="&#xE763;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="14"
                                       Foreground="{DynamicResource NeutralForegroundTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0 0 6 0"/>
                            <!-- 名称 -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       Foreground="{DynamicResource NeutralForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4"
                   Text="{loc:Loc DeploymentOrderPage.HintText}"
                   FontSize="12"
                   Foreground="{DynamicResource NeutralForegroundTertiaryBrush}"
                   Margin="0 8 0 0"/>
    </Grid>
</Page>
