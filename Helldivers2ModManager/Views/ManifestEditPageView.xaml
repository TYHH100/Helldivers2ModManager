<Page x:Class="Helldivers2ModManager.Views.ManifestEditPageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:dd="urn:gong-wpf-dragdrop"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:cvms="clr-namespace:Helldivers2ModManager.ViewModels.Create"
	  xmlns:local="clr-namespace:Helldivers2ModManager"
	  xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:ManifestEditPageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="800"
	  d:DesignHeight="600"
	  Title="{Binding Title}">
	<Grid>
		<Grid Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- 标题 -->
			<TextBlock Grid.Row="0"
					   Text="{loc:Loc DashboardPage.EditManifest}"
					   Style="{StaticResource FluentSectionHeader}"
					   HorizontalAlignment="Center"
					   Margin="0 0 0 16"/>

			<!-- 编辑模式切换 -->
			<Border Grid.Row="1"
					Background="{StaticResource NeutralBackgroundFillBrush}"
					CornerRadius="6"
					Padding="8 6"
					Margin="0 0 0 12"
					HorizontalAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<RadioButton GroupName="EditMode"
								 IsChecked="{Binding IsJsonMode, Converter={StaticResource InverseBoolConverter}}"
								 Content="{loc:Loc CreatePage.VisualEdit}"
								 Margin="0,0,12,0"
								 Padding="12 4"
								 Style="{StaticResource FluentRadioButton}"/>
					<RadioButton GroupName="EditMode"
								 IsChecked="{Binding IsJsonMode}"
								 Content="{loc:Loc ManifestEditPage.JsonEdit}"
								 Padding="12 4"
								 Style="{StaticResource FluentRadioButton}"/>
				</StackPanel>
			</Border>

			<!-- 编辑内容区域 -->
			<ScrollViewer Grid.Row="2"
						  HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Auto"
						  Margin="0 0 0 16">

				<StackPanel>
				<!-- 可视化编辑模式 -->
				<StackPanel>
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Setter Property="Visibility" Value="Visible"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsJsonMode}" Value="True">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>

					<!-- 模组基本信息 -->
					<Border Style="{StaticResource FluentCard}"
							CornerRadius="8"
							Margin="0 0 0 12">
						<StackPanel Margin="16">
							<TextBlock Text="{loc:Loc ManifestEditPage.BasicInfo}"
									   FontSize="16"
									   FontWeight="SemiBold"
									   Foreground="{StaticResource NeutralForegroundBrush}"
									   Margin="0 0 0 12"/>

							<!-- 图标 + 名称/描述 -->
							<Grid Margin="0 0 0 8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<!-- 图标预览 -->
								<Border Grid.Column="0"
										Width="80"
										Height="80"
										CornerRadius="6"
										Background="#20FFFFFF"
										Margin="0 0 16 0"
										VerticalAlignment="Top">
									<Image Source="{Binding IconPreview}"
										   Stretch="Uniform"
										   VerticalAlignment="Center"
										   HorizontalAlignment="Center"/>
								</Border>
								<!-- 名称和描述 -->
								<StackPanel Grid.Column="1">
									<TextBlock Text="{loc:Loc CreatePage.Name}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
									<TextBox Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Padding="4 2"
											 Margin="0 0 0 8"/>
									<TextBlock Text="{loc:Loc ManifestEditPage.Description}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
									<TextBox Text="{Binding ModDescription, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="13"
											 Padding="4 2"
											 AcceptsReturn="True"
											 TextWrapping="Wrap"
											 MaxHeight="80"
											 VerticalScrollBarVisibility="Auto"/>
									<!-- 图标选择 -->
									<TextBlock Text="{loc:Loc CreatePage.Icon}"
											   FontSize="12"
											   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
											   Margin="0 0 2 2"/>
									<Grid Margin="0 0 0 6">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBox Grid.Column="0"
												 Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
												 FontSize="12"
												 Padding="4 2"
												 VerticalAlignment="Center"/>
										<Button Grid.Column="1"
												Content="{loc:Loc ManifestEditPage.SelectIcon}"
												Style="{StaticResource FluentSecondaryButton}"
												Command="{Binding BrowseIconCommand}"
												Margin="4 0 0 0"
												Padding="8 4"
												FontSize="12"/>
									</Grid>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<!-- 选项管理区域 -->
					<Border Style="{StaticResource FluentCard}"
							CornerRadius="8"
							Visibility="{Binding ShowOptionEditing, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Margin="16">
							<!-- Legacy 升级提示 -->
							<Border Background="#33FFB900"
									CornerRadius="4"
									Padding="8"
									Margin="0 0 0 8"
									Visibility="{Binding IsLegacyManifest, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock Text="{loc:Loc ManifestEditPage.LegacyUpgradeHint}"
										   FontSize="12"
										   Foreground="{StaticResource NeutralForegroundBrush}"
										   TextWrapping="Wrap"/>
							</Border>

							<!-- 选项标题 + 添加按钮 -->
							<TextBlock Text="{loc:Loc ManifestEditPage.Options}"
									   FontSize="16"
									   FontWeight="SemiBold"
									   Foreground="{StaticResource NeutralForegroundBrush}"
									   Margin="0 0 0 4"/>
							<TextBlock Text="{loc:Loc ManifestEditPage.OptionsDesc}"
									   FontSize="13"
									   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
									   Margin="0 0 0 4"/>

							<!-- 拖拽排序提示 -->
							<Border Background="{StaticResource NeutralBackgroundFillBrush}"
									CornerRadius="4"
									Padding="8 4"
									Margin="0 0 0 8">
								<TextBlock Text="{loc:Loc CreatePage.DragHint}"
										   FontSize="12"
										   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
										   HorizontalAlignment="Center"/>
							</Border>

							<!-- 选项列表（支持拖拽排序） -->
							<ItemsControl ItemsSource="{Binding EditOptions}"
										  dd:DragDrop.IsDragSource="True"
										  dd:DragDrop.IsDropTarget="True"
										  local:DragDropAutoScrollBehavior.IsEnabled="True">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="{x:Type cvms:CreateModOptionViewModel}">
										<Border Style="{StaticResource FluentSettingsCard}"
												Margin="0 0 0 8"
												Padding="16"
												BorderBrush="{StaticResource NeutralForegroundSecondaryBrush}"
												BorderThickness="1"
												CornerRadius="6">
											<StackPanel>
												<!-- 选项标题行 + 删除按钮 -->
												<Grid Margin="0 0 0 8">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0"
															   Text="{loc:Loc CreatePage.OptionTitle}"
															   FontSize="14"
															   FontWeight="SemiBold"
															   Foreground="{StaticResource NeutralForegroundBrush}"
															   VerticalAlignment="Center"/>
													<Button Grid.Column="1"
															Style="{StaticResource FluentIconButton}"
															Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
															CommandParameter="{Binding}"
															ToolTip="{loc:Loc CreatePage.DeleteOption}"
															Padding="6">
														<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
													</Button>
												</Grid>

												<!-- 选项图片 + 名称/描述 -->
												<Grid Margin="0 0 0 8">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="*"/>
													</Grid.ColumnDefinitions>
													<!-- 选项图片预览 -->
													<Border Grid.Column="0"
															Width="64"
															Height="64"
															CornerRadius="4"
															Background="#20FFFFFF"
															Margin="0 0 12 0"
															VerticalAlignment="Top">
														<Image Source="{Binding ImagePreview}"
															   Stretch="Uniform"
															   VerticalAlignment="Center"
															   HorizontalAlignment="Center"/>
													</Border>
													<!-- 选项名称、描述、Include 路径 -->
													<StackPanel Grid.Column="1">
														<TextBlock Text="{loc:Loc CreatePage.OptionName}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
														<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
																 FontSize="14"
																 Padding="4 2"
																 Margin="0 0 0 6"/>
														<TextBlock Text="{loc:Loc ManifestEditPage.OptionDesc}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
														<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
																 FontSize="13"
																 Padding="4 2"
																 Margin="0 0 0 6"/>
														<TextBlock Text="{loc:Loc CreatePage.OptionInclude}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
														<Grid Margin="0 0 0 6">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="Auto"/>
															</Grid.ColumnDefinitions>
															<TextBox Grid.Column="0"
																	 Text="{Binding IncludePaths, UpdateSourceTrigger=PropertyChanged}"
																	 FontSize="12"
																	 Padding="4 2"
																	 VerticalAlignment="Center"/>
															<Button Grid.Column="1"
																	Content="{loc:Loc ManifestEditPage.OptionBrowse}"
																	Style="{StaticResource FluentSecondaryButton}"
																	Command="{Binding BrowseIncludeCommand}"
																	Margin="4 0 0 0"
																	Padding="8 4"
																	FontSize="12"/>
														</Grid>
														<!-- 选项图标选择 -->
														<TextBlock Text="{loc:Loc CreatePage.OptionIcon}"
																   FontSize="12"
																   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
																   Margin="0 0 2 2"/>
														<Grid Margin="0 0 0 6">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="Auto"/>
															</Grid.ColumnDefinitions>
															<TextBox Grid.Column="0"
																	 Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
																	 FontSize="12"
																	 Padding="4 2"
																	 VerticalAlignment="Center"/>
															<Button Grid.Column="1"
																	Content="{loc:Loc ManifestEditPage.SelectIconBtn}"
																	Style="{StaticResource FluentSecondaryButton}"
																	Command="{Binding BrowseImageCommand}"
																	Margin="4 0 0 0"
																	Padding="8 4"
																	FontSize="12"/>
														</Grid>
													</StackPanel>
												</Grid>

												<!-- 子选项区域 -->
												<TextBlock Text="{loc:Loc ManifestEditPage.SubOptions}"
														   FontSize="13"
														   FontWeight="SemiBold"
														   Foreground="{StaticResource NeutralForegroundBrush}"
														   VerticalAlignment="Center"
														   Margin="0 4 0 4"/>

												<!-- 子选项列表（支持拖拽排序） -->
												<ItemsControl ItemsSource="{Binding SubOptions}"
															  Margin="0 4 0 0"
															  dd:DragDrop.IsDragSource="True"
															  dd:DragDrop.IsDropTarget="True"
															  local:DragDropAutoScrollBehavior.IsEnabled="True">
													<ItemsControl.ItemTemplate>
														<DataTemplate DataType="{x:Type cvms:CreateModSubOptionViewModel}">
															<Border Background="#15FFFFFF"
																	CornerRadius="4"
																	Padding="12"
																	Margin="0 4 0 0">
																<StackPanel>
																	<!-- 子选项标题 + 删除按钮 -->
																	<Grid Margin="0 0 0 6">
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="*"/>
																			<ColumnDefinition Width="Auto"/>
																		</Grid.ColumnDefinitions>
																		<TextBlock Grid.Column="0"
																				   Text="{loc:Loc ManifestEditPage.SubOptionTitle}"
																				   FontSize="12"
																				   FontWeight="SemiBold"
																				   Foreground="{StaticResource NeutralForegroundBrush}"
																				   VerticalAlignment="Center"/>
																		<Button Grid.Column="1"
																				Style="{StaticResource FluentIconButton}"
																				Command="{Binding DataContext.RemoveSubOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
																				CommandParameter="{Binding}"
																				ToolTip="{loc:Loc CreatePage.DeleteSubOption}"
																				Padding="4">
																			<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
																		</Button>
																	</Grid>
																	<Grid>
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="Auto"/>
																			<ColumnDefinition Width="*"/>
																		</Grid.ColumnDefinitions>
																		<!-- 子选项图片预览 -->
																		<Border Grid.Column="0"
																				Width="40"
																				Height="40"
																				CornerRadius="4"
																				Background="#20FFFFFF"
																				Margin="0 0 8 0"
																				VerticalAlignment="Top">
																			<Image Source="{Binding ImagePreview}"
																				   Stretch="Uniform"
																				   VerticalAlignment="Center"
																				   HorizontalAlignment="Center"/>
																		</Border>
																		<!-- 子选项名称、描述、Include 路径 -->
																		<StackPanel Grid.Column="1">
																			<TextBlock Text="{loc:Loc CreatePage.SubOptionName}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																			<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
																					 FontSize="13"
																					 FontWeight="SemiBold"
																					 Padding="4 2"
																					 Margin="0 0 0 4"/>
																			<TextBlock Text="{loc:Loc CreatePage.SubOptionDesc}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																			<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
																					 FontSize="12"
																					 Padding="4 2"
																					 Margin="0 0 0 4"/>
																			<TextBlock Text="{loc:Loc CreatePage.SubOptionInclude}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																			<Grid>
																				<Grid.ColumnDefinitions>
																					<ColumnDefinition Width="*"/>
																					<ColumnDefinition Width="Auto"/>
																				</Grid.ColumnDefinitions>
																				<TextBox Grid.Column="0"
																						 Text="{Binding IncludePaths, UpdateSourceTrigger=PropertyChanged}"
																						 FontSize="12"
																						 Padding="4 2"
																						 VerticalAlignment="Center"/>
																				<Button Grid.Column="1"
																						Content="{loc:Loc SettingsPage.Browse}"
																						Style="{StaticResource FluentSecondaryButton}"
																						Command="{Binding BrowseIncludeCommand}"
																						Margin="4 0 0 0"
																						Padding="8 4"
																						FontSize="12"/>
																			</Grid>
																			<!-- 子选项图标选择 -->
																			<TextBlock Text="{loc:Loc CreatePage.SubOptionIcon}"
																					   FontSize="11"
																					   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
																					   Margin="0 0 2 2"/>
																			<Grid Margin="0 0 0 4">
																				<Grid.ColumnDefinitions>
																					<ColumnDefinition Width="*"/>
																					<ColumnDefinition Width="Auto"/>
																				</Grid.ColumnDefinitions>
																				<TextBox Grid.Column="0"
																						 Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
																						 FontSize="12"
																						 Padding="4 2"
																						 VerticalAlignment="Center"/>
																				<Button Grid.Column="1"
																						Content="{loc:Loc CreatePage.SelectSubIcon}"
																						Style="{StaticResource FluentSecondaryButton}"
																						Command="{Binding BrowseImageCommand}"
																						Margin="4 0 0 0"
																						Padding="8 4"
																						FontSize="12"/>
																			</Grid>
																		</StackPanel>
																	</Grid>
																</StackPanel>
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
												<Button Content="{loc:Loc ManifestEditPage.AddSubOption}"
														Style="{StaticResource FluentSecondaryButton}"
														Command="{Binding AddSubOptionCommand}"
														HorizontalAlignment="Center"
														Margin="0 8 0 0"
														Padding="12 6"
														FontSize="12"/>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Button Content="{loc:Loc CreatePage.AddOption}"
									Style="{StaticResource FluentSecondaryButton}"
									Command="{Binding AddOptionCommand}"
									HorizontalAlignment="Center"
									Margin="0 8 0 0"
									Padding="20 8"
									FontSize="13"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- 直接编辑 JSON 模式 -->
				<TextBox Text="{Binding JsonContent, UpdateSourceTrigger=PropertyChanged}"
						 FontFamily="Consolas"
						 FontSize="12"
						 AcceptsReturn="True"
						 AcceptsTab="True"
						 TextWrapping="NoWrap"
						 VerticalScrollBarVisibility="Auto"
						 HorizontalScrollBarVisibility="Auto"
						 Padding="8"
						 MinHeight="400">
					<TextBox.Style>
						<Style TargetType="TextBox">
							<Setter Property="Visibility" Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsJsonMode}" Value="True">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBox.Style>
				</TextBox>
				</StackPanel>
			</ScrollViewer>

			<!-- 底部按钮 -->
			<Border Grid.Row="3"
					Style="{StaticResource FluentCard}"
					CornerRadius="8">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0"
							Content="{loc:Loc Common.Cancel}"
							Style="{StaticResource FluentSecondaryButton}"
							Command="{Binding CancelCommand}"
							HorizontalAlignment="Left"
							Padding="24 10"/>

					<Button Grid.Column="1"
							Content="{loc:Loc Common.Save}"
							Style="{StaticResource FluentPrimaryButton}"
							Command="{Binding DoneCommand}"
							HorizontalAlignment="Right"
							Padding="24 10"/>
				</Grid>
			</Border>
		</Grid>

	</Grid>
</Page>
