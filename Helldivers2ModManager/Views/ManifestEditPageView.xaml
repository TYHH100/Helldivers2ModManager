<Page x:Class="Helldivers2ModManager.Views.ManifestEditPageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:cvms="clr-namespace:Helldivers2ModManager.ViewModels.Create"
	  xmlns:local="clr-namespace:Helldivers2ModManager"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:ManifestEditPageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="800"
	  d:DesignHeight="600"
	  Title="{Binding Title}">
	<Grid>
		<Grid Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- 标题 -->
			<TextBlock Grid.Row="0"
					   Text="编辑模组"
					   Style="{StaticResource FluentSectionHeader}"
					   HorizontalAlignment="Center"
					   Margin="0 0 0 16"/>

			<!-- 编辑内容区域 -->
			<ScrollViewer Grid.Row="1"
						  HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Auto"
						  Margin="0 0 0 16">
				<StackPanel>
					<!-- 模组基本信息 -->
					<Border Style="{StaticResource FluentCard}"
							CornerRadius="8"
							Margin="0 0 0 12">
						<StackPanel Margin="16">
							<TextBlock Text="基本信息"
									   FontSize="16"
									   FontWeight="SemiBold"
									   Foreground="{StaticResource NeutralForegroundBrush}"
									   Margin="0 0 0 12"/>

							<!-- 图标 + 名称/描述 -->
							<Grid Margin="0 0 0 8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<!-- 图标预览 -->
								<Border Grid.Column="0"
										Width="80"
										Height="80"
										CornerRadius="6"
										Background="#20FFFFFF"
										Margin="0 0 16 0"
										VerticalAlignment="Top">
									<Image Source="{Binding IconPreview}"
										   Stretch="Uniform"
										   VerticalAlignment="Center"
										   HorizontalAlignment="Center"/>
								</Border>
								<!-- 名称和描述 -->
								<StackPanel Grid.Column="1">
									<TextBlock Text="名称" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
									<TextBox Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Padding="4 2"
											 Margin="0 0 0 8"/>
									<TextBlock Text="描述" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
									<TextBox Text="{Binding ModDescription, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="13"
											 Padding="4 2"
											 AcceptsReturn="True"
											 TextWrapping="Wrap"
											 MaxHeight="80"
											 VerticalScrollBarVisibility="Auto"/>
								</StackPanel>
							</Grid>

							<!-- 图标选择 -->
							<Grid Margin="0 4 0 0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0"
										   Text="图标"
										   FontSize="12"
										   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
										   VerticalAlignment="Center"
										   Margin="0 0 8 0"/>
								<TextBox Grid.Column="1"
										 Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
										 IsReadOnly="True"
										 FontSize="12"
										 Padding="4 2"
										 VerticalAlignment="Center"/>
								<Button Grid.Column="2"
										Content="选择图标"
										Style="{StaticResource FluentSecondaryButton}"
										Command="{Binding BrowseIconCommand}"
										Margin="4 0 0 0"
										Padding="8 4"
										FontSize="12"/>
							</Grid>
						</StackPanel>
					</Border>

					<!-- 选项管理区域 -->
					<Border Style="{StaticResource FluentCard}"
							CornerRadius="8"
							Visibility="{Binding ShowOptionEditing, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Margin="16">
							<!-- Legacy 升级提示 -->
							<Border Background="#33FFB900"
									CornerRadius="4"
									Padding="8"
									Margin="0 0 0 8"
									Visibility="{Binding IsLegacyManifest, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock Text="此模组为旧版格式，添加选项后保存时将自动升级为 V1 格式。"
										   FontSize="12"
										   Foreground="{StaticResource NeutralForegroundBrush}"
										   TextWrapping="Wrap"/>
							</Border>

							<!-- 选项标题 + 添加按钮 -->
							<Grid Margin="0 0 0 4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0"
										   Text="选项"
										   FontSize="16"
										   FontWeight="SemiBold"
										   Foreground="{StaticResource NeutralForegroundBrush}"/>
								<Button Grid.Column="1"
										Content="添加选项"
										Style="{StaticResource FluentSecondaryButton}"
										Command="{Binding AddOptionCommand}"
										Padding="12 6"
										FontSize="13"/>
							</Grid>
							<TextBlock Text="编辑模组的可选项，每个选项可包含子选项。"
									   FontSize="13"
									   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
									   Margin="0 0 0 8"/>

							<!-- 选项列表 -->
							<ItemsControl ItemsSource="{Binding EditOptions}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="{x:Type cvms:CreateModOptionViewModel}">
										<Border Style="{StaticResource FluentSettingsCard}"
												Margin="0 0 0 8"
												Padding="16"
												BorderBrush="{StaticResource NeutralForegroundSecondaryBrush}"
												BorderThickness="1"
												CornerRadius="6">
											<StackPanel>
												<!-- 选项标题行 + 删除按钮 -->
												<Grid Margin="0 0 0 8">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0"
															   Text="选项"
															   FontSize="14"
															   FontWeight="SemiBold"
															   Foreground="{StaticResource NeutralForegroundBrush}"
															   VerticalAlignment="Center"/>
													<Button Grid.Column="1"
															Style="{StaticResource FluentIconButton}"
															Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
															CommandParameter="{Binding}"
															ToolTip="删除此选项"
															Padding="6">
														<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
													</Button>
												</Grid>

												<!-- 选项图片 + 名称/描述 -->
												<Grid Margin="0 0 0 8">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="*"/>
													</Grid.ColumnDefinitions>
													<!-- 选项图片预览 -->
													<Border Grid.Column="0"
															Width="64"
															Height="64"
															CornerRadius="4"
															Background="#20FFFFFF"
															Margin="0 0 12 0"
															VerticalAlignment="Top">
														<Image Source="{Binding ImagePreview}"
															   Stretch="Uniform"
															   VerticalAlignment="Center"
															   HorizontalAlignment="Center"/>
													</Border>
													<!-- 选项名称、描述、Include 路径 -->
													<StackPanel Grid.Column="1">
														<TextBlock Text="名称" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
														<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
																 FontSize="14"
																 Padding="4 2"
																 Margin="0 0 0 6"/>
														<TextBlock Text="描述" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
														<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
																 FontSize="13"
																 Padding="4 2"
																 Margin="0 0 0 6"/>
														<TextBlock Text="Include 路径（相对于源目录，分号分隔）" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
														<Grid Margin="0 0 0 6">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="Auto"/>
															</Grid.ColumnDefinitions>
															<TextBox Grid.Column="0"
																	 Text="{Binding IncludePaths, UpdateSourceTrigger=PropertyChanged}"
																	 FontSize="12"
																	 Padding="4 2"
																	 VerticalAlignment="Center"/>
															<Button Grid.Column="1"
																	Content="浏览"
																	Style="{StaticResource FluentSecondaryButton}"
																	Command="{Binding BrowseIncludeCommand}"
																	Margin="4 0 0 0"
																	Padding="8 4"
																	FontSize="12"/>
														</Grid>
													</StackPanel>
												</Grid>

												<!-- 选项图片选择 -->
												<Grid Margin="0 0 0 8">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0"
															   Text="图片"
															   FontSize="12"
															   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
															   VerticalAlignment="Center"
															   Margin="0 0 8 0"/>
													<TextBox Grid.Column="1"
															 Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
															 IsReadOnly="True"
															 FontSize="12"
															 Padding="4 2"
															 VerticalAlignment="Center"/>
													<Button Grid.Column="2"
															Content="选择图片"
															Style="{StaticResource FluentSecondaryButton}"
															Command="{Binding BrowseImageCommand}"
															Margin="4 0 0 0"
															Padding="8 4"
															FontSize="12"/>
												</Grid>

												<!-- 子选项区域 -->
												<Grid Margin="0 4 0 4">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0"
															   Text="子选项"
															   FontSize="13"
															   FontWeight="SemiBold"
															   Foreground="{StaticResource NeutralForegroundBrush}"
															   VerticalAlignment="Center"/>
													<Button Grid.Column="1"
															Content="添加子选项"
															Style="{StaticResource FluentSecondaryButton}"
															Command="{Binding AddSubOptionCommand}"
															Padding="8 4"
															FontSize="12"/>
												</Grid>

												<!-- 子选项列表 -->
												<ItemsControl ItemsSource="{Binding SubOptions}"
															  Margin="0 4 0 0">
													<ItemsControl.ItemTemplate>
														<DataTemplate DataType="{x:Type cvms:CreateModSubOptionViewModel}">
															<Border Background="#15FFFFFF"
																	CornerRadius="4"
																	Padding="12"
																	Margin="0 4 0 0">
																<StackPanel>
																	<!-- 子选项标题 + 删除按钮 -->
																	<Grid Margin="0 0 0 6">
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="*"/>
																			<ColumnDefinition Width="Auto"/>
																		</Grid.ColumnDefinitions>
																		<TextBlock Grid.Column="0"
																				   Text="子选项"
																				   FontSize="12"
																				   FontWeight="SemiBold"
																				   Foreground="{StaticResource NeutralForegroundBrush}"
																				   VerticalAlignment="Center"/>
																		<Button Grid.Column="1"
																				Style="{StaticResource FluentIconButton}"
																				Command="{Binding DataContext.RemoveSubOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
																				CommandParameter="{Binding}"
																				ToolTip="删除此子选项"
																				Padding="4">
																			<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
																		</Button>
																	</Grid>
																	<Grid>
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="Auto"/>
																			<ColumnDefinition Width="*"/>
																		</Grid.ColumnDefinitions>
																		<!-- 子选项图片预览 -->
																		<Border Grid.Column="0"
																				Width="40"
																				Height="40"
																				CornerRadius="4"
																				Background="#20FFFFFF"
																				Margin="0 0 8 0"
																				VerticalAlignment="Top">
																			<Image Source="{Binding ImagePreview}"
																				   Stretch="Uniform"
																				   VerticalAlignment="Center"
																				   HorizontalAlignment="Center"/>
																		</Border>
																		<!-- 子选项名称、描述、Include 路径 -->
																		<StackPanel Grid.Column="1">
																			<TextBlock Text="名称" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																			<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
																					 FontSize="13"
																					 FontWeight="SemiBold"
																					 Padding="4 2"
																					 Margin="0 0 0 4"/>
																			<TextBlock Text="描述" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																			<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
																					 FontSize="12"
																					 Padding="4 2"
																					 Margin="0 0 0 4"/>
																			<TextBlock Text="Include 路径（相对于源目录，分号分隔）" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 0 2 2"/>
																			<Grid>
																				<Grid.ColumnDefinitions>
																					<ColumnDefinition Width="*"/>
																					<ColumnDefinition Width="Auto"/>
																				</Grid.ColumnDefinitions>
																				<TextBox Grid.Column="0"
																						 Text="{Binding IncludePaths, UpdateSourceTrigger=PropertyChanged}"
																						 FontSize="12"
																						 Padding="4 2"
																						 VerticalAlignment="Center"/>
																				<Button Grid.Column="1"
																						Content="浏览"
																						Style="{StaticResource FluentSecondaryButton}"
																						Command="{Binding BrowseIncludeCommand}"
																						Margin="4 0 0 0"
																						Padding="8 4"
																						FontSize="12"/>
																			</Grid>
																		</StackPanel>
																	</Grid>
																	<!-- 子选项图片选择 -->
																	<Grid Margin="0 4 0 0">
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="Auto"/>
																			<ColumnDefinition Width="*"/>
																			<ColumnDefinition Width="Auto"/>
																		</Grid.ColumnDefinitions>
																		<TextBlock Grid.Column="0"
																				   Text="图片"
																				   FontSize="11"
																				   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
																				   VerticalAlignment="Center"
																				   Margin="0 0 8 0"/>
																		<TextBox Grid.Column="1"
																				 Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
																				 IsReadOnly="True"
																				 FontSize="12"
																				 Padding="4 2"
																				 VerticalAlignment="Center"/>
																		<Button Grid.Column="2"
																				Content="选择图片"
																				Style="{StaticResource FluentSecondaryButton}"
																				Command="{Binding BrowseImageCommand}"
																				Margin="4 0 0 0"
																				Padding="8 4"
																				FontSize="12"/>
																	</Grid>
																</StackPanel>
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<!-- 底部按钮 -->
			<Border Grid.Row="2"
					Style="{StaticResource FluentCard}"
					CornerRadius="8">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0"
							Content="取消"
							Style="{StaticResource FluentSecondaryButton}"
							Command="{Binding CancelCommand}"
							HorizontalAlignment="Left"
							Padding="24 10"/>

					<Button Grid.Column="1"
							Content="保存"
							Style="{StaticResource FluentPrimaryButton}"
							Command="{Binding DoneCommand}"
							HorizontalAlignment="Right"
							Padding="24 10"/>
				</Grid>
			</Border>
		</Grid>

		<!-- 图片预览覆盖层 -->
		<Border Background="#CC000000"
				Padding="60 80"
				Visibility="{Binding ImagePreviewVisibility}"
				d:Visibility="Hidden"
				MouseLeftButtonDown="ImagePreviewOverlay_MouseLeftButtonDown">
			<Border Style="{StaticResource FluentMessageDialog}"
					MaxWidth="800"
					MaxHeight="600"
					VerticalAlignment="Center"
					HorizontalAlignment="Center"
					MouseLeftButtonDown="ImagePreviewBorder_MouseLeftButtonDown">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Button Grid.Row="0"
							Style="{StaticResource FluentIconButton}"
							Command="{Binding HideImagePreviewCommand}"
							HorizontalAlignment="Right"
							Margin="0 0 0 8">
						<TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
					</Button>

					<Image Grid.Row="1"
						   Source="{Binding PreviewImageSource}"
						   Stretch="Uniform"
						   MaxWidth="780"
						   MaxHeight="550"/>
				</Grid>
			</Border>
		</Border>
	</Grid>
</Page>
