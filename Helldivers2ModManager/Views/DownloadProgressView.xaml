<UserControl x:Class="Helldivers2ModManager.Views.DownloadProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Helldivers2ModManager.Views"
             xmlns:vm="clr-namespace:Helldivers2ModManager.ViewModels"
             xmlns:models="clr-namespace:Helldivers2ModManager.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate x:Key="DownloadTaskTemplate" DataType="{x:Type models:DownloadTask}">
            <Border Background="#2a2a4a" CornerRadius="8" Padding="12" Margin="0 0 0 8"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                <Border.ContextMenu>
                    <ContextMenu MinWidth="160">
                        <!-- 取消下载：仅下载中/等待中显示 -->
                        <MenuItem Header="取消下载"
                                  Command="{Binding PlacementTarget.Tag.CancelDownloadCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Downloading}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Pending}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <!-- 重新下载：仅失败/取消显示 -->
                        <MenuItem Header="重新下载"
                                  Command="{Binding PlacementTarget.Tag.RetryDownloadCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Failed}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Cancelled}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <!-- 打开文件位置：仅已完成显示 -->
                        <MenuItem Header="打开文件位置"
                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Completed}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator/>
                        <!-- 复制下载链接：始终显示 -->
                        <MenuItem Header="复制下载链接"
                                  Command="{Binding PlacementTarget.Tag.CopyDownloadUrlCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <!-- 移除任务：非下载中显示 -->
                        <MenuItem Header="移除任务"
                                  Command="{Binding PlacementTarget.Tag.RemoveTaskCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Completed}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Failed}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Cancelled}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0 0 12 0">
                            <Image x:Name="StatusIcon" Width="24" Height="24" Margin="0 0 0 4">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Pending}">
                                                <Setter Property="Source" Value="pack://application:,,,/Resources/Images/loading.png" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Downloading}">
                                                <Setter Property="Source" Value="pack://application:,,,/Resources/Images/download.png" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Completed}">
                                                <Setter Property="Source" Value="pack://application:,,,/Resources/Images/check.png" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Failed}">
                                                <Setter Property="Source" Value="pack://application:,,,/Resources/Images/error.png" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DownloadStatus.Cancelled}">
                                                <Setter Property="Source" Value="pack://application:,,,/Resources/Images/error.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Filename}" FontSize="14" Foreground="White" Margin="0 0 0 4" />
                            
                            <Border Background="#3a3a5a" CornerRadius="3" Height="6" Margin="0 0 0 4" ClipToBounds="True" Visibility="{Binding Status, Converter={StaticResource DownloadStatusToVisibilityConverter}}">
                                <Rectangle Fill="#4CAF50" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Rectangle.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding Path="Progress" />
                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type Border}}" Path="ActualWidth" />
                                        </MultiBinding>
                                    </Rectangle.Width>
                                </Rectangle>
                            </Border>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}%}" FontSize="12" Foreground="#888" />
                                <TextBlock Text="{Binding BytesDownloaded, Converter={StaticResource BytesConverter}}" FontSize="12" Foreground="#888" Margin="12 0 0 0" />
                                <TextBlock Text="/" FontSize="12" Foreground="#666" Margin="4 0 0 0" />
                                <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}}" FontSize="12" Foreground="#888" Margin="4 0 0 0" />
                            </StackPanel>
                            
                            <!-- 下载速度和预估剩余时间 -->
                            <StackPanel Orientation="Horizontal" Margin="0 2 0 0"
                                        Visibility="{Binding Status, Converter={StaticResource DownloadStatusToVisibilityConverter}}">
                                <TextBlock Text="{Binding Speed, Converter={StaticResource SpeedToReadableConverter}}" FontSize="12" Foreground="#6a9fd8" />
                                <TextBlock Text="{Binding EstimatedTimeRemainingText, StringFormat=剩余 {0}}" FontSize="12" Foreground="#888" Margin="12 0 0 0"
                                           Visibility="{Binding EstimatedTimeRemainingText, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                            
                            <TextBlock 
                                Text="{Binding ErrorMessage}" 
                                FontSize="12" 
                                Foreground="#f44336" 
                                Margin="0 4 0 0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Status, Converter={StaticResource DownloadStatusToStringConverter}}" FontSize="12" Foreground="#888" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Margin="0 0 0 20" BorderThickness="0 0 0 1" BorderBrush="#333">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource FluentIconButton}"
                        Margin="4,3,0,4" HorizontalAlignment="Left" Width="36">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock ToolTip="返回" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <TextBlock Grid.Column="1" Text="下载进度" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0 8 0 8" />
                
                <!-- 清除已完成按钮 -->
                <Button Grid.Column="2"
                        Command="{Binding ClearCompletedCommand}"
                        IsEnabled="{Binding HasCompletedTasks}"
                        Style="{StaticResource FluentIconButton}"
                        Margin="0,3,4,4" HorizontalAlignment="Right"
                        ToolTip="清除已完成的任务">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl 
                    ItemsSource="{Binding DownloadTasks}" 
                    ItemTemplate="{StaticResource DownloadTaskTemplate}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DownloadTasks.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 40 0 0">
                                                    <TextBlock Text="暂无下载任务" FontSize="14" Foreground="#666" />
                                                    <TextBlock Text="从浏览器下载 Nexus Mods 文件时会自动显示在这里" FontSize="12" Foreground="#444" Margin="0 4 0 0" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
