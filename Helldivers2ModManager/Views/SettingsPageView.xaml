<Page x:Class="Helldivers2ModManager.Views.SettingsPageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:sys="clr-namespace:System;assembly=mscorlib"
	  xmlns:logging="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:SettingsPageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="1000"
	  d:DesignHeight="700"
	  Title="{Binding Title}">
	<Page.Resources>
		<ObjectDataProvider x:Key="LogLevelEnumData"
							MethodName="GetValues"
							ObjectType="{x:Type sys:Enum}">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="logging:LogLevel"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</Page.Resources>
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Grid.Row="0"
				   Text="设置"
				   Style="{StaticResource FluentSectionHeader}"
				   Margin="0 0 0 16"/>

		<!-- Settings Content -->
		<ScrollViewer Grid.Row="1"
					  Margin="0 0 0 16">
			<StackPanel Margin="0">

				<!-- Game Directory Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="游戏目录"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Text="您想要安装模组的游戏目录"
								   Style="{StaticResource FluentBodyText}"
								   Margin="0 4 0 12"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox Grid.Column="0"
									 Text="{Binding GameDir, Mode=OneWay}"
									 IsReadOnly="True"
									 VerticalAlignment="Center" TextChanged="TextBox_TextChanged"/>
							<Button Grid.Column="1"
									Content="自动检测"
									Style="{StaticResource FluentSecondaryButton}"
									Command="{Binding DetectGameCommand}"
									Margin="8 0 0 0"
									Padding="12 8"/>
							<Button Grid.Column="2"
									Content="浏览"
									Style="{StaticResource FluentPrimaryButton}"
									Command="{Binding BrowseGameCommand}"
									Margin="8 0 0 0"
									Padding="12 8"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Storage Directory Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="存储目录"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Text="用于存放添加到模组管理器中的所有模组的目录"
								   Style="{StaticResource FluentBodyText}"
								   Margin="0 4 0 4"/>
						<TextBlock Text="修改此目录前请先清空，因为已安装文件的记录存储在此处!"
								   Foreground="{StaticResource DangerBrush}"
								   FontSize="12"
								   Margin="0 0 0 12"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox Grid.Column="0"
									 Text="{Binding StorageDir, Mode=OneWay}"
									 IsReadOnly="True"
									 VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Content="浏览"
									Style="{StaticResource FluentPrimaryButton}"
									Command="{Binding BrowseStorageCommand}"
									Margin="8 0 0 0"
									Padding="12 8"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Temp Directory Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="临时目录"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
							<Run Text="用于存放临时文件的目录，例如："/>
							<LineBreak/>
							<Run Text="- 下载文件"/>
							<LineBreak/>
							<Run Text="- 部署Mod期间的文件"/>
							<LineBreak/>
							<Run Text="- 解压缩文件"/>
						</TextBlock>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox Grid.Column="0"
									 Text="{Binding TempDir, Mode=OneWay}"
									 IsReadOnly="True"
									 VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Content="浏览"
									Style="{StaticResource FluentPrimaryButton}"
									Command="{Binding BrowseTempCommand}"
									Margin="8 0 0 0"
									Padding="12 8"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Appearance Section -->
				<!-- <Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="外观"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Text="更改窗口背景的不透明度"
								   Style="{StaticResource FluentBodyText}"
								   Margin="0 4 0 12"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="200"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Slider Grid.Column="0"
									Minimum="0.5"
									Maximum="1"
									TickFrequency="0.05"
									TickPlacement="BottomRight"
									IsSnapToTickEnabled="True"
									Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Grid.Column="1"
									   Text="{Binding Opacity, StringFormat=P0}"
									   FontSize="14"
									   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
									   VerticalAlignment="Center"
									   Margin="16 0 0 0"/>
						</Grid>
					</StackPanel>
				</Border> -->

				<!-- Logging Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="日志级别"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
							<Run Text="此项用于设置记录到日志文件的消息级别"/>
							<LineBreak/>
							<Run Text="所选级别及其以下级别的消息都将被捕获并记录"/>
							<LineBreak/>
							<Run Text="默认仅记录警告(Warning)及以上更严重的消息"/>
						</TextBlock>
						<ComboBox HorizontalAlignment="Left"
								  Width="200"
								  ItemsSource="{Binding Source={StaticResource LogLevelEnumData}}"
								  SelectedItem="{Binding LogLevel}"/>
					</StackPanel>
				</Border>

				<!-- Search Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="搜索"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<Grid Margin="0 8 0 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<CheckBox Grid.Column="0"
									  Width="24"
									  Height="24"
									  IsChecked="{Binding CaseSensitiveSearch}"
									  Margin="0 0 12 0"/>
							<TextBlock Grid.Column="1"
									   Text="区分大小写"
									   FontSize="14"
									   Foreground="{StaticResource NeutralForegroundBrush}"
									   VerticalAlignment="Center"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Deployment Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="模组部署方式"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
							<Run Text="使用符号链接来代替文件复制，来降低部署模组期间的硬盘写入"/>
							<LineBreak/>
							<Run Text="需要以管理员权限启动应用" FontWeight="SemiBold"/>
						</TextBlock>
						<Grid Margin="0 8 0 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<CheckBox Grid.Column="0"
									  Width="24"
									  Height="24"
									  IsChecked="{Binding UseSymbolicLinks}"
									  Margin="0 0 12 0"/>
							<TextBlock Grid.Column="1"
									   Text="使用符号链接"
									   FontSize="14"
									   Foreground="{StaticResource NeutralForegroundBrush}"
									   VerticalAlignment="Center"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Delete Options Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
                        <TextBlock Text="删除模组方式"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
                        <Grid Margin="0 8 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
									  Width="24"
									  Height="24"
									  IsChecked="{Binding DeleteToRecycleBin}"
									  Margin="0 0 12 0"/>
                            <TextBlock Grid.Column="1"
									   Text="移动到回收站"
									   FontSize="14"
									   Foreground="{StaticResource NeutralForegroundBrush}"
									   VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
				</Border>

                <!-- Non-existent module handling method -->
                <Border Style="{StaticResource FluentSettingsCard}">
                    <StackPanel>
                        <TextBlock Text="不存在的模组处理方式"
							   Style="{StaticResource FluentSubSectionHeader}"
							   Margin="0"/>
                        <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
							<Run Text="默认是自动跳过, 不存在的模组条目"/>
                        </TextBlock>
                        <Grid Margin="0 8 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
								  Width="24"
								  Height="24"
								  IsChecked="{Binding AutoRemoveMissingMods}"
								  Margin="0 0 12 0"/>
                            <TextBlock Grid.Column="1"
								   Text="自动删除不存在的模组条目"
								   FontSize="14"
								   Foreground="{StaticResource NeutralForegroundBrush}"
								   VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sort Settings -->
                <Border Style="{StaticResource FluentSettingsCard}">
                    <StackPanel>
                        <TextBlock Text="排序"
                                   Style="{StaticResource FluentSubSectionHeader}"
                                   Margin="0"/>
                        <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                            <Run Text="启用后可在模组列表顶部选择排序方式"/>
                        </TextBlock>
                        <Grid Margin="0 8 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Width="24"
                                      Height="24"
                                      IsChecked="{Binding EnableSorting}"
                                      Margin="0 0 12 0"/>
                            <TextBlock Grid.Column="1"
                                       Text="启用排序"
                                       FontSize="14"
                                       Foreground="{StaticResource NeutralForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Developer Options Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="开发者选项"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"
								   TextDecorations="Underline"/>
						<TextBlock Text="跳过列表"
								   FontSize="16"
								   FontWeight="SemiBold"
								   Foreground="{StaticResource NeutralForegroundBrush}"
								   Margin="0 12 0 4"/>
						<TextBlock Text="这将在Mod应用期间跳过所有指定文件的第 0 个索引"
								   Style="{StaticResource FluentBodyText}"
								   Margin="0 0 0 12"/>
						<ListBox Width="400"
								 MinHeight="100"
								 MaxHeight="200"
								 ItemsSource="{Binding SkipList}"
								 HorizontalAlignment="Left"
								 SelectedIndex="{Binding SelectedSkip}">
							<ListBox.ItemTemplate>
								<DataTemplate DataType="{x:Type sys:String}">
									<TextBlock Text="{Binding}"
											   FontFamily="Consolas"
											   FontSize="13"
											   Foreground="{StaticResource NeutralForegroundBrush}"/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<StackPanel Orientation="Horizontal" Margin="0 8 0 0">
							<Button Command="{Binding AddSkipCommand}"
									Style="{StaticResource FluentSecondaryButton}"
									Padding="12 6">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
									<TextBlock Text="添加" Margin="8 0 0 0" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button Command="{Binding RemoveSkipCommand}"
									Style="{StaticResource FluentDangerButton}"
									Padding="12 6">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
									<TextBlock Text="删除" Margin="8 0 0 0" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Browser Extension Connection Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="浏览器扩展连接"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Text="配置浏览器扩展连接到管理器所需的地址和端口"
								   Style="{StaticResource FluentBodyText}"
								   Margin="0 4 0 12"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="200"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="100"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0" Grid.Column="0"
									   Text="地址:"
									   VerticalAlignment="Center"
									   Margin="0 0 8 8"
									   FontSize="14"
									   Foreground="{StaticResource NeutralForegroundBrush}"/>
							<TextBox Grid.Row="0" Grid.Column="1"
									 Text="{Binding ExtensionHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 Style="{StaticResource FluentTextBox}"
									 Margin="0 0 16 8"/>
							<TextBlock Grid.Row="0" Grid.Column="2"
									   Text="端口:"
									   VerticalAlignment="Center"
									   Margin="0 0 8 8"
									   FontSize="14"
									   Foreground="{StaticResource NeutralForegroundBrush}"/>
							<TextBox Grid.Row="0" Grid.Column="3"
									 Text="{Binding ExtensionPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 Style="{StaticResource FluentTextBox}"
									 Margin="0 0 0 8"/>
						</Grid>
						<TextBlock FontSize="12"
								   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
								   Margin="0 4 0 0">
							<Run Text="连接地址: http://"/>
							<Run Text="{Binding ExtensionHost, Mode=OneWay}"/>
							<Run Text=":"/>
							<Run Text="{Binding ExtensionPort, Mode=OneWay}"/>
							<Run Text="/"/>
						</TextBlock>
					</StackPanel>
				</Border>

				<!-- Nexus Mods API Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="Nexus Mods API"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<TextBlock Text="用于从 Nexus Mods 获取模组信息和更新检测"
								   Style="{StaticResource FluentBodyText}"
								   Margin="0 4 0 12"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<PasswordBox x:Name="NexusApiKeyPasswordBox"
										Grid.Column="0"
										Style="{StaticResource FluentPasswordBox}"
										VerticalAlignment="Center"
										PasswordChanged="NexusApiKeyPasswordBox_PasswordChanged"/>
							<Button Grid.Column="1"
									Content="验证"
									Style="{StaticResource FluentPrimaryButton}"
									Command="{Binding ValidateNexusApiKeyCommand}"
									Margin="8 0 0 0"
									Padding="12 8"/>
						</Grid>
						<TextBlock x:Name="NexusApiKeyValidationResult"
								   Text="{Binding NexusApiKeyValidationResult}"
								   FontSize="12"
								   Margin="0 8 0 0">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Foreground" Value="{StaticResource NeutralForegroundSecondaryBrush}"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding NexusApiKeyValidationResult}" Value="API Key 验证成功!">
											<Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding NexusApiKeyValidationResult}" Value="API Key 不能为空">
											<Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding NexusApiKeyValidationResult, Converter={StaticResource ContainsConverter}, ConverterParameter=验证失败}">
											<Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
				</Border>

				<!-- Reset Section -->
				<Border Style="{StaticResource FluentSettingsCard}">
					<StackPanel>
						<TextBlock Text="实用工具"
								   Style="{StaticResource FluentSubSectionHeader}"
								   Margin="0"/>
						<Button Content="重置所有设置"
								Style="{StaticResource FluentDangerButton}"
								Command="{Binding ResetCommand}"
								HorizontalAlignment="Left"
								Padding="16 10"
								Margin="0 8 0 4"/>
						<TextBlock Text="这会将所有设置重置为默认值！"
								   Foreground="{StaticResource WarningBrush}"
								   FontSize="12"
								   Margin="0 4 0 0"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!-- Footer -->
		<Border Grid.Row="2"
				Style="{StaticResource FluentCard}"
				CornerRadius="8">
			<Button Content="确定"
					Style="{StaticResource FluentPrimaryButton}"
					Command="{Binding OkCommand}"
					HorizontalAlignment="Right"
					Padding="24 10"/>
		</Border>
	</Grid>
</Page>