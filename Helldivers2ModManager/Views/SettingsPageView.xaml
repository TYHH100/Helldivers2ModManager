<Page x:Class="Helldivers2ModManager.Views.SettingsPageView"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:logging="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
      xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vms:SettingsPageViewModel}"
      d:Background="{StaticResource MicaBackgroundBrush}"
      d:DesignWidth="1000"
      d:DesignHeight="700"
      Title="{Binding Title}">
    <Page.Resources>
        <ObjectDataProvider x:Key="LogLevelEnumData"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="logging:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{loc:Loc DashboardPage.Settings}"
                   Style="{StaticResource FluentSectionHeader}"
                   Margin="0 0 0 12"/>

        <!-- ============================================ -->
        <!-- Tab Bar                                      -->
        <!-- ============================================ -->
        <Border Grid.Row="1"
                Background="{StaticResource LayerBackgroundBrush}"
                BorderBrush="{StaticResource NeutralStrokeBrush}"
                BorderThickness="1"
                CornerRadius="6 6 0 0"
                Padding="4 2 0 0"
                Margin="0 0 0 0">
            <StackPanel Orientation="Horizontal">
                <!-- 路径 选项卡 -->
                <Button Content="{loc:Loc SettingsPage.TabPaths}"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 部署 选项卡 -->
                <Button Content="{loc:Loc SettingsPage.TabDeploy}"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 模组 选项卡 -->
                <Button Content="{loc:Loc SettingsPage.TabMods}"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 日志 选项卡 -->
                <Button Content="{loc:Loc SettingsPage.TabLogs}"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 连接 选项卡 -->
                <Button Content="{loc:Loc SettingsPage.TabConnection}"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 工具 选项卡 -->
                <Button Content="{loc:Loc SettingsPage.TabTools}"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 主页 选项卡 -->
                <Button Content="{loc:Loc SettingsPage.TabHome}"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="6">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- Tab Content Area                             -->
        <!-- ============================================ -->
        <Border Grid.Row="2"
                Background="{StaticResource LayerBackgroundBrush}"
                BorderBrush="{StaticResource NeutralStrokeBrush}"
                BorderThickness="1 0 1 1"
                CornerRadius="0 0 6 6"
                Padding="4"
                Margin="0 0 0 16">
            <ScrollViewer Style="{StaticResource FluentScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          Margin="4">
                <StackPanel>

                <!-- Tab 0: 路径 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 游戏目录 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.GameDir}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="{loc:Loc SettingsPage.GameDirDesc}"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding GameDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc SettingsPage.AutoDetect}"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Command="{Binding DetectGameCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                    <Button Grid.Column="2"
                                            Content="{loc:Loc SettingsPage.Browse}"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding BrowseGameCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 存储目录 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.StorageDir}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="{loc:Loc SettingsPage.StorageDirDesc}"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 4"/>
                                <TextBlock Text="{loc:Loc SettingsPage.StorageDirWarning}"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="12"
                                           Margin="0 0 0 12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding StorageDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc SettingsPage.Browse}"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding BrowseStorageCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 临时目录 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.TempDir}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.TempDirDesc1}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Loc SettingsPage.TempDirDesc2}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Loc SettingsPage.TempDirDesc3}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Loc SettingsPage.TempDirDesc4}"/>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding TempDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc SettingsPage.Browse}"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding BrowseTempCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 归类文件夹列表 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.OrgFolders}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="{loc:Loc SettingsPage.OrgFoldersDesc}"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 0 0 12"/>
                                <ListBox Width="400"
                                         MinHeight="80"
                                         MaxHeight="150"
                                         ItemsSource="{Binding OrganizationalFolderNames}"
                                         HorizontalAlignment="Left"
                                         SelectedIndex="{Binding SelectedOrgFolder}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       Foreground="{StaticResource NeutralForegroundBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                    <Button Command="{Binding AddOrgFolderCommand}"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc SettingsPage.Add}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RemoveOrgFolderCommand}"
                                            Style="{StaticResource FluentDangerButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Common.Delete}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 1: 部署 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 模组部署方式 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.DeployMethod}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.SymLinkDesc1}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Loc SettingsPage.SymLinkDesc2}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding UseSymbolicLinks}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc SettingsPage.UseSymLinks}"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{loc:Loc SettingsPage.DeployOrder}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0 12 0 4"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 8">
                                    <Run Text="{loc:Loc SettingsPage.DeployOrderDesc}"/>
                                </TextBlock>
                                <RadioButton Content="{loc:Loc SettingsPage.DeployTopToBottom}"
                                             IsChecked="{Binding DeployBottomToTop, Converter={StaticResource InverseBoolConverter}}"
                                             FontSize="14"
                                             Foreground="{StaticResource NeutralForegroundBrush}"
                                             Margin="0 2 0 2"
                                             GroupName="DeployOrder"
                                             Style="{StaticResource FluentRadioButton}"/>
                                <RadioButton Content="{loc:Loc SettingsPage.DeployBottomToTop}"
                                             IsChecked="{Binding DeployBottomToTop}"
                                             FontSize="14"
                                             Foreground="{StaticResource NeutralForegroundBrush}"
                                             Margin="0 2 0 2"
                                             GroupName="DeployOrder"
                                             Style="{StaticResource FluentRadioButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- 自定义部署顺序 -->
                        <Border Style="{StaticResource FluentSettingsCard}" Margin="0 12 0 0">
                            <StackPanel>
                                <Grid Margin="0 0 0 8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding UseDeploymentOrder}"
                                              Margin="0 0 12 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc SettingsPage.CustomDeployOrder}"
                                                   Style="{StaticResource FluentSubSectionHeader}"
                                                   Margin="0"/>
                                        <TextBlock Text="{loc:Loc SettingsPage.CustomDeployOrderDesc}"
                                                   Style="{StaticResource FluentBodyText}"
                                                   Margin="0 2 0 0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{loc:Loc SettingsPage.CustomDeployOrderHint}"
                                           Visibility="{Binding UseDeploymentOrder, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Style="{StaticResource FluentBodyText}"
                                           Foreground="{StaticResource NeutralForegroundTertiaryBrush}"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                                </Border>

                        <!-- 跳过列表（开发者选项） -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.SkipList}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="{loc:Loc SettingsPage.SkipListDesc}"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 0 0 12"/>
                                <ListBox Width="400"
                                         MinHeight="100"
                                         MaxHeight="200"
                                         ItemsSource="{Binding SkipList}"
                                         HorizontalAlignment="Left"
                                         SelectedIndex="{Binding SelectedSkip}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       Foreground="{StaticResource NeutralForegroundBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                    <Button Command="{Binding AddSkipCommand}"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc SettingsPage.Add}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RemoveSkipCommand}"
                                            Style="{StaticResource FluentDangerButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Common.Delete}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 2: 模组 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 删除模组方式 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.DeleteMethod}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding DeleteToRecycleBin}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc SettingsPage.MoveToRecycleBin}"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 不存在的模组处理方式 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.MissingMods}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.MissingModsDesc}"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding AutoRemoveMissingMods}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc SettingsPage.AutoRemoveMissing}"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 版本兼容性检查 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.VersionCheck}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.VersionCheckDesc}"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding AutoCheckVersionOnStartup}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc SettingsPage.AutoCheckOnStartup}"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0 12 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding EnableBatchRepair}"
                                              Margin="0 0 12 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc SettingsPage.EnableBatchRepair}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource NeutralForegroundBrush}"/>
                                        <TextBlock Text="{loc:Loc SettingsPage.EnableBatchRepairDesc}"
                                                   Style="{StaticResource FluentBodyText}"
                                                   Margin="0 2 0 0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 3: 日志 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 日志级别 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.LogLevel}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.LogLevelDesc1}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Loc SettingsPage.LogLevelDesc2}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Loc SettingsPage.LogLevelDesc3}"/>
                                </TextBlock>
                                <ComboBox HorizontalAlignment="Left"
                                          Width="200"
                                          ItemsSource="{Binding Source={StaticResource LogLevelEnumData}}"
                                          SelectedItem="{Binding LogLevel}"/>
                            </StackPanel>
                        </Border>

                        <!-- 日志自动清理 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.LogAutoClean}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.LogAutoCleanDesc}"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding AutoCleanLogs}"
                                              Margin="0 0 12 0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                             Width="60"
                                             VerticalAlignment="Center"
                                             Margin="0 0 8 0"/>
                                    <TextBlock Grid.Column="2"
                                           Text="{loc:Loc SettingsPage.LogAutoCleanDays}"
                                           FontSize="14"
                                           Foreground="{StaticResource NeutralForegroundBrush}"
                                           VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 4: 连接 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- Nexus Mods API Key（预留位置，后续功能启用） -->
                        <!-- <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Nexus Mods API"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="用于从 Nexus Mods 获取模组信息和更新检测"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="NexusApiKeyPasswordBox"
                                                Grid.Column="0"
                                                Style="{StaticResource FluentPasswordBox}"
                                                VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="验证"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding ValidateNexusApiKeyCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border> -->
                    </StackPanel>
                </Grid>

                <!-- Tab 5: 工具 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.Tools}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="{loc:Loc SettingsPage.ToolsDesc}"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 12"/>

                                <!-- 重新计算文件指纹 -->
                                <Button Content="{loc:Loc SettingsPage.RecomputeHashes}"
                                        Style="{StaticResource FluentSecondaryButton}"
                                        Command="{Binding RecomputeAllHashesCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16 10"
                                        Margin="0 0 0 4"/>
                                <TextBlock Text="{loc:Loc SettingsPage.RecomputeHashesDesc}"
                                           Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0 0 0 16"/>

                                <!-- 强制清理补丁文件 -->
                                <Button Content="{loc:Loc SettingsPage.ForceCleanPatches}"
                                        Style="{StaticResource FluentSecondaryButton}"
                                        Command="{Binding HardPurgeCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16 10"
                                        Margin="0 0 0 4"/>
                                <TextBlock Text="{loc:Loc SettingsPage.ForceCleanPatchesDesc}"
                                           Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0 0 0 16"/>

                                <Border Style="{StaticResource FluentDivider}" Margin="0 4"/>

                                <!-- 重置所有设置 -->
                                <Button Content="{loc:Loc SettingsPage.ResetSettings}"
                                        Style="{StaticResource FluentDangerButton}"
                                        Command="{Binding ResetCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16 10"
                                        Margin="0 8 0 4"/>
                                <TextBlock Text="{loc:Loc SettingsPage.ResetSettingsWarning}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <!-- Tab 6: 主页 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 分隔符 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.Separators}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.SeparatorsDesc}"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding ShowSeparator}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc SettingsPage.EnableSeparators}"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 排序 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.Sorting}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.SortingDesc}"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding EnableSorting}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc SettingsPage.EnableSorting}"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 搜索 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.Search}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding CaseSensitiveSearch}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc SettingsPage.CaseSensitive}"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 界面语言 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage.Language}"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="{loc:Loc SettingsPage.LanguageDesc}"/>
                                </TextBlock>
                                <ComboBox HorizontalAlignment="Left"
                                          Width="200"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedValue="{Binding SelectedLanguageCode}"
                                          SelectedValuePath="LocaleCode"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0 8 0 0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Style="{StaticResource FluentCard}"
                CornerRadius="8">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FooterButton"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FooterButton"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{loc:Loc Common.Cancel}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Padding="24 10"/>
                <Button Grid.Column="2"
                        Content="{loc:Loc Common.OK}"
                        Style="{StaticResource FluentPrimaryButton}"
                        Command="{Binding OkCommand}"
                        Padding="24 10"/>
            </Grid>
        </Border>
    </Grid>
</Page>
