<Page x:Class="Helldivers2ModManager.Views.SettingsPageView"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:logging="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vms:SettingsPageViewModel}"
      d:Background="{StaticResource MicaBackgroundBrush}"
      d:DesignWidth="1000"
      d:DesignHeight="700"
      Title="{Binding Title}">
    <Page.Resources>
        <ObjectDataProvider x:Key="LogLevelEnumData"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="logging:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="设置"
                   Style="{StaticResource FluentSectionHeader}"
                   Margin="0 0 0 12"/>

        <!-- ============================================ -->
        <!-- Tab Bar                                      -->
        <!-- ============================================ -->
        <Border Grid.Row="1"
                Background="{StaticResource LayerBackgroundBrush}"
                BorderBrush="{StaticResource NeutralStrokeBrush}"
                BorderThickness="1"
                CornerRadius="6 6 0 0"
                Padding="4 2 0 0"
                Margin="0 0 0 0">
            <StackPanel Orientation="Horizontal">
                <!-- 路径 选项卡 -->
                <Button Content="路径"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 部署 选项卡 -->
                <Button Content="部署"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 模组 选项卡 -->
                <Button Content="模组"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 日志 选项卡 -->
                <Button Content="日志"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 连接 选项卡 -->
                <Button Content="连接"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 工具 选项卡 -->
                <Button Content="工具"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentSettingsTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- Tab Content Area                             -->
        <!-- ============================================ -->
        <Border Grid.Row="2"
                Background="{StaticResource LayerBackgroundBrush}"
                BorderBrush="{StaticResource NeutralStrokeBrush}"
                BorderThickness="1 0 1 1"
                CornerRadius="0 0 6 6"
                Padding="4"
                Margin="0 0 0 16">
            <ScrollViewer Style="{StaticResource FluentScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          Margin="4">
                <StackPanel>

                <!-- Tab 0: 路径 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 游戏目录 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="游戏目录"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="您想要安装模组的游戏目录"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding GameDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="自动检测"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Command="{Binding DetectGameCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                    <Button Grid.Column="2"
                                            Content="浏览"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding BrowseGameCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 存储目录 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="存储目录"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="用于存放添加到模组管理器中的所有模组的目录"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 4"/>
                                <TextBlock Text="修改此目录前请先清空，因为已安装文件的记录存储在此处!"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="12"
                                           Margin="0 0 0 12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding StorageDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="浏览"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding BrowseStorageCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 临时目录 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="临时目录"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="用于存放临时文件的目录，例如："/>
                                    <LineBreak/>
                                    <Run Text="- 下载文件"/>
                                    <LineBreak/>
                                    <Run Text="- 部署Mod期间的文件"/>
                                    <LineBreak/>
                                    <Run Text="- 解压缩文件"/>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding TempDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="浏览"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding BrowseTempCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 归类文件夹列表 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="归类文件夹"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="创建 Mod 时这些文件夹的子目录将被提升为选项。默认包含 Models。"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 0 0 12"/>
                                <ListBox Width="400"
                                         MinHeight="80"
                                         MaxHeight="150"
                                         ItemsSource="{Binding OrganizationalFolderNames}"
                                         HorizontalAlignment="Left"
                                         SelectedIndex="{Binding SelectedOrgFolder}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       Foreground="{StaticResource NeutralForegroundBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                    <Button Command="{Binding AddOrgFolderCommand}"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="添加" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RemoveOrgFolderCommand}"
                                            Style="{StaticResource FluentDangerButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="删除" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 1: 部署 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 模组部署方式 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="模组部署方式"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="使用符号链接来代替文件复制，来降低部署模组期间的硬盘写入"/>
                                    <LineBreak/>
                                    <Run Text="需要以管理员权限启动应用" FontWeight="SemiBold"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding UseSymbolicLinks}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="使用符号链接"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="模组部署顺序"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0 12 0 4"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 8">
                                    <Run Text="选择部署模组时的文件排列顺序"/>
                                </TextBlock>
                                <RadioButton Content="从上到下"
                                             IsChecked="{Binding DeployBottomToTop, Converter={StaticResource InverseBoolConverter}}"
                                             FontSize="14"
                                             Foreground="{StaticResource NeutralForegroundBrush}"
                                             Margin="0 2 0 2"
                                             GroupName="DeployOrder"
                                             Style="{StaticResource FluentRadioButton}"/>
                                <RadioButton Content="从下到上"
                                             IsChecked="{Binding DeployBottomToTop}"
                                             FontSize="14"
                                             Foreground="{StaticResource NeutralForegroundBrush}"
                                             Margin="0 2 0 2"
                                             GroupName="DeployOrder"
                                             Style="{StaticResource FluentRadioButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- 跳过列表（开发者选项） -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="跳过列表"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="这将在Mod应用期间跳过所有指定文件的第 0 个索引"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 0 0 12"/>
                                <ListBox Width="400"
                                         MinHeight="100"
                                         MaxHeight="200"
                                         ItemsSource="{Binding SkipList}"
                                         HorizontalAlignment="Left"
                                         SelectedIndex="{Binding SelectedSkip}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       Foreground="{StaticResource NeutralForegroundBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                    <Button Command="{Binding AddSkipCommand}"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="添加" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RemoveSkipCommand}"
                                            Style="{StaticResource FluentDangerButton}"
                                            Padding="12 6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                                            <TextBlock Text="删除" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 2: 模组 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 删除模组方式 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="删除模组方式"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding DeleteToRecycleBin}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="移动到回收站"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 不存在的模组处理方式 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="不存在的模组处理方式"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="默认是自动跳过不存在的模组条目"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding AutoRemoveMissingMods}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="自动删除不存在的模组条目"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 排序 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="排序"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="启用后可在模组列表顶部选择排序方式"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding EnableSorting}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="启用排序"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 搜索 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="搜索"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding CaseSensitiveSearch}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="区分大小写"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 版本兼容性检查 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="版本兼容性检查"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="启动时自动检查模组的版本兼容性，以多数模组的 Unit 版本为参考标记可能存在兼容性问题的模组"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding AutoCheckVersionOnStartup}"
                                              Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="启动时自动检查"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 3: 日志 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 日志级别 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="日志级别"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="此项用于设置记录到日志文件的消息级别"/>
                                    <LineBreak/>
                                    <Run Text="所选级别及其以下级别的消息都将被捕获并记录"/>
                                    <LineBreak/>
                                    <Run Text="默认仅记录警告(Warning)及以上更严重的消息"/>
                                </TextBlock>
                                <ComboBox HorizontalAlignment="Left"
                                          Width="200"
                                          ItemsSource="{Binding Source={StaticResource LogLevelEnumData}}"
                                          SelectedItem="{Binding LogLevel}"/>
                            </StackPanel>
                        </Border>

                        <!-- 日志自动清理 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="日志自动清理"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Style="{StaticResource FluentBodyText}" Margin="0 4 0 4">
                                    <Run Text="自动删除超过指定天数的日志文件，避免占用过多磁盘空间"/>
                                </TextBlock>
                                <Grid Margin="0 8 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              IsChecked="{Binding AutoCleanLogs}"
                                              Margin="0 0 12 0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                             Width="60"
                                             VerticalAlignment="Center"
                                             Margin="0 0 8 0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="天后自动删除"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 4: 连接 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <!-- 浏览器扩展连接 -->
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="浏览器扩展连接"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="配置浏览器扩展连接到管理器所需的地址和端口"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="地址:"
                                               VerticalAlignment="Center"
                                               Margin="0 0 8 8"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding ExtensionHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FluentTextBox}"
                                             Margin="0 0 16 8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="端口:"
                                               VerticalAlignment="Center"
                                               Margin="0 0 8 8"
                                               FontSize="14"
                                               Foreground="{StaticResource NeutralForegroundBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="3"
                                             Text="{Binding ExtensionPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FluentTextBox}"
                                             Margin="0 0 0 8"/>
                                </Grid>
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                           Margin="0 4 0 0">
                                    <Run Text="连接地址: http://"/>
                                    <Run Text="{Binding ExtensionHost, Mode=OneWay}"/>
                                    <Run Text=":"/>
                                    <Run Text="{Binding ExtensionPort, Mode=OneWay}"/>
                                    <Run Text="/"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Nexus Mods API Key（预留位置，后续功能启用） -->
                        <!-- <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Nexus Mods API"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="用于从 Nexus Mods 获取模组信息和更新检测"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="NexusApiKeyPasswordBox"
                                                Grid.Column="0"
                                                Style="{StaticResource FluentPasswordBox}"
                                                VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="验证"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Command="{Binding ValidateNexusApiKeyCommand}"
                                            Margin="8 0 0 0"
                                            Padding="12 8"/>
                                </Grid>
                            </StackPanel>
                        </Border> -->
                    </StackPanel>
                </Grid>

                <!-- Tab 5: 工具 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <Border Style="{StaticResource FluentSettingsCard}">
                            <StackPanel>
                                <TextBlock Text="实用工具"
                                           Style="{StaticResource FluentSubSectionHeader}"
                                           Margin="0"/>
                                <TextBlock Text="在出现异常情况时可使用以下工具进行修复"
                                           Style="{StaticResource FluentBodyText}"
                                           Margin="0 4 0 12"/>

                                <!-- 重新计算文件指纹 -->
                                <Button Content="重新计算文件指纹"
                                        Style="{StaticResource FluentSecondaryButton}"
                                        Command="{Binding RecomputeAllHashesCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16 10"
                                        Margin="0 0 0 4"/>
                                <TextBlock Text="重新计算所有模组的 SHA-256 文件哈希值并更新数据库缓存"
                                           Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0 0 0 16"/>

                                <!-- 强制清理补丁文件 -->
                                <Button Content="强制清理补丁文件"
                                        Style="{StaticResource FluentSecondaryButton}"
                                        Command="{Binding HardPurgeCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16 10"
                                        Margin="0 0 0 4"/>
                                <TextBlock Text="删除游戏 data 目录下所有 .patch_* 补丁文件及 installed.txt 记录"
                                           Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0 0 0 16"/>

                                <Border Style="{StaticResource FluentDivider}" Margin="0 4"/>

                                <!-- 重置所有设置 -->
                                <Button Content="重置所有设置"
                                        Style="{StaticResource FluentDangerButton}"
                                        Command="{Binding ResetCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16 10"
                                        Margin="0 8 0 4"/>
                                <TextBlock Text="这会将所有设置重置为默认值！"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Style="{StaticResource FluentCard}"
                CornerRadius="8">
            <Button Content="确定"
                    Style="{StaticResource FluentPrimaryButton}"
                    Command="{Binding OkCommand}"
                    HorizontalAlignment="Right"
                    Padding="24 10"/>
        </Border>
    </Grid>
</Page>
