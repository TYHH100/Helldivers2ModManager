<UserControl x:Class="Helldivers2ModManager.Views.PatchResourceViewerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
             xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vms:PatchResourceViewerPageViewModel}"
             d:DesignHeight="620"
             d:DesignWidth="960">
    <UserControl.Resources>
        <Style x:Key="PatchViewerDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeutralStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="Padding" Value="7 5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PatchViewerDataGridRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource FluentColumnHeadersOnlyDataGridRow}">
            <Setter Property="Background" Value="{StaticResource NeutralBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeutralStrokeBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SystemAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PatchViewerDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeutralStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="0 0 1 0"/>
            <Setter Property="Padding" Value="6 3"/>
        </Style>
        <Style x:Key="PatchViewerTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12 7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0 0 0 2" Margin="0 0 4 0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PatchViewerChannelButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChannelBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource NeutralStrokeBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChannelBorder" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChannelBorder" Property="Background" Value="{StaticResource SystemAccentBrush}"/>
                                <Setter TargetName="ChannelBorder" Property="BorderBrush" Value="{StaticResource SystemAccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0 0 0 14" BorderBrush="{StaticResource NeutralStrokeBrush}" BorderThickness="0 0 0 1">
            <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding GoBackCommand}" Style="{StaticResource FluentIconButton}" Width="36" Margin="0 0 10 0" ToolTip="{loc:Loc Common.Back}">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Loc PatchResourceViewerPage.Title}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc PatchResourceViewerPage.Description}" Margin="0 3 0 0" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding RefreshModsCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource FluentSecondaryButton}" Padding="12 7">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0 0 7 0"/><TextBlock Text="{loc:Loc ModelPreviewPage.Refresh}"/></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="175"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FluentSettingsCard}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ModelPreviewPage.Mods}" FontWeight="SemiBold" Margin="14 12 14 8"/>
                    <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="12 8">
                                    <TextBlock Text="{Binding Manifest.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Directory.Name}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0 2 0 0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding StatusText}" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0 0 0 8"/>

                <Border Grid.Row="1" Style="{StaticResource FluentSettingsCard}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc PatchResourceViewerPage.Toc}" FontWeight="SemiBold" Margin="2 0 0 8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TocEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11" Background="{StaticResource NeutralBackgroundBrush}" Foreground="{StaticResource NeutralForegroundBrush}" BorderBrush="{StaticResource NeutralStrokeBrush}" HorizontalGridLinesBrush="{StaticResource NeutralStrokeBrush}" VerticalGridLinesBrush="{StaticResource NeutralStrokeBrush}" ColumnHeaderStyle="{StaticResource PatchViewerDataGridHeaderStyle}" RowStyle="{StaticResource PatchViewerDataGridRowStyle}" CellStyle="{StaticResource PatchViewerDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding EntryIndex}" Width="42"/>
                                <DataGridTextColumn Header="Patch" Binding="{Binding PatchFile}" Width="*"/>
                                <DataGridTextColumn Header="File ID" Binding="{Binding FileIdText}" Width="145"/>
                                <DataGridTextColumn Header="Type ID" Binding="{Binding TypeIdText}" Width="145"/>
                                <DataGridTextColumn Header="Main" Binding="{Binding MainRangeText}" Width="125"/>
                                <DataGridTextColumn Header="GPU" Binding="{Binding GpuRangeText}" Width="125"/>
                                <DataGridTextColumn Header="Stream" Binding="{Binding StreamRangeText}" Width="125"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource FluentSettingsCard}" Padding="10">
                    <TabControl Background="{StaticResource NeutralBackgroundBrush}" Foreground="{StaticResource NeutralForegroundBrush}" BorderBrush="{StaticResource NeutralStrokeBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource PatchViewerTabItemStyle}">
                        <TabItem Header="{loc:Loc PatchResourceViewerPage.GpuStreams}">
                            <DataGrid ItemsSource="{Binding GpuStreams}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11" Margin="0 8 0 0" Background="{StaticResource NeutralBackgroundBrush}" Foreground="{StaticResource NeutralForegroundBrush}" BorderBrush="{StaticResource NeutralStrokeBrush}" HorizontalGridLinesBrush="{StaticResource NeutralStrokeBrush}" VerticalGridLinesBrush="{StaticResource NeutralStrokeBrush}" ColumnHeaderStyle="{StaticResource PatchViewerDataGridHeaderStyle}" RowStyle="{StaticResource PatchViewerDataGridRowStyle}" CellStyle="{StaticResource PatchViewerDataGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Patch" Binding="{Binding PatchFile}" Width="*"/>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitIdText}" Width="145"/>
                                    <DataGridTextColumn Header="Stream" Binding="{Binding StreamIndex}" Width="55"/>
                                    <DataGridTextColumn Header="Vertices" Binding="{Binding VertexCount}" Width="70"/>
                                    <DataGridTextColumn Header="Stride" Binding="{Binding VertexStride}" Width="58"/>
                                    <DataGridTextColumn Header="Indices" Binding="{Binding IndexCount}" Width="70"/>
                                    <DataGridTextColumn Header="Components" Binding="{Binding Components}" Width="260"/>
                                    <DataGridTextColumn Header="Vertex sample" Binding="{Binding VertexSample}" Width="175"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{loc:Loc PatchResourceViewerPage.Textures}">
                            <Grid Margin="0 8 0 0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture}" Background="{StaticResource NeutralBackgroundBrush}" BorderBrush="{StaticResource NeutralStrokeBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="7 5">
                                                <TextBlock Text="{Binding TextureIdText}" FontFamily="Consolas" FontSize="11"/>
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FormatText}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Column="2" Background="{StaticResource NeutralBackgroundBrush}" BorderBrush="{StaticResource NeutralStrokeBrush}" BorderThickness="1" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Margin="0 0 0 8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TexturePreviewStatus}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10 0 0 0">
                                                <RadioButton Content="RGB" GroupName="TextureChannel" IsChecked="{Binding IsRgbChannel, Mode=OneWay}" Command="{Binding SetTextureChannelCommand}" CommandParameter="Rgb" Style="{StaticResource PatchViewerChannelButtonStyle}"/>
                                                <RadioButton Content="RGBA" GroupName="TextureChannel" IsChecked="{Binding IsRgbaChannel, Mode=OneWay}" Command="{Binding SetTextureChannelCommand}" CommandParameter="Rgba" Style="{StaticResource PatchViewerChannelButtonStyle}" Margin="4 0 0 0"/>
                                                <RadioButton Content="A" GroupName="TextureChannel" IsChecked="{Binding IsAlphaChannel, Mode=OneWay}" Command="{Binding SetTextureChannelCommand}" CommandParameter="Alpha" Style="{StaticResource PatchViewerChannelButtonStyle}" Margin="4 0 0 0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Image Grid.Row="1" Source="{Binding TexturePreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" MouseLeftButtonUp="PreviewImage_OnMouseLeftButtonUp"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
        </Grid>

        <Grid x:Name="TextureZoomOverlay" Panel.ZIndex="1000" Visibility="Collapsed" Background="#E6000000" Focusable="True" KeyDown="TextureZoomOverlay_OnKeyDown">
            <Grid Margin="24">
                <Border x:Name="ZoomViewport" Background="#FF101010" BorderBrush="{StaticResource NeutralStrokeBrush}" BorderThickness="1" ClipToBounds="True"
                        PreviewMouseWheel="ZoomViewport_OnPreviewMouseWheel"
                        MouseLeftButtonDown="ZoomViewport_OnMouseLeftButtonDown"
                        MouseLeftButtonUp="ZoomViewport_OnMouseLeftButtonUp"
                        MouseMove="ZoomViewport_OnMouseMove"
                        LostMouseCapture="ZoomViewport_OnLostMouseCapture">
                    <Image x:Name="ZoomImage" Source="{Binding TexturePreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <MatrixTransform x:Name="ZoomTransform"/>
                        </Image.RenderTransform>
                    </Image>
                </Border>

                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="{StaticResource NeutralBackgroundFillSecondaryBrush}" BorderBrush="{StaticResource NeutralStrokeBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FluentIconButton}" Width="34" Height="34" Click="ResetZoom_OnClick" ToolTip="{loc:Loc PatchResourceViewerPage.ResetZoom}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                        </Button>
                        <Button Style="{StaticResource FluentIconButton}" Width="34" Height="34" Margin="4 0 0 0" Click="ClosePreview_OnClick" ToolTip="{loc:Loc PatchResourceViewerPage.ClosePreview}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
