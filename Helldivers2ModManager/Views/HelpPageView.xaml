<Page x:Class="Helldivers2ModManager.Views.HelpPageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:md="https://github.com/whistyun/MdXaml"
	  xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:HelpPageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="800"
	  d:DesignHeight="600"
	  Title="{Binding Title}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Help Content -->
		<Border Grid.Row="0"
				Style="{StaticResource FluentCard}"
				CornerRadius="8"
				Margin="0 0 0 16">
			<md:MarkdownScrollViewer Foreground="{StaticResource NeutralForegroundBrush}"
									 Source="Resources\Text\Help.md"
									 ClickAction="OpenBrowser">
				<md:MarkdownScrollViewer.MarkdownStyle>
					<Style TargetType="FlowDocument"
						   BasedOn="{x:Static md:MarkdownStyle.Sasabune}">
						<Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
						<Style.Resources>
							<Style TargetType="ae:TextArea">
								<Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
							</Style>
						</Style.Resources>
					</Style>
				</md:MarkdownScrollViewer.MarkdownStyle>
			</md:MarkdownScrollViewer>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="1"
				Style="{StaticResource FluentCard}"
				CornerRadius="8">
			<Button Content="返回"
					Style="{StaticResource FluentPrimaryButton}"
					Command="{Binding BackCommand}"
					HorizontalAlignment="Right"
					Padding="24 10"/>
		</Border>
	</Grid>
</Page>