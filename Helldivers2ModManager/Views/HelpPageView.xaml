<Page x:Class="Helldivers2ModManager.Views.HelpPageView"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
      xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vms:HelpPageViewModel}"
      d:Background="{DynamicResource MicaBackgroundBrush}"
      d:DesignWidth="1000"
      d:DesignHeight="700"
      Title="{Binding Title}">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HelpSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource FluentBodyText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 12">
            <TextBlock Text="{loc:Loc HelpPage.Title}" Style="{StaticResource FluentSectionHeader}"/>
            <TextBlock Text="{loc:Loc HelpPage.Introduction}" Style="{StaticResource FluentBodyText}" Margin="0 6 0 0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource FluentCard}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc HelpPage.GettingStartedTitle}" Style="{StaticResource HelpSectionTitle}"/>
                        <TextBlock Text="{loc:Loc HelpPage.GettingStartedBody}" Style="{StaticResource FluentBodyText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FluentCard}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc HelpPage.ImportTitle}" Style="{StaticResource HelpSectionTitle}"/>
                        <TextBlock Text="{loc:Loc HelpPage.ImportBody}" Style="{StaticResource FluentBodyText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FluentCard}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc HelpPage.CompatibilityTitle}" Style="{StaticResource HelpSectionTitle}"/>
                        <TextBlock Text="{loc:Loc HelpPage.CompatibilityBody}" Style="{StaticResource FluentBodyText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FluentCard}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc HelpPage.SafetyTitle}" Style="{StaticResource HelpSectionTitle}"/>
                        <TextBlock Text="{loc:Loc HelpPage.SafetyBody}" Style="{StaticResource FluentBodyText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc HelpPage.SupportTitle}" Style="{StaticResource HelpSectionTitle}"/>
                        <TextBlock Text="{loc:Loc HelpPage.SupportBody}" Style="{StaticResource FluentBodyText}" Margin="0 0 0 10"/>
                        <WrapPanel>
                            <Button Content="{loc:Loc HelpPage.OpenDocumentation}"
                                    Command="{Binding OpenDocumentationCommand}"
                                    Style="{StaticResource FluentPrimaryButton}"
                                    Margin="0 0 8 8"/>
                            <Button Content="{loc:Loc HelpPage.ReportIssue}"
                                    Command="{Binding ReportIssueCommand}"
                                    Style="{StaticResource AutoTextButtonStyle}"
                                    Margin="0 0 0 8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource FluentCard}" Margin="0 12 0 0">
            <Button Content="{loc:Loc Common.Back}"
                    Style="{StaticResource FluentPrimaryButton}"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Right"
                    Padding="24 10"/>
        </Border>
    </Grid>
</Page>
