<Page x:Class="Helldivers2ModManager.Views.AutoTagPairingPageView"
	x:ClassModifier="internal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
	mc:Ignorable="d"
	d:DataContext="{d:DesignInstance vms:AutoTagPairingPageViewModel}"
	d:Background="{StaticResource MicaBackgroundBrush}"
	d:DesignWidth="1000"
	d:DesignHeight="700"
	Title="{Binding Title}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Grid.Row="0"
						Text="{loc:Loc AutoTagPairingPage.Title}"
						Style="{StaticResource FluentSectionHeader}"
						Margin="0 0 0 16"/>

		<!-- Content (scrollable) -->
		<Border Grid.Row="1"
				Style="{StaticResource FluentCard}"
				CornerRadius="8"
				Margin="0 0 0 16">
			<ScrollViewer VerticalScrollBarVisibility="Auto"
						HorizontalScrollBarVisibility="Disabled">
				<StackPanel>
					<TextBlock Text="{loc:Loc AutoTagPairingPage.Desc}"
												Style="{StaticResource FluentBodyText}"
												TextWrapping="Wrap"
												Margin="12 12 12 0"/>
					<ItemsControl ItemsSource="{Binding Items}" Margin="0 4 0 4">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="12 6">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="200"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
																Text="{Binding TypeName}"
																FontSize="14"
																Foreground="{StaticResource NeutralForegroundBrush}"
																VerticalAlignment="Center"/>
									<ComboBox Grid.Column="1"
																ItemsSource="{Binding Options}"
																SelectedItem="{Binding Selected}"
																DisplayMemberPath="Display"
																MaxDropDownHeight="360"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- Bottom action -->
		<Border Grid.Row="2"
				Style="{StaticResource FluentCard}"
				CornerRadius="8"
				Padding="12 8">
			<StackPanel Orientation="Horizontal">
				<Button Command="{Binding BackCommand}"
						Style="{StaticResource FluentSecondaryButton}"
						Padding="16 8"
						Margin="0 0 8 0">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc Common.Back}" Margin="8 0 0 0" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button Command="{Binding SaveCommand}"
						Style="{StaticResource FluentPrimaryButton}"
						Padding="16 8">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
						<TextBlock Text="{loc:Loc AutoTagPairingPage.Save}" Margin="8 0 0 0" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</Page>
