<Application x:Class="Helldivers2ModManager.App"
			 x:ClassModifier="internal"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:Helldivers2ModManager">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources/Styles/DesignTokens.xaml"/>
				<ResourceDictionary Source="Resources/Styles/Theme.Dark.xaml"/>
				<ResourceDictionary Source="Resources/Styles/FluentAnimations.xaml"/>
				<ResourceDictionary Source="Resources/Styles/FluentControls.xaml"/>
				<ResourceDictionary Source="Resources/Styles/FluentWindows.xaml"/>
				<ResourceDictionary Source="Resources/Styles/Typography.xaml"/>
				<ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml"/>
				<ResourceDictionary Source="Resources/Styles/InputStyles.xaml"/>
				<ResourceDictionary Source="Resources/Styles/NavigationStyles.xaml"/>
				<ResourceDictionary Source="Resources/Styles/DialogStyles.xaml"/>
				<ResourceDictionary Source="Resources/Styles/ListStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<local:StringToColorBrushConverter x:Key="StringToColorBrushConverter"/>
			<local:ColorToForegroundConverter x:Key="ColorToForegroundConverter"/>
			<local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
			<local:TagsToStringConverter x:Key="TagsToStringConverter"/>
			<local:BytesToSizeConverter x:Key="BytesConverter"/>
			<local:DownloadStatusToStringConverter x:Key="DownloadStatusToStringConverter"/>
			<local:BackgroundTaskStatusToStringConverter x:Key="BackgroundTaskStatusToStringConverter"/>
			<local:DownloadStatusToVisibilityConverter x:Key="DownloadStatusToVisibilityConverter"/>
			<local:NullToVisibilityConverter x:Key="StringToVisibilityConverter"/>
			<local:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
			<local:SpeedToReadableConverter x:Key="SpeedToReadableConverter"/>
			<local:SortModeConverter x:Key="SortModeConverter"/>
			<local:VersionStatusToColorConverter x:Key="VersionStatusToColorConverter"/>
			<local:VersionStatusToTextConverter x:Key="VersionStatusToTextConverter"/>
			<local:ModLevelToVisibilityConverter x:Key="ModLevelToVisibilityConverter"/>
			<local:ProportionalDoubleConverter x:Key="ProportionalDoubleConverter"/>

			<!-- ============================================ -->
			<!-- Legacy Style Mappings (Backward Compatibility) -->
			<!-- ============================================ -->

			<Style TargetType="TextBlock">
				<Setter Property="SnapsToDevicePixels" Value="True"/>
				<Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
				<Setter Property="Foreground" Value="{DynamicResource NeutralForegroundBrush}"/>
			</Style>

			<Style TargetType="Label">
				<Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
				<Setter Property="Foreground" Value="{DynamicResource NeutralForegroundBrush}"/>
			</Style>

			<!-- System Button (Window Chrome) -->
			<Style x:Key="SystemButton" TargetType="Button" BasedOn="{StaticResource FluentTitleBarButton}">
				<Setter Property="Width" Value="46"/>
				<Setter Property="Height" Value="32"/>
				<Setter Property="Margin" Value="0"/>
			</Style>

			<Style x:Key="CloseSystemButton" TargetType="Button" BasedOn="{StaticResource FluentCloseButton}">
				<Setter Property="Width" Value="46"/>
				<Setter Property="Height" Value="32"/>
				<Setter Property="Margin" Value="0"/>
			</Style>

			<!-- Primary Button -->
			<Style TargetType="Button" BasedOn="{StaticResource FluentButtonBase}"/>

			<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FluentPrimaryButton}"/>

			<Style x:Key="ConfirmButton" TargetType="Button" BasedOn="{StaticResource FluentConfirmButton}"/>

			<Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource FluentDangerButton}"/>

			<Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource FluentDangerButton}"/>

			<!-- TextBox -->
			<Style TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}"/>

			<!-- ComboBox -->
			<Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}"/>
			<Style TargetType="ComboBoxItem" BasedOn="{StaticResource FluentComboBoxItem}"/>

			<!-- CheckBox -->
			<Style TargetType="CheckBox" BasedOn="{StaticResource FluentCheckBox}"/>

			<!-- TreeView -->
			<Style TargetType="TreeView">
				<Setter Property="SnapsToDevicePixels" Value="True"/>
				<Setter Property="Foreground" Value="{DynamicResource NeutralForegroundBrush}"/>
				<Setter Property="Background" Value="{DynamicResource NeutralBackgroundFillBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource NeutralBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
			</Style>

			<Style TargetType="TreeViewItem">
				<Setter Property="Foreground" Value="{DynamicResource NeutralForegroundBrush}"/>
				<Setter Property="FontSize" Value="14"/>
			</Style>

			<!-- ContextMenu -->
			<Style TargetType="ContextMenu">
				<Setter Property="OverridesDefaultStyle" Value="True"/>
				<Setter Property="SnapsToDevicePixels" Value="True"/>
				<Setter Property="Background" Value="{DynamicResource NeutralBackgroundAltBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource NeutralBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Padding" Value="4"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ContextMenu">
							<Border Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="4"
									Effect="{StaticResource ShadowElevationLevel2}"
									Padding="{TemplateBinding Padding}">
								<StackPanel IsItemsHost="True"/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!-- MenuItem -->
			<Style TargetType="MenuItem">
				<Setter Property="OverridesDefaultStyle" Value="True"/>
				<Setter Property="SnapsToDevicePixels" Value="True"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Foreground" Value="{DynamicResource NeutralForegroundBrush}"/>
				<Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
				<Setter Property="FontSize" Value="14"/>
				<Setter Property="Padding" Value="12 8"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="MenuItem">
							<Border x:Name="BackgroundBorder"
									Background="{TemplateBinding Background}"
									Padding="{TemplateBinding Padding}"
									CornerRadius="2">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<ContentPresenter x:Name="Icon"
													  Grid.Column="0"
													  ContentSource="Icon"
													  Margin="0 0 8 0"
													  VerticalAlignment="Center"/>
									<TextBlock x:Name="InputGestureText"
											   Grid.Column="2"
											   Text="{TemplateBinding InputGestureText}"
											   Foreground="{DynamicResource NeutralForegroundTertiaryBrush}"
											   Margin="16 0 0 0"
											   VerticalAlignment="Center"/>
									<Path x:Name="SubMenuArrow"
										  Grid.Column="3"
										  Data="M0,0 L4,4 L0,8"
										  Stroke="{DynamicResource NeutralForegroundBrush}"
										  StrokeThickness="1"
										  VerticalAlignment="Center"
										  Margin="8 0 0 0"
										  Visibility="Collapsed"/>
									<Popup x:Name="SubMenuPopup"
										   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
										   Placement="Right"
										   AllowsTransparency="True"
										   Focusable="False"
										   PopupAnimation="Fade">
										<Border Background="{DynamicResource NeutralBackgroundAltBrush}"
												BorderBrush="{DynamicResource NeutralBorderBrush}"
												BorderThickness="1"
												CornerRadius="4"
												Effect="{StaticResource ShadowElevationLevel3}"
												Padding="4">
											<StackPanel IsItemsHost="True"/>
										</Border>
									</Popup>
									<ContentPresenter Grid.Column="1"
													  ContentSource="Header"
													  VerticalAlignment="Center"/>
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="Role" Value="TopLevelHeader">
									<Setter TargetName="SubMenuPopup" Property="Placement" Value="Bottom"/>
								</Trigger>
								<Trigger Property="Role" Value="SubmenuHeader">
									<Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource NeutralBackgroundFillBrush}"/>
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter Property="Foreground" Value="{DynamicResource NeutralForegroundDisabledBrush}"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!-- ToolTip -->
			<Style TargetType="ToolTip" BasedOn="{StaticResource FluentToolTip}"/>

			<!-- ListBox -->
			<Style TargetType="ListBox" BasedOn="{StaticResource FluentListBox}"/>
			<Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentListBoxItem}"/>

			<!-- Slider -->
			<Style TargetType="Slider" BasedOn="{StaticResource FluentSlider}"/>

			<!-- ScrollBar -->
			<Style TargetType="ScrollBar" BasedOn="{StaticResource FluentScrollBar}"/>

			<!-- ScrollViewer -->
			<Style TargetType="ScrollViewer" BasedOn="{StaticResource FluentScrollViewer}"/>

		</ResourceDictionary>
	</Application.Resources>
</Application>
