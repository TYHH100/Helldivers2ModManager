<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\Helldivers2ModManager\Resources\Images\icon.ico</ApplicationIcon>
    <ProductName>Helldivers 2 Patch Check &amp; Repair Tool</ProductName>
    <ProductVersion>1.0.0</ProductVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Helldivers2ModManager">
      <HintPath>..\Helldivers2ModManager\bin\$(Configuration)\net10.0-windows\win-x64\Helldivers2ModManager.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.18" />
  </ItemGroup>

  <Target Name="BuildSharedPatchCore" BeforeTargets="ResolveAssemblyReferences">
    <!-- VS Publish passes the tool's TargetFramework as a global property. Pin the shared
         manager build to its own net10 target so it never tries to restore as another TFM. -->
    <MSBuild Projects="..\Helldivers2ModManager\Helldivers2ModManager.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows;RuntimeIdentifier=win-x64" />
  </Target>

  <ItemGroup>
    <Content Include="..\Helldivers2ModManager\Resources\Language\*.json">
      <Link>Resources\Language\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
