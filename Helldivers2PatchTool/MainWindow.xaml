<Window x:Class="Helldivers2PatchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HD2 Patch Workshop"
        Width="1180" Height="780" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0C111A" Foreground="#EDF3FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#141D29" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#101823" />
        <SolidColorBrush x:Key="BorderBrush" Color="#26374C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#91A4BA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#49A6FF" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCEBFA" />
            <Setter Property="Background" Value="#1D2B3D" />
            <Setter Property="BorderBrush" Value="#38516D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B405A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#07121F" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="17,7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#78BEFF" />
                    <Setter Property="BorderBrush" Value="#78BEFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#ECF4FE" />
            <Setter Property="Background" Value="#0D1520" />
            <Setter Property="BorderBrush" Value="#31455D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#192638" />
            <Setter Property="Foreground" Value="#AFC2D8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#2C4058" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#203146" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Foreground" Value="#E7EEF8" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#096EBA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#141D29" />
            <Setter Property="Foreground" Value="#E7EEF8" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2A3D" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#096EBA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HD2 PATCH WORKSHOP" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" />
                <TextBlock Text="补丁检测与修复" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,4" />
                <TextBlock Text="独立运行，不依赖任何 Mod 管理器。修复操作会先创建备份。" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="独立工具" Foreground="#86C8FF" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Mod 目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="targetPathBox" Grid.Column="1" ToolTip="选择 Mod 根目录或包含补丁的目录" />
                <Button Grid.Column="2" Content="浏览" Margin="10,0,0,0" Click="BrowseTarget_Click" />

                <TextBlock Grid.Row="2" Text="游戏目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="gamePathBox" Grid.Row="2" Grid.Column="1" ToolTip="Helldivers 2 游戏根目录" />
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="自动检测" Click="AutoDetectGame_Click" />
                    <Button Content="浏览" Margin="8,0,0,0" Click="BrowseGame_Click" />
                </StackPanel>
                <TextBlock x:Name="gamePathHint" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"
                           Text="智能修复需要有效的游戏目录；正在自动检测 Steam 安装位置…" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="检测结果" FontWeight="SemiBold" FontSize="18" />
                            <TextBlock Text="扫描补丁结构、资源类型表与 Unit 边界" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="repairButton" Content="安全修复" Margin="0,0,8,0" Click="Repair_Click" />
                            <Button x:Name="analyzeButton" Style="{StaticResource PrimaryButton}" Content="开始检测" Click="Analyze_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="resultsGrid" ItemsSource="{Binding Results}" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" Background="#141D29" Foreground="#E7EEF8"
                                  BorderThickness="0" GridLinesVisibility="None" RowHeaderWidth="0"
                                  SelectionChanged="ResultsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="补丁文件" Binding="{Binding Path}" Width="2*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Health}" Width="78" />
                                <DataGridTextColumn Header="条目" Binding="{Binding Entries}" Width="55" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Units}" Width="55" />
                                <DataGridTextColumn Header="概览" Binding="{Binding Details}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="emptyResultsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="尚未开始检测" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="选择 Mod 目录后点击“开始检测”" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="选中项诊断" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Grid.Row="1" Text="选择左侧补丁，查看完整的检测依据。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14" />
                    <TextBox x:Name="diagnosticText" Grid.Row="2" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="#C2D0E1" Padding="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Text="选择检测结果中的补丁文件，可查看完整原因与技术细节。" />
                    <TextBlock x:Name="diagnosticTitle" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#101A27" BorderBrush="#263B54" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
            <DockPanel>
                <Ellipse x:Name="statusDot" Width="8" Height="8" Fill="#4CA9FF" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="statusText" Text="选择一个包含 .patch_* 文件的 Mod 目录即可开始。" TextWrapping="Wrap" Foreground="#C8D6E8" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
