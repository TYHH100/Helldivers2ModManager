<UserControl x:Class="Helldivers2ModManager.Frontend.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{common:Loc Next.Settings.SectionDirectories}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{common:Loc SettingsPage.GameDir}" Margin="0,16,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource SearchBox}" Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button Style="{StaticResource FButton}" Command="{Binding DetectGameCommand}" Content="{common:Loc SettingsPage.AutoDetect}"/><Button Style="{StaticResource FButton}" Margin="8,0,0,0" Command="{Binding BrowseGameCommand}" Content="{common:Loc CreatePage.OptionBrowse}"/></StackPanel></Grid>
                    <TextBlock Text="{common:Loc SettingsPage.StorageDir}" Margin="0,14,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource SearchBox}" Text="{Binding StorageDirectory, UpdateSourceTrigger=PropertyChanged}"/><Button Style="{StaticResource FButton}" Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseStorageCommand}" Content="{common:Loc CreatePage.OptionBrowse}"/></Grid>
                    <TextBlock Text="{common:Loc SettingsPage.TempDir}" Margin="0,14,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource SearchBox}" Text="{Binding TempDirectory, UpdateSourceTrigger=PropertyChanged}"/><Button Style="{StaticResource FButton}" Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseTempCommand}" Content="{common:Loc CreatePage.OptionBrowse}"/></Grid>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{common:Loc Next.Settings.SectionBehavior}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox Style="{StaticResource FCheckBox}" Content="{common:Loc Next.Settings.UseSymlinks}" IsChecked="{Binding UseSymbolicLinks}" Margin="0,16,0,0"/>
                    <CheckBox Style="{StaticResource FCheckBox}" Content="{common:Loc Next.Settings.RecycleBin}" IsChecked="{Binding DeleteToRecycleBin}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource FCheckBox}" Content="{common:Loc Next.Settings.FuzzySearch}" IsChecked="{Binding EnableFuzzySearch}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource FCheckBox}" Content="{common:Loc Next.Settings.CheckVersionOnStartup}" IsChecked="{Binding AutoCheckVersionOnStartup}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource FCheckBox}" Content="{common:Loc Next.Settings.EnableAutoTagging}" IsChecked="{Binding EnableAutoTagging}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource FCheckBox}" Content="{common:Loc Next.Settings.AutoCreateTags}" IsChecked="{Binding AutoTagCreateMissingTags}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{common:Loc Next.Settings.SectionIntegration}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{common:Loc Next.Settings.LanguageLabel}" Margin="0,16,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Style="{StaticResource FComboBox}" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="180" HorizontalAlignment="Left"/>
                    <TextBlock Text="Nexus API Key" Margin="0,14,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding NexusApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Content="{common:Loc Next.Settings.Save}"/>
                    <TextBlock Text="{Binding Status}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
