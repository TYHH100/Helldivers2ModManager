<UserControl x:Class="Helldivers2ModManager.Frontend.Views.ModelPreviewPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource FComboBox}" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                          DisplayMemberPath="Name"/>
                <TextBlock Grid.Column="1" Margin="14,0" Text="{Binding Status}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Style="{StaticResource FButton}" Command="{Binding CancelCommand}" Content="{common:Loc Common.Cancel}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Meshes}" SelectedItem="{Binding SelectedMesh}" Background="Transparent"
                     BorderThickness="0" Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,8">
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Triangles "/><Run Text="{Binding TriangleCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#20252A" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Viewport3D ClipToBounds="True">
                    <Viewport3D.Camera>
                        <PerspectiveCamera Position="0,0,8" LookDirection="0,0,-1" FieldOfView="45" NearPlaneDistance="0.01" FarPlaneDistance="100000"/>
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#FF707070"/>
                                <DirectionalLight Color="#FFFFFFFF" Direction="-1,-1,-2"/>
                                <DirectionalLight Color="#FF707070" Direction="1,0,1"/>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D Content="{Binding ModelGroup}"/>
                </Viewport3D>
            </Border>
        </Grid>
    </Grid>
</UserControl>
