<UserControl x:Class="Helldivers2ModManager.Frontend.Views.DiagnosticsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FButton}" Command="{Binding RefreshCommand}" Content="{common:Loc Next.Diagnostics.RefreshStatus}"/>
                    <Button Style="{StaticResource FButton}" Margin="8,0,0,0" Command="{Binding CheckVersionsCommand}" Content="{common:Loc Next.Tasks.VersionCheck}"/>
                    <Button Style="{StaticResource FButton}" Margin="8,0,0,0" Command="{Binding ScanConflictsCommand}" Content="{common:Loc Next.Tasks.ConflictScan}"/>
                    <Button Style="{StaticResource FButton}" Margin="8,0,0,0" Command="{Binding ScanArmorReuseCommand}" Content="{common:Loc Nav.ArmorReuse}"/>
                    <Button Style="{StaticResource FButton}" Margin="16,0,0,0" Command="{Binding CreateRepairPlanCommand}" Content="{common:Loc Next.Diagnostics.CreatePlan}"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding ExecuteRepairsCommand}" Content="{common:Loc Next.Diagnostics.ExecuteRepairs}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="{common:Loc Next.Diagnostics.TabStatus}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CurrentStatus.StorageDirectory}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentStatus.GameDirectory}" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusSummary}" Margin="0,12,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CountersSummary}" Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{common:Loc Next.Diagnostics.TabRepairPlan}">
                <DataGrid ItemsSource="{Binding Repairs}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{common:Loc Next.Diagnostics.ColMod}" Binding="{Binding ModName}" Width="220"/>
                        <DataGridTextColumn Header="{common:Loc Next.Diagnostics.ColState}" Binding="{Binding StateText}" Width="150"/>
                        <DataGridTextColumn Header="{common:Loc Next.Diagnostics.ColMetadata}" Binding="{Binding MetadataActionCount}" Width="90"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding AssistedActionCount}" Width="90"/>
                        <DataGridTextColumn Header="{common:Loc Next.Diagnostics.ColCompanion}" Binding="{Binding CompanionRecoveryCount}" Width="110"/>
                        <DataGridTextColumn Header="{common:Loc Next.Diagnostics.ColMessage}" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#F2161C24" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12" Margin="0,16,0,0">
            <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="{Binding Time, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Message, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
