<UserControl x:Class="Helldivers2ModManager.Frontend.Views.BisectPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Content="{common:Loc Next.Bisect.Start}"/>
                    <Button Style="{StaticResource FButton}" Margin="10,0,0,0" Command="{Binding ReportCrashedCommand}" Content="{common:Loc Next.Bisect.Crashed}"/>
                    <Button Style="{StaticResource FButton}" Margin="10,0,0,0" Command="{Binding ReportWorkingCommand}" Content="{common:Loc Next.Bisect.Ok}"/>
                    <Button Style="{StaticResource FButton}" Margin="10,0,0,0" Command="{Binding PrepareSingleCommand}"
                            Content="{common:Loc Next.Bisect.SingleVerify}"
                            Visibility="{Binding HasSingleCandidate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Style="{StaticResource FButton}" Margin="10,0,0,0" Command="{Binding CancelCommand}" Content="{common:Loc Next.Bisect.CancelRestore}"/>
                    <Button Style="{StaticResource FButton}" Margin="10,0,0,0" Command="{Binding FinishCommand}" Content="{common:Loc Next.Bisect.Finish}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{common:Loc Next.Bisect.Candidates}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{common:Loc Next.Bisect.Suspects}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Suspects}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,3,0,0"
                                           Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{common:Loc Next.Bisect.Rounds}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Rounds}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="{common:Loc Next.Bisect.RoundPrefix}"/><Run Text="{Binding Index, Mode=OneWay}"/><Run Text="{common:Loc Next.Bisect.RoundSuffix}"/><Run Text="{Binding TestedNames, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Background="#B0101520" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="10" Padding="20" VerticalAlignment="Top"
                Visibility="{Binding IsSingleVerification, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{common:Loc Next.Bisect.SingleDeployedHint}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{common:Loc Next.Bisect.SubmitHint}"
                           Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
