<UserControl x:Class="Helldivers2ModManager.Frontend.Views.ArmorReusePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Content="{common:Loc BackendTestCenter.ScanArmorReuse}"/>
                <TextBlock Text="{Binding Status}" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding ModName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="{common:Loc Next.ArmorReuse.SourceArmorPrefix}"/><Run Text="{Binding SourceArmorName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,8" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{common:Loc Next.ArmorReuse.SharedUnitsPrefix}"/><Run Text="{Binding SharedUnitCount, Mode=OneWay}"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding ReusedBy}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ArmorName}" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
