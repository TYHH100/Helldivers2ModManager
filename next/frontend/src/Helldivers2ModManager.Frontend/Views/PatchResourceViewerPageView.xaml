<UserControl x:Class="Helldivers2ModManager.Frontend.Views.PatchResourceViewerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource FComboBox}" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                          DisplayMemberPath="Name"/>
                <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding Status}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="TOC">
                <DataGrid ItemsSource="{Binding TocEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Patch" Binding="{Binding PatchPath}" Width="180"/>
                        <DataGridTextColumn Header="File" Binding="{Binding FileIdText}" Width="160"/>
                        <DataGridTextColumn Header="Main" Binding="{Binding MainRangeText}" Width="170"/>
                        <DataGridTextColumn Header="GPU" Binding="{Binding GpuRangeText}" Width="170"/>
                        <DataGridTextColumn Header="Stream" Binding="{Binding StreamRangeText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="GPU Streams">
                <DataGrid ItemsSource="{Binding GpuStreams}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitIdText}" Width="160"/>
                        <DataGridTextColumn Header="Stream" Binding="{Binding StreamIndex}" Width="70"/>
                        <DataGridTextColumn Header="Verts" Binding="{Binding VertexCount}" Width="80"/>
                        <DataGridTextColumn Header="Indices" Binding="{Binding IndexCount}" Width="80"/>
                        <DataGridTextColumn Header="Components" Binding="{Binding Components}" Width="170"/>
                        <DataGridTextColumn Header="Sample" Binding="{Binding VertexSample}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Textures">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture}"
                              AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Texture" Binding="{Binding TextureIdText}" Width="160"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="120"/>
                            <DataGridTextColumn Header="Format" Binding="{Binding FormatText}" Width="100"/>
                            <DataGridTextColumn Header="Payload" Binding="{Binding PayloadKind}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" Margin="16,0,0,0" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Height="210" Background="#20FFFFFF" CornerRadius="8">
                                <Image Source="{Binding TexturePreview}" Stretch="Uniform" Margin="10"/>
                            </Border>
                            <TextBlock Text="{Binding TextureStatus}" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
