<UserControl x:Class="Helldivers2ModManager.Frontend.Views.EditPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentMod.Name}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CurrentMod.Description}" Margin="0,5,0,0" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Style="{StaticResource FComboBox}" Width="170" Margin="0,0,12,0"
                                              ItemsSource="{Binding SubOptions}" SelectedIndex="{Binding SelectedSubOption}"
                                              Visibility="{Binding HasSubOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <CheckBox Style="{StaticResource FCheckBox}" Content="{common:Loc Next.Edit.Enable}" IsChecked="{Binding IsEnabled}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding DoneCommand}" Content="{common:Loc EditPage.Done}"/>
                <Button Style="{StaticResource FButton}" Margin="10,0,0,0" Command="{Binding SaveCommand}" Content="{common:Loc Common.Save}"/>
                <Button Style="{StaticResource FButton}" Margin="10,0,0,0" Command="{Binding CancelCommand}" Content="{common:Loc Common.Cancel}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
