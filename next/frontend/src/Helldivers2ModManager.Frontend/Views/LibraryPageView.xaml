<UserControl x:Class="Helldivers2ModManager.Frontend.Views.LibraryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <common:InverseBooleanToVisibilityConverter x:Key="InverseVisibilityConverter"
                                                        xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Content="{Binding ImportLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding RefreshCommand}" Margin="10,0,0,0" Content="{Binding RefreshLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding DeployAllEnabledCommand}" Margin="10,0,0,0" Content="部署启用项"/>
                <Button Style="{StaticResource FButton}" Command="{Binding EnableSelectedCommand}" Margin="10,0,0,0" Content="{Binding EnableSelectedLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding DisableSelectedCommand}" Margin="10,0,0,0" Content="{Binding DisableSelectedLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding DeleteSelectedCommand}" Margin="10,0,0,0" Content="{Binding DeleteSelectedLabel}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ModsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource FCheckBox}" Grid.Column="1" IsChecked="{Binding IsEnabled}" Margin="12,0,14,0" VerticalAlignment="Center"
                                          Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.ShowOptionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Content="选项"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Content="编辑"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.ManifestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Content="清单"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="12,0,0,0" Content="{Binding DataContext.ExportLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,16,0,0"
                Visibility="{Binding HasSelectedModOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedOptionsItem.Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="选项开关与子选项" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding DeployOptionsCommand}" Content="保存并部署选项"/>
                </Grid>
                <ScrollViewer MaxHeight="330" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedModOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0FFFFFFF" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource FCheckBox}" Content="{Binding Name}" IsChecked="{Binding IsEnabled}"
                                                      Visibility="{Binding DataContext.IsLegacyOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseVisibilityConverter}}"/>
                                            <RadioButton GroupName="LegacyDeploymentOption" Content="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                         Visibility="{Binding DataContext.IsLegacyOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="28,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Style="{StaticResource FComboBox}" Grid.Column="1" MinWidth="280" MaxWidth="430"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  ItemsSource="{Binding SubOptions}" SelectedIndex="{Binding SelectedSubOption}"
                                                  Visibility="{Binding HasSubOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
