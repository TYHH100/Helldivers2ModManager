<UserControl x:Class="Helldivers2ModManager.Frontend.Views.LibraryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Helldivers2ModManager.Frontend.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/FrontendTokens.xaml"/>
                <ResourceDictionary Source="../Themes/FrontendControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <common:InverseBooleanToVisibilityConverter x:Key="InverseVisibilityConverter"/>
            <common:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Content="{Binding ImportLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding RefreshCommand}" Margin="10,0,0,0" Content="{Binding RefreshLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding DeployAllEnabledCommand}" Margin="10,0,0,0" Content="{Binding DeployEnabledLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding EnableSelectedCommand}" Margin="10,0,0,0" Content="{Binding EnableSelectedLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding DisableSelectedCommand}" Margin="10,0,0,0" Content="{Binding DisableSelectedLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding DeleteSelectedCommand}" Margin="10,0,0,0" Content="{Binding DeleteSelectedLabel}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding GroupFilterLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox Style="{StaticResource FComboBox}" MinWidth="170" Margin="10,0,0,0" VerticalAlignment="Center"
                          ItemsSource="{Binding FilterChoices}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedFilterChoice}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding CreateGroupCommand}" Margin="14,0,0,0"
                        Content="{Binding CreateGroupLabel}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding RenameGroupCommand}" Margin="10,0,0,0"
                        Content="{Binding RenameGroupLabel}"
                        Visibility="{Binding CanManageSelectedGroup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Style="{StaticResource FButton}" Command="{Binding DeleteGroupCommand}" Margin="10,0,0,0"
                        Content="{Binding DeleteGroupLabel}"
                        Visibility="{Binding CanManageSelectedGroup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Style="{StaticResource SearchBox}" MinWidth="220" Margin="24,0,0,0" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding SearchWatermark}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ModsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource FCheckBox}" Grid.Column="1" IsChecked="{Binding IsEnabled}" Margin="12,0,14,0" VerticalAlignment="Center"
                                          Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding GroupName}" FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Visibility="{Binding GroupName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TagSummary}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding TagSummary, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Style="{StaticResource FComboBox}" MinWidth="120" Margin="10,0,0,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.AssignGroupChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding GroupId, Mode=TwoWay}"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.ShowOptionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Content="{Binding DataContext.OptionsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.ShowTagsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Content="{Binding DataContext.TagsButtonLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Content="{Binding DataContext.EditLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.ManifestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Content="{Binding DataContext.ManifestLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Style="{StaticResource FButton}" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="12,0,0,0" Content="{Binding DataContext.ExportLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,16,0,0"
                Visibility="{Binding HasSelectedModOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedOptionsItem.Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding OptionsSubtitle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding DeployOptionsCommand}" Content="{Binding SaveDeployOptionsLabel}"/>
                </Grid>
                <ScrollViewer MaxHeight="330" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedModOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0FFFFFFF" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource FCheckBox}" Content="{Binding Name}" IsChecked="{Binding IsEnabled}"
                                                      Visibility="{Binding DataContext.IsLegacyOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseVisibilityConverter}}"/>
                                            <RadioButton GroupName="LegacyDeploymentOption" Content="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                         Visibility="{Binding DataContext.IsLegacyOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="28,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Style="{StaticResource FComboBox}" Grid.Column="1" MinWidth="280" MaxWidth="430"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  ItemsSource="{Binding SubOptions}" SelectedIndex="{Binding SelectedSubOption}"
                                                  Visibility="{Binding HasSubOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,16,0,0"
                Visibility="{Binding HasSelectedTags, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedTagsItem.Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding TagsSubtitle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding SaveTagsCommand}" Content="{Binding SaveTagsLabel}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding TagChoices}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource FCheckBox}" Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,18,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
