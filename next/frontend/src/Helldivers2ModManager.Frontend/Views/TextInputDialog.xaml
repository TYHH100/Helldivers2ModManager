<Window x:Class="Helldivers2ModManager.Frontend.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BaseBrush}"
        WindowStyle="ToolWindow">
    <Border Padding="18" Background="{DynamicResource CardBrush}">
        <StackPanel>
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="InputBox" Padding="6,4" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Click="OnOk" MinWidth="80" Padding="8,4"/>
                <Button x:Name="CancelButton" IsCancel="True" MinWidth="80" Padding="8,4" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
