<Window x:Class="ArmorMerger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArmorMerger - Helldivers 2 护甲合并工具" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="Helldivers 2 护甲合并工具" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- 输入区域 -->
        <GroupBox Grid.Row="1" Header="输入" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 头盔 Patch -->
                <Label Grid.Row="0" Grid.Column="0" Content="头盔 Patch:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HelmetPatchPath" 
                         IsReadOnly="True" Background="#F0F0F0"/>
                <Button Grid.Row="0" Grid.Column="2" Content="浏览..." 
                        Click="HelmetPatchBrowse_Click"/>

                <!-- 护甲 Patch -->
                <Label Grid.Row="1" Grid.Column="0" Content="护甲 Patch:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ArmorPatchPath" 
                         IsReadOnly="True" Background="#F0F0F0"/>
                <Button Grid.Row="1" Grid.Column="2" Content="浏览..." 
                        Click="ArmorPatchBrowse_Click"/>

                <!-- 或者：单个 Mod 目录 -->
                <Label Grid.Row="2" Grid.Column="0" Content="或 Mod 目录:"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ModDirectoryPath" 
                         IsReadOnly="True" Background="#F0F0F0"/>
                <Button Grid.Row="2" Grid.Column="2" Content="浏览..." 
                        Click="ModDirectoryBrowse_Click"/>

                <!-- 选项 -->
                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" 
                          x:Name="HideHelmetCheckBox" Content="隐藏头盔（合并后头盔不可见）" 
                          IsChecked="True" Margin="4,8,0,0"/>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="分析 Patch" Click="Analyze_Click" Width="100"/>
            <Button Content="合并" Click="Merge_Click" Width="100" FontWeight="Bold"/>
            <Button Content="导出 Mod 包" Click="ExportMod_Click" Width="100"/>
            <Separator Margin="8,0"/>
            <Button Content="清空" Click="Clear_Click" Width="80"/>
        </StackPanel>

        <!-- 输出区域 -->
        <GroupBox Grid.Row="3" Header="输出" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="输出目录:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="OutputDirectoryPath" 
                         IsReadOnly="True" Background="#F0F0F0"/>
                <Button Grid.Row="0" Grid.Column="2" Content="浏览..." 
                        Click="OutputDirectoryBrowse_Click"/>

                <Label Grid.Row="1" Grid.Column="0" Content="输出名称:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="OutputName" 
                         Text="merged_armor" Margin="4"/>
            </Grid>
        </GroupBox>

        <!-- 日志/状态 -->
        <GroupBox Grid.Row="4" Header="日志" Margin="0,0,0,0">
            <TextBox x:Name="LogTextBox" IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     TextWrapping="NoWrap" MaxHeight="200"/>
        </GroupBox>
    </Grid>
</Window>
