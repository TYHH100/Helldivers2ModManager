<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\Images\icon.ico</ApplicationIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ProductName>Helldivers 2 Mod Manager</ProductName>
		<ProductVersion>1.5.0</ProductVersion>
		<AssemblyVersion>1.5.0</AssemblyVersion>
		<FileVersion>1.5.0</FileVersion>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<ExcludeSevenZipAssemblies>true</ExcludeSevenZipAssemblies>
	</PropertyGroup>

	<ItemGroup>
	  <Resource Include="Resources\Fonts\FS Sinclair Bold.otf" />
	  <Resource Include="Resources\Fonts\FS Sinclair Medium.otf" />
	  <Resource Include="Resources\Fonts\FS Sinclair Regular.otf" />
	  <Resource Include="Resources\Images\discord_icon.png" />
	  <Content Include="Resources\Images\icon.ico">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="SharpSevenZip" Version="2.0.109" />
		<PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
		<PackageReference Include="MdXaml" Version="1.27.0" />
		<PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
		<PackageReference Include="ToolGood.Words.Pinyin" Version="3.1.0.4" />
		<PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
		<PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
		<PackageReference Include="Vortice.DXGI" Version="3.8.3" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
		<!-- Wwise WEM → Ogg Vorbis 转换（ww2ogg 的 .NET 移植，BSD-3-Clause）。
		     HD2 音频用 aoTuV codebook 编码，播放时先试 AoTuV 再回退 Default。 -->
		<PackageReference Include="Ww2Ogg.Core" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Resources\Native\7z.dll">
	    <Link>7z.dll</Link>
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Resources\Language\*.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Resources\Data\*.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\Fonts\Blockletter.otf" />
	  <Resource Include="Resources\Images\github_icon.png" />
	  <Resource Include="Resources\Images\logo.png" />
	  <Resource Include="Resources\Images\logo_icon.png" />
	  <Resource Include="Resources\Images\remove.png" />
	  <Resource Include="Resources\Images\loading.png" />
	  <Resource Include="Resources\Images\download.png" />
	  <Resource Include="Resources\Images\check.png" />
	  <Resource Include="Resources\Images\error.png" />
	</ItemGroup>

	<ItemGroup>
	  <!-- 闪屏图片：由 SplashWindow 以 pack URI 加载（不再使用 WPF 默认 SplashScreen——
	       默认机制在首帧提交前就关闭闪屏，会让主窗口黑底透过 LOGO 透明区域一闪而过） -->
	  <Resource Include="Resources\Images\logo_splash.png" />
	</ItemGroup>
</Project>
