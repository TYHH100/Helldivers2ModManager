<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- Fluent Design System - Window & Page Styles -->
    <!-- ============================================ -->

    <!-- Import Core Tokens -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FluentDesignTokens.xaml"/>
        <ResourceDictionary Source="FluentControls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================ -->
    <!-- Fluent Window Style                         -->
    <!-- ============================================ -->

    <Style x:Key="FluentWindowStyle" TargetType="Window">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="{StaticResource MicaBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MicaBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Page Style                           -->
    <!-- ============================================ -->

    <Style x:Key="FluentPageStyle" TargetType="Page">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Title Bar (Custom Window Chrome)     -->
    <!-- ============================================ -->

    <Style x:Key="FluentTitleBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentCloseButton" TargetType="Button" BasedOn="{StaticResource FluentTitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#C42B1C"/>
                            <Setter TargetName="BackgroundLayer" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="#A02518"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Navigation View                      -->
    <!-- ============================================ -->

    <Style x:Key="FluentNavigationButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12 8"/>
        <Setter Property="Margin" Value="0 2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Opacity="0"/>
                        <Border x:Name="IndicatorBar"
                                Width="3"
                                Background="{StaticResource SystemAccentBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Margin="4 4 0 4"
                                Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            <Setter TargetName="BackgroundLayer" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Section Header                       -->
    <!-- ============================================ -->

    <Style x:Key="FluentSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
        <Setter Property="Margin" Value="0 0 0 8"/>
    </Style>

    <Style x:Key="FluentSubSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
        <Setter Property="Margin" Value="0 16 0 4"/>
    </Style>

    <Style x:Key="FluentBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FluentCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundTertiaryBrush}"/>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Divider                              -->
    <!-- ============================================ -->

    <Style x:Key="FluentDivider" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeutralStrokeBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0 8"/>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Progress Indicator                   -->
    <!-- ============================================ -->

    <Style x:Key="FluentProgressBar" TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SystemAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indeterminate Progress Ring -->
    <Style x:Key="FluentProgressRing" TargetType="ProgressBar">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource SystemAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Ellipse Stroke="{StaticResource NeutralBackgroundFillBrush}"
                                 StrokeThickness="3"/>
                        <Ellipse Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="3"
                                 StrokeDashArray="1 1"
                                 StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="Rotation" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Rotation"
                                                           Storyboard.TargetProperty="Angle"
                                                           From="0" To="360"
                                                           Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Message Dialog                       -->
    <!-- ============================================ -->

    <Style x:Key="FluentMessageDialog" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeutralBackgroundAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource ShadowElevationLevel4}"/>
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MaxWidth" Value="500"/>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Settings Tab Button                   -->
    <!-- ============================================ -->

    <Style x:Key="FluentSettingsTabButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16 12"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 选项卡背景层，通过 TemplateBinding 响应 Background 属性变化 -->
                        <Border x:Name="BackgroundLayer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4 4 0 0"/>
                        <!-- 底部激活指示条，通过 TemplateBinding 响应 BorderBrush 属性变化 -->
                        <Border x:Name="IndicatorBar"
                                Height="3"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="2 2 0 0"
                                VerticalAlignment="Bottom"
                                Margin="8 0"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource NeutralBackgroundFillBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Settings Card                        -->
    <!-- ============================================ -->

    <Style x:Key="FluentSettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeutralStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0 4"/>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Mod Item Card                        -->
    <!-- ============================================ -->

    <Style x:Key="FluentModCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeutralStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0 4"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Fluent Icon Glyphs (Segoe Fluent Icons)    -->
    <!-- ============================================ -->

    <Style x:Key="FluentIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}"/>
    </Style>

    <Style x:Key="FluentIconLarge" TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
        <Setter Property="FontSize" Value="24"/>
    </Style>

    <Style x:Key="FluentIconSmall" TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>