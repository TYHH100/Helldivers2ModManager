<UserControl x:Class="Helldivers2ModManager.Components.FirstRunTutorialOverlay"
			 x:ClassModifier="internal"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
			 mc:Ignorable="d"
			 d:DesignHeight="700"
			 d:DesignWidth="1000"
			 Focusable="True"
			 KeyDown="Overlay_KeyDown"
			 UseLayoutRounding="True"
			 SnapsToDevicePixels="True"
			 RenderOptions.BitmapScalingMode="HighQuality"
			 TextOptions.TextFormattingMode="Display"
			 TextOptions.TextRenderingMode="ClearType"
			 RenderOptions.ClearTypeHint="Enabled"
			 Visibility="{Binding IsFirstRunTutorialVisible, Converter={StaticResource BoolToVisibilityConverter}}">
	<Grid x:Name="Root" Background="Transparent">
		<!-- 全屏点击拦截层：防止引导打开时点击穿透到下方页面 -->
		<Border Background="Transparent"
				Focusable="False"/>
		<!-- 变暗层：使用 CombinedGeometry 在目标控件周围挖出高亮区域 -->
		<Path x:Name="DimPath"
			  Fill="#B0000000"
			  Focusable="False"
			  IsHitTestVisible="False"/>
		<!-- 高亮描边 -->
		<Border x:Name="HighlightBorder"
				BorderBrush="{StaticResource SystemAccentBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Background="Transparent"
				IsHitTestVisible="False"
				Visibility="Collapsed"/>
		<!-- 引导卡片 -->
		<Border x:Name="Card"
				Style="{StaticResource FluentMessageDialog}"
				MaxWidth="440"
				MinWidth="320"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				SnapsToDevicePixels="True"
				UseLayoutRounding="True"
				RenderOptions.ClearTypeHint="Enabled"
				Margin="0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Icon -->
				<Border Grid.Row="0"
						Grid.RowSpan="2"
						Grid.Column="0"
						Width="56"
						Height="56"
						CornerRadius="14"
						Background="{StaticResource SystemAccentBrush}"
						Margin="0 0 16 0"
						VerticalAlignment="Top">
					<TextBlock Text="{Binding FirstRunTutorialIcon}"
							   FontFamily="Segoe Fluent Icons"
							   FontSize="28"
							   Foreground="White"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"/>
				</Border>

				<!-- Title -->
				<TextBlock Grid.Row="0"
						   Grid.Column="1"
						   Text="{Binding FirstRunTutorialTitle}"
						   FontSize="20"
						   FontWeight="SemiBold"
						   Foreground="{StaticResource NeutralForegroundBrush}"
						   TextWrapping="Wrap"
						   Margin="0 0 0 8"/>

				<!-- Description -->
				<TextBlock Grid.Row="1"
						   Grid.Column="1"
						   Text="{Binding FirstRunTutorialDescription}"
						   FontSize="14"
						   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
						   TextWrapping="Wrap"
						   LineHeight="22"
						   Margin="0 0 0 20"/>

				<!-- Step indicator -->
				<TextBlock Grid.Row="2"
						   Grid.Column="0"
						   Grid.ColumnSpan="2"
						   Text="{Binding FirstRunTutorialStepText}"
						   FontSize="12"
						   Foreground="{StaticResource NeutralForegroundTertiaryBrush}"
						   HorizontalAlignment="Center"
						   Margin="0 0 0 12"/>

				<!-- Buttons -->
				<StackPanel Grid.Row="3"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right">
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc FirstRunTutorial.Skip}"
							Command="{Binding SkipFirstRunTutorialCommand}"
							Padding="14 8"
							Margin="0 0 8 0"/>
					<Button Style="{StaticResource FluentSecondaryButton}"
							Content="{loc:Loc FirstRunTutorial.Previous}"
							Command="{Binding PreviousTutorialStepCommand}"
							Padding="14 8"
							Margin="0 0 8 0"
							IsEnabled="{Binding IsFirstRunTutorialFirstStep, Converter={StaticResource InverseBoolConverter}}"/>
					<Button Style="{StaticResource FluentPrimaryButton}"
							Content="{loc:Loc FirstRunTutorial.Next}"
							Command="{Binding NextTutorialStepCommand}"
							Padding="18 8"
							Visibility="{Binding IsFirstRunTutorialNotLastStep, Converter={StaticResource BoolToVisibilityConverter}}"/>
					<Button Style="{StaticResource FluentPrimaryButton}"
							Content="{loc:Loc FirstRunTutorial.Finish}"
							Command="{Binding FinishFirstRunTutorialCommand}"
							Padding="18 8"
							Visibility="{Binding IsFirstRunTutorialLastStep, Converter={StaticResource BoolToVisibilityConverter}}"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>