<UserControl x:Class="Helldivers2ModManager.Components.VersionCheckDetailOverlay"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
             Background="#99000000"
             Visibility="Hidden"
             Focusable="True"
             IsVisibleChanged="Overlay_IsVisibleChanged"
             KeyDown="Overlay_KeyDown"
             MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
    <Border Width="820"
            MaxWidth="920"
            MaxHeight="650"
            Margin="24"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource FluentMessageDialog}"
            MouseLeftButtonDown="Dialog_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc VersionCheckDetail.Title}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralForegroundBrush}"/>
                    <TextBlock Text="{Binding ModName}"
                               Margin="0 4 0 0"
                               FontSize="13"
                               Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="12 -6 -6 0"
                        Style="{StaticResource FluentIconButton}"
                        ToolTip="{loc:Loc MainWindow.Close}"
                        Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0 0 8 0">
                    <Border Padding="16"
                            CornerRadius="4"
                            Background="{Binding StatusBackground}"
                            BorderBrush="{Binding StatusBrush}"
                            BorderThickness="1"
                            Margin="0 0 0 12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusIcon}"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="24"
                                       Foreground="{Binding StatusBrush}"
                                       VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StatusBrush}"/>
                                <TextBlock Text="{Binding Summary}"
                                           Margin="0 4 0 0"
                                           FontSize="13"
                                           Foreground="{StaticResource NeutralForegroundBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FluentSettingsCard}" Margin="0 0 0 16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PatchFileCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ArmorPollutionPage.ScannedPatches}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource NeutralStrokeBrush}" Margin="0 2"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ResourceCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc VersionCheckDetail.Resources}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="3" Background="{StaticResource NeutralStrokeBrush}" Margin="0 2"/>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding UnitCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc VersionCheckDetail.Units}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="5" Background="{StaticResource NeutralStrokeBrush}" Margin="0 2"/>
                            <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalIssueCount}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding IssueCountBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc VersionCheckDetail.Issues}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Patch/Unit structure and repair references are intentionally visible in this feature. -->
                    <Border Padding="12"
                            CornerRadius="4"
                            BorderBrush="{StaticResource NeutralStrokeBrush}"
                            BorderThickness="1"
                            Background="{StaticResource NeutralBackgroundFillSecondaryBrush}"
                            Margin="0 0 0 16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc VersionCheckDetail.AttributionTitle}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc VersionCheckDetail.Attribution}"
                                       Margin="0 4 0 0"
                                       FontSize="11"
                                       Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc VersionCheckDetail.DetectedIssues}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HealthyUnitSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Visibility="{Binding NoIssuesVisibility}"
                            Padding="16"
                            CornerRadius="4"
                            BorderBrush="{StaticResource SuccessBrush}"
                            BorderThickness="1"
                            Background="#15107C10"
                            Margin="0 0 0 12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="18" Margin="0 0 12 0"/>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc VersionCheckDetail.NoIssues}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc VersionCheckDetail.NoIssuesDescription}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 3 0 0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding VisibleIssues}" Visibility="{Binding IssuesVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FluentSettingsCard}" Margin="0 0 0 8" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Brush}" CornerRadius="4 0 0 4"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Icon}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="17"
                                                   Foreground="{Binding Brush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Margin="0 15 0 0"/>
                                        <StackPanel Grid.Column="2" Margin="8 12 14 12">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 5 0 0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding HiddenIssueSummary}"
                               Visibility="{Binding HiddenIssuesVisibility}"
                               Margin="4 2 0 12"
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"/>

                    <Expander Header="{loc:Loc VersionCheckDetail.TechnicalDetails}"
                              Style="{StaticResource FluentExpander}"
                              IsExpanded="False"
                              Margin="0 8 0 0">
                        <TextBox Text="{Binding TechnicalReport}"
                                 Margin="0 10 0 0"
                                 Height="230"
                                 Padding="10"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"/>
                    </Expander>

                    <Expander x:Name="backupHistoryExpander"
                              Header="{loc:Loc VersionCheckBackup.HistoryTitle}"
                              Style="{StaticResource FluentExpander}"
                              IsExpanded="False"
                              Margin="0 12 0 0">
                        <StackPanel Margin="0 10 0 0">
                            <TextBlock x:Name="backupHistorySummary"
                                       FontSize="12"
                                       Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="2 0 0 8"/>
                            <!-- 整模组回滚（含所有选项文件夹） -->
                            <Grid x:Name="rollbackPanel"
                                  Margin="0 0 0 8"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{loc:Loc VersionCheckBackup.RollbackTimeLabel}"
                                           FontSize="12"
                                           Foreground="{StaticResource NeutralForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="2 0 8 0"/>
                                <ComboBox x:Name="rollbackPointCombo"
                                          Grid.Column="1"
                                          Width="150"
                                          FontSize="12"
                                          Padding="4 3"
                                          IsEnabled="False"/>
                                <Button x:Name="rollbackButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource FluentSecondaryButton}"
                                        Padding="12 5"
                                        Margin="8 0 0 0"
                                        IsEnabled="False"
                                        Click="RollbackButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0 0 6 0"/>
                                        <TextBlock Text="{loc:Loc VersionCheckBackup.RollbackButton}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="backupHistoryLoading"
                                       Text="{loc:Loc VersionCheckBackup.Loading}"
                                       FontSize="12"
                                       Foreground="{StaticResource SystemAccentBrush}"
                                       Margin="2 0 0 8"/>
                            <ItemsControl x:Name="backupHistoryItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding Title}"
                                                  Style="{StaticResource FluentExpander}"
                                                  IsExpanded="True"
                                                  Margin="0 0 0 8">
                                            <StackPanel Margin="0 6 0 0">
                                                <TextBlock Text="{Binding EntryCountText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                                           Margin="2 0 0 6"/>
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource FluentSettingsCard}"
                                                                    Margin="0 0 0 8"
                                                                    Padding="12">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Detail}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                                                                   Margin="0 0 0 0"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Status}"
                                                                                   FontSize="11"
                                                                                   Foreground="{Binding StatusBrush}"
                                                                                   Margin="0 4 0 0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1"
                                                                            Width="34"
                                                                            Height="34"
                                                                            Margin="10 0 4 0"
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource FluentIconButton}"
                                                                            ToolTip="{loc:Loc VersionCheckBackup.Restore}"
                                                                            Tag="{Binding Entry}"
                                                                            IsEnabled="{Binding CanRestore}"
                                                                            Click="RestoreBackupButton_Click">
                                                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                                                    </Button>
                                                                    <Button Grid.Column="2"
                                                                            Width="34"
                                                                            Height="34"
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource FluentIconButton}"
                                                                            ToolTip="{loc:Loc VersionCheckBackup.Delete}"
                                                                            Tag="{Binding Entry}"
                                                                            Click="DeleteBackupButton_Click">
                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0 2 0 0">
                                <TextBlock x:Name="backupOperationStatus"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="cleanBackupsButton"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource FluentSecondaryButton}"
                                        Padding="10 7"
                                        Click="CleanBackupsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0 0 6 0"/>
                                        <TextBlock Text="{loc:Loc VersionCheckBackup.CleanOld}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0 18 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="repairProgress"
                               Foreground="{StaticResource SystemAccentBrush}"
                               FontSize="12"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="repairStatus"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="copyStatus"
                               Text="{loc:Loc VersionCheckDetail.Copied}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="12"
                               Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="recoveryButton"
                            Style="{StaticResource FluentSecondaryButton}"
                            Padding="12 8"
                            Margin="0 0 8 0"
                            Visibility="Collapsed"
                            Click="RecoveryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0 0 7 0"/>
                            <TextBlock x:Name="recoveryButtonText"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="advancedRepairButton"
                            Style="{StaticResource FluentSecondaryButton}"
                            Padding="12 8"
                            Margin="0 0 8 0"
                            Visibility="Collapsed"
                            Click="AdvancedRepairButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0 0 7 0"/>
                            <TextBlock Text="{loc:Loc VersionCheckDetail.AdvancedRepairButton}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="repairButton"
                            Style="{StaticResource FluentConfirmButton}"
                            Padding="14 8"
                            Margin="0 0 8 0"
                            Visibility="Collapsed"
                            Click="RepairButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0 0 7 0"/>
                            <TextBlock x:Name="repairButtonText"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FluentSecondaryButton}"
                            Padding="14 8"
                            Margin="0 0 8 0"
                            Click="CopyButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0 0 7 0"/>
                            <TextBlock Text="{loc:Loc VersionCheckDetail.CopyReport}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
