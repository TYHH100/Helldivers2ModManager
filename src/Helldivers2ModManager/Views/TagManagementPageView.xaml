<Page x:Class="Helldivers2ModManager.Views.TagManagementPageView"
	  x:ClassModifier="internal"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
	  xmlns:models="clr-namespace:Helldivers2ModManager.Models"
	  xmlns:local="clr-namespace:Helldivers2ModManager"
	  xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
	  mc:Ignorable="d"
	  d:DataContext="{d:DesignInstance vms:TagManagementPageViewModel}"
	  d:Background="{StaticResource MicaBackgroundBrush}"
	  d:DesignWidth="1000"
	  d:DesignHeight="700"
	  Title="{Binding Title}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Grid.Row="0"
				   Text="{loc:Loc DashboardPage.TagManagement}"
				   Style="{StaticResource FluentSectionHeader}"
				   Margin="0 0 0 16"/>

		<!-- Content -->
		<Border Grid.Row="1"
				Style="{StaticResource FluentCard}"
				CornerRadius="8"
				Margin="0 0 0 16">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Top Actions -->
				<Border Grid.Row="0"
						Style="{StaticResource FluentCard}"
						CornerRadius="8"
						Padding="12 8"
						Margin="12 12 12 0">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding CreateTagCommand}"
								Style="{StaticResource FluentPrimaryButton}"
								Padding="16 8">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
								<TextBlock Text="{loc:Loc TagManagementPage.CreateTitle}" Margin="8 0 0 0" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Border>

				<!-- Tags List -->
				<ListBox Grid.Row="1"
						 Margin="12"
						 ItemsSource="{Binding Tags}"
						 SelectedItem="{Binding SelectedTag}">
					<ListBox.ItemTemplate>
						<DataTemplate DataType="models:ModTag">
							<Border Padding="12 8"
									CornerRadius="4">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<!-- Color Indicator -->
									<Border Grid.Column="0"
											Grid.Row="0"
											Grid.RowSpan="2"
											Width="24"
											Height="24"
											Margin="0 0 12 0"
											VerticalAlignment="Center"
											CornerRadius="4">
										<Border.Background>
											<SolidColorBrush Color="{Binding Color}"/>
										</Border.Background>
									</Border>

									<!-- Name -->
									<TextBlock Grid.Column="1"
											   Grid.Row="0"
											   Text="{Binding Name}"
											   FontSize="16"
											   FontWeight="SemiBold"
											   Foreground="{StaticResource NeutralForegroundBrush}"
											   VerticalAlignment="Center"/>

									<!-- Buttons -->
									<StackPanel Grid.Column="2"
												Grid.Row="0"
												Grid.RowSpan="2"
												Orientation="Horizontal">
										<Button Command="{Binding DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=Page}}"
												CommandParameter="{Binding}"
												Style="{StaticResource FluentIconButton}"
												Margin="0 0 8 0"
												ToolTip="{loc:Loc DashboardPage.ChangeColor}">
											<TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
										</Button>
										<Button Command="{Binding DataContext.RenameTagCommand, RelativeSource={RelativeSource AncestorType=Page}}"
												CommandParameter="{Binding}"
												Style="{StaticResource FluentIconButton}"
												Margin="0 0 8 0"
												ToolTip="{loc:Loc TagManagementPage.RenameTitle}">
                                            <TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
										</Button>
										<Button Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=Page}}"
												CommandParameter="{Binding}"
												Style="{StaticResource FluentIconButton}"
												ToolTip="{loc:Loc TagManagementPage.DeleteTag}">
											<TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                                       Foreground="{StaticResource DangerBrush}"/>
										</Button>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="2"
				Style="{StaticResource FluentCard}"
				CornerRadius="8">
			<Button Command="{Binding BackCommand}"
					Style="{StaticResource FluentSecondaryButton}"
					HorizontalAlignment="Left"
					Padding="16 10">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
					<TextBlock Text="{loc:Loc Common.Back}" Margin="8 0 0 0" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Border>
	</Grid>
</Page>