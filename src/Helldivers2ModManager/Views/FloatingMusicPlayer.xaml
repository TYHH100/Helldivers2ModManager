<UserControl x:Class="Helldivers2ModManager.Views.FloatingMusicPlayer"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
			 xmlns:vms="clr-namespace:Helldivers2ModManager.ViewModels"
			 mc:Ignorable="d"
			 d:DataContext="{d:DesignInstance vms:FloatingMusicPlayerViewModel}"
			 Loaded="FloatingMusicPlayer_Loaded"
			 SizeChanged="FloatingMusicPlayer_SizeChanged">
	<UserControl.Resources>
		<Style x:Key="MusicIconButton" TargetType="Button">
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="#28FFFFFF"/>
			<Setter Property="BorderBrush" Value="#24FFFFFF"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="16">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#46FFFFFF"/></Trigger>
				<Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#18FFFFFF"/></Trigger>
				<Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Grid>
		<Border x:Name="CollapsedPlayer" Width="56" Height="56"
				Background="#ED1E1E1E" BorderBrush="#35FFFFFF" BorderThickness="1"
				CornerRadius="28" Cursor="SizeAll"
				RenderTransformOrigin="0.5 0.5"
				PreviewMouseLeftButtonDown="DragSurface_PreviewMouseLeftButtonDown"
				PreviewMouseMove="DragSurface_PreviewMouseMove"
				PreviewMouseLeftButtonUp="DragSurface_PreviewMouseLeftButtonUp"
				ToolTip="{loc:Loc MusicPlayer.Expand}">
			<Border.RenderTransform>
				<ScaleTransform ScaleX="1" ScaleY="1"/>
			</Border.RenderTransform>
			<Grid>
				<TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="23"
						   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				<Ellipse Width="9" Height="9" Fill="{StaticResource SystemAccentBrush}"
						 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 8 8 0"
						 Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}"/>
			</Grid>
		</Border>

		<Border x:Name="ExpandedPlayer" Width="360" MaxHeight="520"
				Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
				Background="#F01E1E1E" BorderBrush="#35FFFFFF" BorderThickness="1"
				CornerRadius="8" Padding="14" RenderTransformOrigin="0.5 0.5">
			<Border.RenderTransform>
				<ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
			</Border.RenderTransform>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Margin="0 0 0 12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="6"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="6"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="6"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0" Background="Transparent" Cursor="SizeAll"
							PreviewMouseLeftButtonDown="DragSurface_PreviewMouseLeftButtonDown"
							PreviewMouseMove="DragSurface_PreviewMouseMove"
							PreviewMouseLeftButtonUp="DragSurface_PreviewMouseLeftButtonUp">
						<TextBlock Text="{loc:Loc MusicPlayer.Title}" FontSize="14" FontWeight="SemiBold"
								   Foreground="White" VerticalAlignment="Center"/>
					</Border>
					<Button Grid.Column="1" Style="{StaticResource MusicIconButton}" Width="28" Height="28"
							Command="{Binding CyclePlaybackModeCommand}" ToolTip="{Binding PlaybackModeDisplayName}">
						<TextBlock Text="{Binding PlaybackModeIcon}" FontFamily="Segoe Fluent Icons" FontSize="13"/>
					</Button>
					<Button Grid.Column="3" Style="{StaticResource MusicIconButton}" Width="28" Height="28"
							Command="{Binding OpenMusicFolderCommand}" ToolTip="{loc:Loc MusicPlayer.OpenFolder}">
						<TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
					</Button>
					<Button Grid.Column="5" Style="{StaticResource MusicIconButton}" Width="28" Height="28"
							Command="{Binding RefreshPlaylistCommand}" ToolTip="{loc:Loc MusicPlayer.Refresh}">
						<TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
					</Button>
					<Button Grid.Column="7" Style="{StaticResource MusicIconButton}" Width="28" Height="28"
							Command="{Binding CollapseCommand}" ToolTip="{loc:Loc MusicPlayer.Collapse}">
						<TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
					</Button>
				</Grid>

				<StackPanel Grid.Row="1" Margin="0 0 0 10">
					<TextBlock Text="{Binding CurrentTrackName}" FontSize="14" FontWeight="SemiBold"
							   Foreground="White" TextTrimming="CharacterEllipsis"/>
					<TextBlock Text="{Binding PlaybackError}" FontSize="11" Foreground="#FFFF8A80"
							   TextWrapping="Wrap" Margin="0 4 0 0"
							   Visibility="{Binding HasPlaybackError, Converter={StaticResource BoolToVisibilityConverter}}"/>
				</StackPanel>

				<Grid Grid.Row="2" Margin="0 0 0 10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Slider Minimum="0" Maximum="{Binding TotalDuration}" Value="{Binding CurrentPosition, Mode=TwoWay}"
							IsEnabled="{Binding HasTrack}" Style="{StaticResource FluentSlider}"
							PreviewMouseDown="ProgressSlider_PreviewMouseDown" PreviewMouseUp="ProgressSlider_PreviewMouseUp"/>
					<Grid Grid.Row="1" Margin="0 3 0 0">
						<TextBlock Text="{Binding CurrentPositionText}" FontSize="11" Foreground="#AFFFFFFF"/>
						<TextBlock Text="{Binding TotalDurationText}" FontSize="11" Foreground="#AFFFFFFF" HorizontalAlignment="Right"/>
					</Grid>
				</Grid>

				<Grid Grid.Row="3" Margin="0 0 0 10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Button Grid.Column="1" Style="{StaticResource MusicIconButton}" Command="{Binding PreviousCommand}"
							IsEnabled="{Binding HasTrack}" ToolTip="{loc:Loc MusicPlayer.Previous}">
						<TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
					</Button>
					<Button Grid.Column="3" Style="{StaticResource MusicIconButton}" Width="44" Height="44"
							Background="{StaticResource SystemAccentBrush}" Command="{Binding PlayPauseCommand}"
							IsEnabled="{Binding HasTrack}" ToolTip="{loc:Loc MusicPlayer.Play}">
						<Path Data="{Binding IsPlaying, Converter={StaticResource PlayPausePathConverter}}"
							  Fill="White" Width="16" Height="16" Stretch="Uniform"/>
					</Button>
					<Button Grid.Column="5" Style="{StaticResource MusicIconButton}" Command="{Binding NextCommand}"
							IsEnabled="{Binding HasTrack}" ToolTip="{loc:Loc MusicPlayer.Next}">
						<TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
					</Button>
				</Grid>

				<Grid Grid.Row="4" Margin="0 0 0 12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="24"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="42"/>
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding Volume, Converter={StaticResource VolumeIconConverter}}"
							   FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
					<Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
							Style="{StaticResource FluentSlider}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:F0}%}"
							   FontSize="11" Foreground="#AFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
				</Grid>

				<Grid Grid.Row="5" Margin="0 0 0 6">
					<TextBlock Text="{loc:Loc MusicPlayer.Playlist}" FontSize="12" FontWeight="SemiBold" Foreground="#DFFFFFFF"/>
					<TextBlock Text="{Binding Tracks.Count}" FontSize="11" Foreground="#8FFFFFFF" HorizontalAlignment="Right"/>
				</Grid>

				<Grid Grid.Row="6">
					<ListBox ItemsSource="{Binding Tracks}" SelectedIndex="{Binding SelectedTrackIndex, Mode=TwoWay}"
							 MaxHeight="160" Background="#18000000" BorderBrush="#20FFFFFF" BorderThickness="1"
							 ScrollViewer.VerticalScrollBarVisibility="Auto"
							 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
							 Visibility="{Binding HasTrack, Converter={StaticResource BoolToVisibilityConverter}}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="White" Margin="4 2"/>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<StackPanel Visibility="{Binding HasTrack, Converter={StaticResource InverseBoolToVisibilityConverter}}"
								HorizontalAlignment="Center" Margin="0 12">
						<TextBlock Text="{loc:Loc MusicPlayer.NoTracks}" Foreground="#CFFFFFFF" HorizontalAlignment="Center"/>
						<TextBlock Text="{loc:Loc MusicPlayer.NoTracksDesc}" FontSize="11" Foreground="#8FFFFFFF"
								   TextWrapping="Wrap" TextAlignment="Center" Margin="0 4 0 0"/>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
