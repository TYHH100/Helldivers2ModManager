<UserControl x:Class="Helldivers2ModManager.Views.ArmorPollutionPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Helldivers2ModManager.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="820">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0 0 0 16"
                BorderThickness="0 0 0 1"
                BorderBrush="{StaticResource NeutralStrokeBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource FluentIconButton}"
                        Margin="0 0 8 8"
                        Width="36"
                        ToolTip="{loc:Loc Common.Back}">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                </Button>

                <StackPanel Grid.Column="1" Margin="0 0 12 8">
                    <TextBlock Text="{loc:Loc ArmorPollutionPage.Title}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralForegroundBrush}"/>
                    <TextBlock Text="{loc:Loc ArmorPollutionPage.Description}"
                               Margin="0 4 0 0"
                               FontSize="12"
                               Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource FluentSecondaryButton}"
                        Padding="14 8"
                        Margin="0 0 0 8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0 0 7 0"/>
                        <TextBlock Text="{loc:Loc ArmorPollutionPage.Refresh}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource FluentSettingsCard}"
                Margin="0 0 0 16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="9"
                           Text="{Binding SummaryText}"
                           FontSize="13"
                           Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                           Margin="0 0 0 12"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ScannedModCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ArmorPollutionPage.ScannedMods}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource NeutralStrokeBrush}" Margin="0 2"/>
                <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ScannedPatchCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ArmorPollutionPage.ScannedPatches}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource NeutralStrokeBrush}" Margin="0 2"/>
                <StackPanel Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ScannedUnitCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ArmorPollutionPage.ScannedUnits}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="5" Background="{StaticResource NeutralStrokeBrush}" Margin="0 2"/>
                <StackPanel Grid.Row="1" Grid.Column="6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PollutionCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ArmorPollutionPage.PollutedUnits}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="7" Background="{StaticResource NeutralStrokeBrush}" Margin="0 2"/>
                <StackPanel Grid.Row="1" Grid.Column="8" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AffectedModCount}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ArmorPollutionPage.AffectedMods}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Visibility="{Binding NoPollutionVisibility}"
                    Padding="18"
                    CornerRadius="6"
                    BorderBrush="{StaticResource SuccessBrush}"
                    BorderThickness="1"
                    Background="#15107C10"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="18" Margin="0 0 12 0"/>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc ArmorPollutionPage.EmptyTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc ArmorPollutionPage.EmptyDescription}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 3 0 0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Visibility="{Binding PollutionVisibility}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FluentSettingsCard}" Margin="0 0 0 8" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Brush}" CornerRadius="4 0 0 4"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Icon}"
                                               FontSize="17"
                                               Foreground="{Binding Brush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0 16 0 0"/>
                                    <StackPanel Grid.Column="2" Margin="8 12 14 12">
                                        <TextBlock Text="{Binding ResourceName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding UnitText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource NeutralForegroundSecondaryBrush}"
                                                   Margin="0 2 0 0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ModsText}" FontSize="12" Foreground="{StaticResource NeutralForegroundSecondaryBrush}" Margin="0 6 0 0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding EvidenceText}" FontSize="12" Foreground="{StaticResource NeutralForegroundBrush}" Margin="0 4 0 0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
