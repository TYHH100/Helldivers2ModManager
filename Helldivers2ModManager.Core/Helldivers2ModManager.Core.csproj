<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <ExcludeSevenZipAssemblies>false</ExcludeSevenZipAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helldivers2ModManager.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SharpSevenZip" Version="2.0.109" />
    <PackageReference Include="ToolGood.Words.Pinyin" Version="3.1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Data\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>


