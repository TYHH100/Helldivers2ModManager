{
  "manifest_version": 3,
  "name": "HD2MMT Nexus Download Interceptor",
  "version": "1.0.0",
  "description": "拦截Nexus Mods下载链接并发送到Helldivers 2 Mod Manager进行管理",
  "author": "TYHH100",
  "homepage_url": "https://github.com/TYHH100/Helldivers2ModManager/tree/test",
  "default_locale": "zh",
  "permissions": [
    "downloads",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://files.nexus-cdn.com/*",
    "*://*.nexusmods.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Nexus Download Interceptor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hd2mmt_nexus-download-interceptor@tyhh100.github.io",
      "strict_min_version": "145.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}